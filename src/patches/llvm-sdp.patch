+INITIALIZE_PASS(RISCVHeapSettagInstrumentation, DEBUG_TYPE, RISCV_HEAP_SETTAG_INSTRUMENTATION_NAME, false, false)
+
+FunctionPass *llvm::createRISCVHeapSettagInstrumentationPass() {
+  return new RISCVHeapSettagInstrumentation();
+}
