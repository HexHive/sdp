+#include "clang/AST/Decl.h"
+#include "clang/AST/RecordLayout.h"
+#include "clang/Basic/SourceManager.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/raw_ostream.h"
+#include <fstream>
+
+using namespace clang;
+using namespace llvm;
+
+json::Object FieldInfo::toJSON() const {
+  return json::Object{{"fn", fieldName},
+                      {"ft", fieldType},
+                      {"fs", sensitivity},
+                      {"fo", static_cast<int64_t>(offset)},
+                      {"fz", static_cast<int64_t>(size)}};
+}
+
+StructTypeInfo::StructTypeInfo(const std::string &name, uint8_t sensitivity)
+    : structName(name), structSensitivity(sensitivity), structSize(0) {}
+
+StructTypeInfo::StructTypeInfo(const std::string &name, uint8_t sensitivity,
+                               const std::vector<FieldInfo> &fieldList,
+                               uint64_t structSize)
+    : structName(name), structSensitivity(sensitivity), fields(fieldList),
+      structSize(structSize) {}
+
+json::Object StructTypeInfo::toJSON() const {
+  json::Array fieldArray;
+  for (const auto &field : fields) {
+    fieldArray.push_back(field.toJSON());
+  }
+
+  return json::Object{{"sn", structName},
+                      {"ss", structSensitivity},
+                      {"sz", static_cast<int64_t>(structSize)},
+                      {"sf", std::move(fieldArray)},
+                      {"sc", static_cast<int64_t>(fields.size())}};
+}
+
+// Static mutex for file I/O synchronization
+std::mutex StructTypeTracker::fileMutex;
+
+StructTypeTracker &StructTypeTracker::getInstance(bool dumpEnabled, Mode mode) {
+  // First caller in the process fixes the (dumpEnabled, mode) pair.
+  // Within a single TU exactly one mode is active (driven by LangOpts), so
+  // the singleton's frozen-on-first-call shape is fine
+  static StructTypeTracker instance(dumpEnabled, mode);
+  return instance;
+}
+
+StructTypeTracker::StructTypeTracker(bool dumpEnabled, Mode mode)
+    : structFilePath(mode == FP      ? "struct_definitions_fp.json"
+                     : mode == FPIFP ? "struct_definitions_fpifp.json"
+                                     : "struct_definitions.json"),
+      resolvedStructFilePath(
+          mode == FP      ? "struct_definitions_fp_resolved.json"
+          : mode == FPIFP ? "struct_definitions_fpifp_resolved.json"
+                          : "struct_definitions_resolved.json"),
+      dumpEnabled(dumpEnabled) {
+  // Load existing data when the tracker is first created, only if dumping is enabled
+  if (dumpEnabled) {
+    loadFromJSON(structFilePath);
+  } else {
+    loadFromJSON(resolvedStructFilePath);
+  }
+}
+
+StructTypeTracker::~StructTypeTracker() {
+  // Save results when the tracker is destroyed, only if dumping is enabled
+  if (dumpEnabled) {
+    saveToJSON(structFilePath);
+    printFinalCounts();
+  }
+}
+
+void StructTypeTracker::loadFromJSON(const std::string &structsFile) {
+  std::lock_guard<std::mutex> fileLock(fileMutex);
+  std::lock_guard<std::mutex> lock(trackerMutex);
+
+  if (llvm::sys::fs::exists(structsFile)) {
+    auto bufferOrErr = llvm::MemoryBuffer::getFile(structsFile);
+    if (bufferOrErr) {
+      auto jsonOrErr = json::parse(bufferOrErr.get()->getBuffer());
+      if (!jsonOrErr) {
+        llvm::consumeError(jsonOrErr.takeError());
+        return;
+      }
+      const auto &jsonValue = *jsonOrErr;
+      if (auto *root = jsonValue.getAsObject()) {
+        if (auto *structArray = root->getArray("structs")) {
+          for (const auto &item : *structArray) {
+            if (auto *obj = item.getAsObject()) {
+              auto sensitivityOpt = obj->getInteger("ss");
+              auto sizeOpt = obj->getInteger("sz");
+              auto nameOpt = obj->getString("sn");
+              if (sensitivityOpt && sizeOpt && nameOpt) {
+                uint8_t structSensitivity = *sensitivityOpt;
+                uint64_t structSize = static_cast<uint64_t>(*sizeOpt);
+                std::string structName = nameOpt->str();
+                std::vector<FieldInfo> fields;
+
+                if (auto *fieldsArray = obj->getArray("sf")) {
+                  for (const auto &fieldItem : *fieldsArray) {
+                    auto *fieldObj = fieldItem.getAsObject();
+                    if (!fieldObj)
+                      continue;
+                    auto fieldName = fieldObj->getString("fn");
+                    auto fieldType = fieldObj->getString("ft");
+                    auto fieldAttr = fieldObj->getInteger("fs");
+                    auto fieldOffset = fieldObj->getInteger("fo");
+                    auto fieldSize = fieldObj->getInteger("fz");
+                    if (!fieldName || !fieldType || !fieldAttr ||
+                        !fieldOffset || !fieldSize)
+                      continue;
+                    fields.emplace_back(fieldName->str(), fieldType->str(),
+                                        static_cast<uint8_t>(*fieldAttr),
+                                        static_cast<uint64_t>(*fieldOffset),
+                                        static_cast<uint64_t>(*fieldSize));
+                  }
+                }
+
+                StructTypeInfo info(structName, structSensitivity, fields,
+                                    structSize);
+                structTypes[structName] = std::move(info);
+              }
+            }
+          }
+        }
+      }
+    }
+  } else {
+    // assert(dumpEnabled && "Resolved struct definition file not found!");
+  }
+}
+
+std::vector<FieldInfo> StructTypeTracker::extractFields(RecordDecl *RD) {
+  std::vector<FieldInfo> fields;
+
+  if (!RD || !RD->isCompleteDefinition())
+    return fields;
+
+  const ASTContext &Context = RD->getASTContext();
+  const ASTRecordLayout &Layout = Context.getASTRecordLayout(RD);
+
+  for (const auto *Field : RD->fields()) {
+    std::string fieldName = Field->getNameAsString();
+
+    QualType fieldQualType = Field->getType()->getCanonicalTypeUnqualified();
+    std::string fieldTypeStr = fieldQualType.getAsString();
+
+    uint8_t sensitivity = fieldQualType->isSensitiveType(Context);
+
+    // Offset is reported by getASTRecordLayout in bits, converted to
+    // bytes for the dump (kernel set_tag granularity is bytes). Size is
+    // already in bytes from getTypeSizeInChars
+    uint64_t offsetBytes = Layout.getFieldOffset(Field->getFieldIndex()) / 8;
+    uint64_t sizeBytes = 0;
+    if (!fieldQualType->isIncompleteType()) {
+      sizeBytes = Context.getTypeSizeInChars(fieldQualType).getQuantity();
+    }
+
+    fields.emplace_back(fieldName, fieldTypeStr, sensitivity, offsetBytes,
+                        sizeBytes);
+  }
+
+  return fields;
+}
+
+void StructTypeTracker::addStructType(RecordDecl *RD) {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+
+  const RecordType *RT = RD->getTypeForDecl()->getAs<RecordType>();
+  if (!RT)
+    return;
+
+  QualType structType = RT->getCanonicalTypeUnqualified();
+  std::string structName = structType.getAsString();
+
+  std::vector<FieldInfo> fields = extractFields(RD);
+
+  uint8_t structSensitivity = 0;
+  for (const auto &field : fields) {
+    if (field.sensitivity == 2) {
+      structSensitivity = 2;
+      break;
+    }
+    if (field.sensitivity == 1) {
+      structSensitivity = 1;
+    }
+  }
+
+  // Record sizeof(struct) so the backend opaque-struct path can match
+  // it against the alloc size for sanity-checking and per-field bounds
+  const ASTContext &Context = RD->getASTContext();
+  uint64_t structSize = 0;
+  if (RD->isCompleteDefinition() && !structType->isIncompleteType())
+    structSize = Context.getTypeSizeInChars(structType).getQuantity();
+
+  StructTypeInfo info(structName, structSensitivity, fields, structSize);
+  structTypes[structName] = std::move(info);
+}
+
+uint8_t StructTypeTracker::getStructSensitivity(RecordDecl *RD) const {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+
+  // Filter location to exclude system headers
+  SourceLocation Loc = RD->getLocation();
+  const ASTContext &Context = RD->getASTContext();
+  if (!Loc.isValid() || !RD->hasNameForLinkage())
+    return 0;
+
+  const SourceManager &SManager = Context.getSourceManager();
+  FileID FID = SManager.getFileID(Loc);
+  if (FID.getID() <= 0 ||
+      SManager.isInSystemHeader(Loc) ||
+      SManager.isInExternCSystemHeader(Loc)) {
+    return 0;
+  }
+
+  const RecordType *RT = RD->getTypeForDecl()->getAs<RecordType>();
+  if (!RT)
+    return 0;
+
+  QualType structType = RT->getCanonicalTypeUnqualified();
+  std::string structName = structType.getAsString();
+
+  auto it = structTypes.find(structName);
+  if (it != structTypes.end()) {
+    return it->second.structSensitivity;
+  }
+
+  // Try to remove the struct tag prefix (e.g., "struct ")
+  size_t pos = structName.find(' ');
+  if (pos != std::string::npos) {
+    std::string trimmedName = structName.substr(pos + 1);
+    it = structTypes.find(trimmedName);
+    if (it != structTypes.end()) {
+      return it->second.structSensitivity;
+    }
+  }
+
+  // llvm::errs() << "Struct not found: " << structName << ", assuming 0\n";
+
+  return 0;
+}
+
+void StructTypeTracker::safeWriteJSON(const std::string &filename,
+                                      const llvm::json::Object &data) {
+  std::lock_guard<std::mutex> fileLock(fileMutex);
+
+  std::error_code EC;
+  raw_fd_ostream OS(filename, EC);
+  if (!EC) {
+    OS << json::Value(json::Object(data)) << "\n";
+    OS.close();
+    llvm::errs() << "Struct definitions written to: " << filename << "\n";
+  } else {
+    llvm::errs() << "Error writing struct definition file: " << EC.message()
+                 << "\n";
+  }
+}
+
+void StructTypeTracker::saveToJSON(const std::string &structsFile) {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+
+  json::Array structArray;
+  for (const auto &pair : structTypes) {
+    structArray.push_back(pair.second.toJSON());
+  }
+
+  json::Object root;
+  root["structs"] = std::move(structArray);
+  root["count"] = static_cast<int64_t>(structTypes.size());
+
+  safeWriteJSON(structsFile, root);
+}
+
+void StructTypeTracker::printFinalCounts() {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+
+  llvm::errs() << "\n=== STRUCT TYPE COLLECTION RESULTS ===\n";
+  llvm::errs() << "Total struct types: " << structTypes.size() << "\n";
+  llvm::errs() << "========================================\n\n";
+}
+
+size_t StructTypeTracker::getStructCount() const {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+  return structTypes.size();
+}
