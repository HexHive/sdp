+#!/usr/bin/env python3
+"""
+Struct Sensitivity Analyzer
+
+This script analyzes the struct_definitions.json file generated during compilation
+to resolve structs with undetermined sensitivity (value 1).
+
+Sensitivity values:
+- 0: Insensitive
+- 1: Undetermined (needs resolution)
+- 2: Sensitive
+
+The script performs iterative analysis to resolve undetermined structs by:
+1. Looking up field type definitions
+2. Propagating sensitivity information from referenced types
+3. Updating struct sensitivity based on field analysis
+"""
+
+import json
+import sys
+import argparse
+import re
+from typing import Dict, List, Set, Tuple, Optional
+from collections import defaultdict
+
+
+class StructSensitivityAnalyzer:
+    """Analyzes and resolves struct sensitivity based on field types."""
+
+    def __init__(self, json_path: str, verbose: bool = False):
+        self.json_path = json_path
+        self.verbose = verbose
+        self.data = None
+        self.struct_map: Dict[str, dict] = {}  # Maps struct name to struct info
+        self.unresolved: Set[str] = set()  # Structs with sensitivity = 1
+        self.resolved: Set[str] = set()  # Structs with sensitivity = 0 or 2
+        self.iteration_count = 0
+        self.max_iterations = 100000
+
+    def load_data(self) -> bool:
+        """Load JSON data from file."""
+        try:
+            with open(self.json_path, 'r') as f:
+                self.data = json.load(f)
+            print(f"Loaded {self.data.get('count', 0)} structs from {self.json_path}")
+            return True
+        except FileNotFoundError:
+            print(f"[Error]: File not found: {self.json_path}", file=sys.stderr)
+            return False
+        except json.JSONDecodeError as e:
+            print(f"[Error]: Invalid JSON: {e}", file=sys.stderr)
+            return False
+
+    def build_struct_map(self):
+        """Build a lookup map of struct names to their definitions and populate initial sets."""
+        self.struct_map.clear()
+        self.unresolved.clear()
+        self.resolved.clear()
+
+        for struct in self.data.get('structs', []):
+            struct_name = struct.get('sn', '')
+            self.struct_map[struct_name] = struct
+
+            # Categorize into resolved or unresolved
+            ss = struct.get('ss', None)
+            if ss == 1:
+                self.unresolved.add(struct_name)
+            else:
+                self.resolved.add(struct_name)
+
+        if self.verbose:
+            print(f"  Built struct map with {len(self.struct_map)} entries")
+            print(f"  Resolved: {len(self.resolved)}, Unresolved: {len(self.unresolved)}")
+
+    def extract_struct_type(self, field_type: str) -> Optional[str]:
+        """
+        Extract the struct type from a field string (a pointer type to <struct>).
+        
+        Examples:
+            "struct xpvav *" -> "struct xpvav"
+            "struct reg_substr_datum[3]" -> "struct reg_substr_datum"
+            "const struct data *" -> "struct data"
+            "Pixel *" -> "Pixel"
+            "const name_id_map *" -> "name_id_map"
+        """
+        # Match "struct <name>" or "<name>" after any leading qualifiers
+        pattern = r'(?:\w+\s+)*(?:struct\s+)?(\w+)'
+        match = re.search(pattern, field_type)
+        
+        if match:
+            type_name = match.group(1)
+            # Reconstruct with "struct" if it was in the original
+            if 'struct' in field_type:
+                return f"struct {type_name}"
+            else:
+                return type_name
+
+        return None
+
+    def get_type_sensitivity(self, field_type: str, current_struct_name: str = "") -> int:
+        """
+        Determine the sensitivity of a field type.
+
+        Args:
+            field_type: The type string of the field
+            current_struct_name: Name of the struct being analyzed (to detect self-reference)
+
+        Returns:
+            0: Insensitive (base type not found or marked as insensitive)
+            1: Undetermined (base type has undetermined sensitivity or not found)
+            2: Sensitive (base type is marked as sensitive)
+        """
+        base_type = self.extract_struct_type(field_type)
+
+        if base_type is None:
+            # Not a struct type (primitive, pointer to non-struct, etc.)
+            print(f"    [Error]: Unable to extract struct type from '{field_type}'")
+            return 0
+
+        if base_type not in self.struct_map:
+            # Referenced struct not found in our map, assume insensitive
+            print(f"    [Warning]: Type '{base_type}' not found in struct map, assuming insensitive")
+            return 0
+
+        # Look up the sensitivity of the referenced struct
+        referenced_struct = self.struct_map[base_type]
+        return referenced_struct.get('ss', None)
+
+    def analyze_struct_fields(self, struct: dict) -> Tuple[int, List[dict]]:
+        """
+        Analyze all fields of a struct to determine overall sensitivity.
+
+        Sensitivity rules:
+        - If ANY field is sensitive (2), the struct is sensitive (2)
+        - If ALL fields are insensitive (0), the struct is insensitive (0)
+        - If no fields are sensitive but at least one is undetermined (1), struct is undetermined (1)
+
+        Returns:
+            Tuple of (new_sensitivity, updated_fields)
+        """
+        fields = struct.get('sf', [])
+        struct_name = struct.get('sn', '')
+
+        if not fields:
+            print(f"    [Error]: Struct to resolve '{struct_name}' has no fields")
+            return 0, []
+
+        updated_fields = []
+        has_sensitive = False
+        has_undetermined = False
+
+        for field in fields:
+            field_name = field.get('fn', '')
+            field_type = field.get('ft', '')
+            current_fs = field.get('fs', None)
+
+            # Try to resolve field sensitivity if it's undetermined
+            if current_fs == 1:
+                resolved_sensitivity = self.get_type_sensitivity(field_type, struct_name)
+
+                if resolved_sensitivity != 1:
+                    if self.verbose:
+                        print(f"    Field '{field_name}' ({field_type}): {current_fs} -> {resolved_sensitivity}")
+                    current_fs = resolved_sensitivity
+
+            # Preserve every key from the source field (fo/fz and any future
+            # additions) and overwrite only the ones this pass updates
+            updated_field = dict(field)
+            updated_field['fn'] = field_name
+            updated_field['ft'] = field_type
+            updated_field['fs'] = current_fs
+            updated_fields.append(updated_field)
+
+            # After updating, check sensitivity status
+            if current_fs == 2:
+                has_sensitive = True
+            elif current_fs == 1:
+                has_undetermined = True
+
+        if has_sensitive:
+            return 2, updated_fields
+        if has_undetermined:
+            return 1, updated_fields
+        else:
+            return 0, updated_fields
+
+    def resolve_iteration(self) -> int:
+        """
+        Perform one iteration of sensitivity resolution.
+        Tries to resolve unresolved structs and moves successfully resolved ones to resolved set.
+
+        Returns:
+            Number of structs resolved in this iteration.
+        """
+        newly_resolved = []
+
+        for struct_name in list(self.unresolved):
+            struct = self.struct_map[struct_name]
+            current_ss = struct.get('ss', None)
+
+            if self.verbose:
+                print(f"  Analyzing: {struct_name}")
+
+            new_ss, updated_fields = self.analyze_struct_fields(struct)
+
+            # Update struct data
+            struct['sf'] = updated_fields
+            struct['sc'] = len(updated_fields)
+
+            # Check if we resolved this struct
+            if new_ss != 1:
+                struct['ss'] = new_ss
+                newly_resolved.append(struct_name)
+
+                if self.verbose:
+                    print(f"    Resolved: {current_ss} -> {new_ss}")
+            else:
+                # Still undetermined, just update the struct with new field info
+                if self.verbose:
+                    print(f"    Still undetermined")
+
+        # Move newly resolved structs from unresolved to resolved
+        for struct_name in newly_resolved:
+            self.unresolved.remove(struct_name)
+            self.resolved.add(struct_name)
+
+        return len(newly_resolved)
+    
+    def resolve_all(self) -> bool:
+        """
+        Iteratively resolve all undetermined structs until convergence.
+        
+        Returns:
+            True if all undetermined structs were resolved, False otherwise.
+        """
+        print("\n=== Starting Sensitivity Resolution ===")
+        print(f"Initial state: {len(self.resolved)} resolved, {len(self.unresolved)} unresolved")
+
+        while self.iteration_count < self.max_iterations and self.unresolved:
+            self.iteration_count += 1
+            print(f"\nIteration {self.iteration_count}:")
+
+            resolved_count = self.resolve_iteration()
+            print(f"  Resolved {resolved_count} struct(s)")
+            print(f"  Current state: {len(self.resolved)} resolved, {len(self.unresolved)} unresolved")
+
+            # If no progress, check for circular dependencies
+            if resolved_count == 0:
+                print(f"  No more resolvable structs")
+
+                if self.unresolved:
+                    print(f"Resolving state: {len(self.resolved)} resolved, {len(self.unresolved)} unresolved")
+                    print(f"\n  Mark the remaining {len(self.unresolved)} unresolved struct(s) as insensitive (0)")
+                    for struct_name in self.unresolved:
+                        print(f"    Marking {struct_name} as insensitive, fields: {self.struct_map[struct_name].get('sc', 0)}")
+                        for field in self.struct_map[struct_name].get('sf', []):
+                            if field.get('fs', None) == 1:
+                                print(f"      Field '{field.get('fn', '')}' ({field.get('ft', '')}): 1 -> 0")
+                        struct = self.struct_map[struct_name]
+                        struct['ss'] = 0  # Mark as insensitive
+                        self.resolved.add(struct_name)
+                    self.unresolved.clear()
+
+                # No progress and no circles found, we're done
+                break
+
+        if self.iteration_count >= self.max_iterations:
+            print(f"\n [Warning]: Reached maximum iterations ({self.max_iterations})")
+            return False
+
+        print(f"\nResolution complete after {self.iteration_count} iteration(s)")
+
+        return len(self.unresolved) == 0
+    
+    def generate_report(self) -> dict:
+        """Generate analysis report with statistics."""
+        stats = {
+            'total': 0,
+            'insensitive': 0,
+            'sensitive': 0,
+        }
+
+        for struct in self.data.get('structs', []):
+            stats['total'] += 1
+            ss = struct.get('ss', None)
+
+            if ss == 0:
+                stats['insensitive'] += 1
+            elif ss == 2:
+                stats['sensitive'] += 1
+
+        return stats
+
+    def print_report(self, stats: dict):
+        """Print analysis report to console."""
+        print("\n" + "=" * 60)
+        print("STRUCT SENSITIVITY ANALYSIS REPORT")
+        print("=" * 60)
+        print(f"Total structs:\t\t{stats['total']:4d}")
+        print(f"Insensitive (0):\t{stats['insensitive']:4d} ({stats['insensitive']/stats['total']*100:5.1f}%)")
+        print(f"Sensitive (2):\t\t{stats['sensitive']:4d} ({stats['sensitive']/stats['total']*100:5.1f}%)")
+        print("=" * 60)
+        
+        print(f"\nIterations performed: {self.iteration_count}")
+    
+    def save_results(self, output_path: Optional[str] = None):
+        """Save analyzed results to JSON file."""
+        if output_path is None:
+            output_path = self.json_path.replace('.json', '_resolved.json')
+        
+        try:
+            with open(output_path, 'w') as f:
+                json.dump(self.data, f, indent=2)
+            print(f"\nResults saved to: {output_path}")
+        except IOError as e:
+            print(f"\n[Error] saving results: {e}", file=sys.stderr)
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description='Analyze and resolve struct sensitivity from compilation output',
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+Examples:
+  # Analyze struct_definitions.json in current directory
+  %(prog)s struct_definitions.json
+  
+  # Analyze with verbose output
+  %(prog)s struct_definitions.json -v
+  
+  # Specify custom output files
+  %(prog)s struct_definitions.json -o resolved.json -r report.json
+        """
+    )
+    
+    parser.add_argument('input',
+                       help='Input JSON file (struct_definitions.json)')
+    parser.add_argument('-o', '--output',
+                       help='Output JSON file (default: input_resolved.json)')
+    parser.add_argument('-r', '--report',
+                       help='Report JSON file (default: input_report.json)')
+    parser.add_argument('-v', '--verbose',
+                       action='store_true',
+                       help='Enable verbose output')
+    parser.add_argument('--no-save',
+                       action='store_true',
+                       help='Do not save results (analysis only)')
+    
+    args = parser.parse_args()
+    
+    # Initialize analyzer
+    analyzer = StructSensitivityAnalyzer(args.input, verbose=args.verbose)
+    
+    # Load data
+    if not analyzer.load_data():
+        return 1
+    
+    # Build initial struct map
+    analyzer.build_struct_map()
+    
+    # Perform resolution
+    analyzer.resolve_all()
+    
+    # Generate and print report
+    stats = analyzer.generate_report()
+    analyzer.print_report(stats)
+    
+    # Save results
+    if not args.no_save:
+        analyzer.save_results(args.output)
+    
+    return 0
+
+if __name__ == '__main__':
+    sys.exit(main())
