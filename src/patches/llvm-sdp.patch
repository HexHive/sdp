+// SDP: Add isSensitiveType() to clang::Type, to determine if it is or contains any sensitive pointer
+inline uint8_t Type::isSensitiveType(const ASTContext &Context) const {
+  if (const auto *PT = getAs<PointerType>()) {
+    return PT->isSensitive(Context);
+  }
+  
+  if (const auto *RT = getAs<RecordType>()) {
+    return RT->isSensitive(Context);
+  }
+  
+  if (const auto *AT = llvm::dyn_cast<ArrayType>(this)) {
+    return AT->getElementType()->isSensitiveType(Context);
+  }
+
+  return 0;
+}
+
+// SDP: Add isSensitivePointerType function for Type to determine if it is a sensitive pointer type
+inline bool Type::isSensitivePointerType(const ASTContext &Context) const {
+  if (const auto *PT = getAs<PointerType>())
+    return (PT->isSensitive(Context) == 2);
+  return false;
+}
+
+// SDP: Add isEmitSettagPointerType function for Type to determine if it is a __emit_settag void pointer type
+inline bool Type::isEmitSettagPointerType() const {
+  if (const auto *PT = getAs<PointerType>())
+    return PT->getEmitSettagAttr();
+  return false;
+}
+
 inline bool Type::isAnyPointerType() const {
   return isPointerType() || isObjCObjectPointerType();
 }
diff --git a/clang/include/clang/Basic/Attr.td b/clang/include/clang/Basic/Attr.td
index 46d0a66d59c37..912cb7a48dbef 100644
--- a/clang/include/clang/Basic/Attr.td
+++ b/clang/include/clang/Basic/Attr.td
@@ -4068,6 +4068,41 @@ def UPtr : TypeAttr {
   let Documentation = [UPtrDocs];
 }
 
+// SDP: Add the sensitive attribute
+def Tagone : TypeAttr {
+  let Spellings = [CustomKeyword<"__tag1">];
+  let Documentation = [TagoneDocs];
+}
+
+// SDP: Add the forcibly-insensitive attribute (inverse of __tag1)
+def Tagzero : TypeAttr {
+  let Spellings = [CustomKeyword<"__tag0">];
+  let Documentation = [TagzeroDocs];
+}
+
