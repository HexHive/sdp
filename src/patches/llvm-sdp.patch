new file mode 100644
index 0000000000000..60635cf3d1a88
--- /dev/null
+++ b/llvm/lib/Target/RISCV/RISCVStackSettagInstrumentation.cpp
@@ -0,0 +1,138 @@
+// SDP: RISC-V stack settag instrumentation pass. Tags each sensitive stack slot
+// with set_tag1 at function entry and clears it with set_tag0 at each return;
+// it also removes lifetime markers so StackColoring never overlays a plain slot
+// on a tagged one
+
+#include "RISCVInstrInfo.h"
+#include "RISCVSettagUtils.h"
+#include "llvm/IR/IntrinsicInst.h"
+#include "llvm/IR/Module.h"
+
+using namespace llvm;
+#define DEBUG_TYPE "riscv-stack-settag-instrumentation"
+#define RISCV_STACK_SETTAG_INSTRUMENTATION_NAME "RISC-V stack settag instrumentation pass"
+
+namespace {
+
+// RISCVStackSettagInstrumentation, to instrument code that sets Sensitivity and TypeID tags for stack sensitive pointers
+class RISCVStackSettagInstrumentation : public FunctionPass {
+public:
+  static char ID;
+  RISCVStackSettagInstrumentation() : FunctionPass(ID) {}
+
+  bool runOnFunction(Function &F) override {
+    Module *M = F.getParent();
+    Metadata *PerfInstFlag = M->getModuleFlag("fsdp_perf_inst");
+
+    LLVMContext &Ctx = F.getContext();
+    
+    std::vector<AllocaInst*> SensitiveAllocaVec;
+    bool Modified = false;
+    
+    for (auto &BB : F) {
+      for (auto &I : BB) {
+        if (AllocaInst *AI = dyn_cast<AllocaInst>(&I)) {
+          if (AI->isSensitive()) {
+            SensitiveAllocaVec.push_back(AI);
+          }
+        }
+      }
+    }
+    
+    if (SensitiveAllocaVec.empty())
+      return false;
+
+    // Drop the lifetime markers of sensitive allocas, so StackColoring
+    // never overlays a plain alloca (e.g. an inlined one) on a tagged slot;
+    // the entry/exit settag model needs the slot for the whole function
+    for (AllocaInst *AI : SensitiveAllocaVec) {
+      std::vector<IntrinsicInst *> LifetimeMarkers;
+      for (User *U : AI->users()) {
+        if (auto *II = dyn_cast<IntrinsicInst>(U)) {
+          Intrinsic::ID IID = II->getIntrinsicID();
+          if (IID == Intrinsic::lifetime_start ||
+              IID == Intrinsic::lifetime_end)
+            LifetimeMarkers.push_back(II);
+        }
+      }
+      for (IntrinsicInst *II : LifetimeMarkers) {
+        II->eraseFromParent();
+        Modified = true;
+      }
+    }
+
+    // Get function entry and exit points
+    BasicBlock &EntryBB = F.getEntryBlock();
+    Instruction *EntryPoint = nullptr;
+    
+    // Get the first non-alloca instruction
+    for (auto &I : EntryBB) {
+      if (!isa<AllocaInst>(I)) {
+        EntryPoint = &I;
+        break;
+      }
+    }
+    
+    if (!EntryPoint)
+      return false;
+    
+    // Find all return instructions
+    std::vector<ReturnInst*> ExitPointVec;
+    for (auto &BB : F) {
+      if (ReturnInst *RI = dyn_cast<ReturnInst>(BB.getTerminator())) {
+        ExitPointVec.push_back(RI);
+      }
+    }
+
+    if (!PerfInstFlag) {
+      // Instrument set_tag1 instructions
+      IRBuilder<> Builder(Ctx);
+      Builder.SetInsertPoint(EntryPoint);
+      
+      for (AllocaInst *AI : SensitiveAllocaVec) {
+        settagVariable(*M, Builder, AI, AI->getAllocatedType(), 0, 1, PerfInstFlag, AllocationType::StackSettag);
+        Modified = true;
+      }
+      
+      // Instrument set_tag0 instructions
+      for (ReturnInst *RI : ExitPointVec) {
+        Builder.SetInsertPoint(RI);
+        
+        for (AllocaInst *AI : SensitiveAllocaVec) {
+          settagVariable(*M, Builder, AI, AI->getAllocatedType(), 0, 0, PerfInstFlag, AllocationType::StackSettag);
+          Modified = true;
+        }
+      }
+    } else {
+      // Instrument addi and sd to estimate set_tag1 instructions
+      IRBuilder<> Builder(Ctx);
+      Builder.SetInsertPoint(EntryPoint);
+      
+      for (AllocaInst *AI : SensitiveAllocaVec) {
+        settagVariable(*M, Builder, AI, AI->getAllocatedType(), 0, 1, PerfInstFlag, AllocationType::StackSettag);
+        Modified = true;
+      }
+      
+      // Instrument addi and sd to estimate set_tag0 instructions
+      for (ReturnInst *RI : ExitPointVec) {
+        Builder.SetInsertPoint(RI);
+        
+        for (AllocaInst *AI : SensitiveAllocaVec) {
+          settagVariable(*M, Builder, AI, AI->getAllocatedType(), 0, 0, PerfInstFlag, AllocationType::StackSettag);
+          Modified = true;
+        }
+      }
+    }
+    
+    return Modified;
+  }
+};
+} // End anonymous namespace
+
+char RISCVStackSettagInstrumentation::ID = 0;
+
+INITIALIZE_PASS(RISCVStackSettagInstrumentation, DEBUG_TYPE, RISCV_STACK_SETTAG_INSTRUMENTATION_NAME, false, false)
+
+FunctionPass *llvm::createRISCVStackSettagInstrumentationPass() {
+  return new RISCVStackSettagInstrumentation();
+}
