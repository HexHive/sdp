+#!/usr/bin/env python3
+import sys
+import ctypes
+
+def convert_signed_to_unsigned(signed_value):
+    """Convert a signed int64 to an unsigned int64."""
+    try:
+        signed_int = int(signed_value)
+        unsigned_int = ctypes.c_uint64(signed_int).value
+        return unsigned_int
+    except ValueError:
+        return "Error: Input must be a valid integer."
+
+def main():
+    if len(sys.argv) != 2:
+        print("Usage: python script.py <signed_int64>")
+        print("Example: python script.py -1")
+        sys.exit(1)
+        
+    signed_value = sys.argv[1]
+    result = convert_signed_to_unsigned(signed_value)
+    
+    if isinstance(result, int):
+        print(f"Signed int64: {signed_value}")
+        print(f"Unsigned int64: 0x{result:016x}")
+    else:
+        print(result)  # Print error message
+
+if __name__ == "__main__":
+    main()
