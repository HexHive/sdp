diff --git a/llvm/lib/Target/RISCV/RISCVSettagUtils.cpp b/llvm/lib/Target/RISCV/RISCVSettagUtils.cpp
new file mode 100644
index 0000000000000..49a1164c86ce5
--- /dev/null
+++ b/llvm/lib/Target/RISCV/RISCVSettagUtils.cpp
@@ -0,0 +1,193 @@
+// SDP: Shared helpers for the RISC-V settag passes: hash a type to its 15-bit
+// TTag and emit the set_tag sequences for a variable, struct, array or pointer
+
+#include "RISCVInstrInfo.h"
+#include "llvm/IR/IRBuilder.h"
+#include "llvm/IR/Module.h"
+#include "llvm/ADT/StableHashing.h"
+#include <regex>
+
+#include "RISCVTagonePointerTracker.h"
+
+using namespace llvm;
+
+long getHash(Type *Ty) {
+  std::string TypeStr;
+
+  // Omit struct body details to avoid opaque struct types having different hashes
+  if (auto *STy = dyn_cast<StructType>(Ty); STy && STy->hasName()) {
+    TypeStr = STy->getName().str();
+  } else {
+    raw_string_ostream RSO(TypeStr);
+    Ty->print(RSO);
+    RSO.flush();
+  }
+
+  // Normalize anonymous struct names: (%)?struct.anon.11 -> (%)?struct.anon.
+  // Preserve the leading % when present (Ty->print emits it; StructType::getName does not)
+  static const std::regex AnonRe(R"((%?)struct\.anon\.\d+)");
+  TypeStr = std::regex_replace(TypeStr, AnonRe, "$1struct.anon");
+
+  // Reduce "__tag1 ptr <...>" and "ptr <...>" to "ptr": CodeGen may annotate
+  // one parameter of a function type but not its siblings, and the TTag must
+  // hash only the underlying type, or object_ttag != subject_ttag traps
+  static const std::regex TagonePtrRe(R"(__tag1\s+ptr)");
+  TypeStr = std::regex_replace(TypeStr, TagonePtrRe, "ptr");
+  static const std::regex TypedPtrRe(R"(ptr\s*<[^<>]+>)");
+  TypeStr = std::regex_replace(TypeStr, TypedPtrRe, "ptr");
+
+  stable_hash Hash = stable_hash_combine_string(TypeStr);
+
+  // Final hash: 15 bits from the hash value
+  Hash = Hash & 0x7FFF;
+
+  bool IsFunction = Ty->isFunctionTy();
+  Hash = IsFunction ? Hash : (Hash | 0x8000);
+
+  return Hash;
+}
+
+// Do settag for a single sensitive pointer
+void settagOnePointer(Module &M, IRBuilder<> &Builder, Value *BaseAddr, Type *ValType, uint64_t Offset, bool Settag) {
+
+  PointerType *PTy = dyn_cast<PointerType>(ValType);
+  if (!PTy || !PTy->getTagoneFlag())
+    return;
+
+  Type *PointeeType = PTy->getPointeeType();
+  long TTag = getHash(PointeeType);
+
+  // Shift left by 4 bits as lui loads upper 20 bits
+  TTag = TTag << 4;
+
+  // lui tmp_reg, ttag_imm  
+  llvm::FunctionType *AsmTy = llvm::FunctionType::get(
+      Builder.getInt64Ty(),
+      {},
+      false
+  );
+  llvm::InlineAsm *IAsm = llvm::InlineAsm::get(
+      AsmTy,
+      "lui $0, " + std::to_string(TTag),
+      "=&r",
+      false,
+      false,
+      llvm::InlineAsm::AD_ATT
+  );
+  llvm::Value *TmpReg = Builder.CreateCall(IAsm, {});
+  
+  // set_tag1/set_tag0 tmp_reg, offset_imm(addr_reg)
+  llvm::Type *I8Ty = Builder.getInt8Ty();
+  llvm::Value *OffsetValue = Builder.getInt64(Offset);
+  llvm::Value *Address = Builder.CreateGEP(I8Ty, BaseAddr, OffsetValue);
+
+  Builder.CreateSettag(TmpReg, Address, Settag);
+
+  return;
+}
+
+// Estimate settag with sd for a single sensitive pointer
+void settagEstimateOnePointer(Module &M, IRBuilder<> &Builder, Value *BaseAddr, Type *ValType, uint64_t Offset, AllocationType SettagLoc) {
+
+  PointerType *PTy = dyn_cast<PointerType>(ValType);
+  if (!PTy || !PTy->getTagoneFlag())
+    return;
+
+  Type *PointeeType = PTy->getPointeeType();
+  long TTag = getHash(PointeeType);
+
+  // Shift left by 4 bits as lui loads upper 20 bits
+  TTag = TTag << 4;
+
+  // lui tmp_reg, ttag_imm; mark as having side effects so DCE preserves it, since the output register is unused in the estimation path
+  llvm::FunctionType *AsmTy = llvm::FunctionType::get(
+      Builder.getInt64Ty(),
+      {},
+      false
+  );
+  llvm::InlineAsm *IAsm = llvm::InlineAsm::get(
+      AsmTy,
+      "lui $0, " + std::to_string(TTag),
+      "=&r",
+      true,
+      false,
+      llvm::InlineAsm::AD_ATT
+  );
+  Builder.CreateCall(IAsm, {});
+
+  llvm::Value *Address;
+  if (Offset == 0) {
+    Address = BaseAddr;
+  } else {
+    llvm::Value *OffsetValue = Builder.getInt64(Offset);
+    llvm::Type *I8Ty = Builder.getInt8Ty();
+    Address = Builder.CreateGEP(I8Ty, BaseAddr, OffsetValue);
+  }
+
+  // sd zero, offset(base_addr); set as volatile to prevent being optimized away
+  // For global variables, load existing value back so sd does not overwrite the initial value
+  if (SettagLoc == AllocationType::GlobalSettag) {
+    Value *ExistingVal = Builder.CreateLoad(Builder.getInt64Ty(), Address, /*isVolatile=*/true);
+    Builder.CreateStore(ExistingVal, Address, /*isVolatile=*/true);
+  } else {
+    Builder.CreateStore(Builder.getInt64(0), Address, /*isVolatile=*/true);
+  }
+
+  return;
+}
+
+// Do settag for a variable, including pointers, structs, and arrays
+void settagVariable(Module &M, IRBuilder<> &Builder, Value *BaseAddr, Type* ValType, uint64_t Offset, bool Settag, bool PerfInstFlag, AllocationType SettagLoc) {
+      
+  if (auto *PTy = dyn_cast<PointerType>(ValType)) {
+    if (PTy->getTagoneFlag()) {
+
+      // Add the sensitive pointer's pointee type to the tracker
+      // TagonePointerTracker &Tracker = TagonePointerTracker::getInstance();
+      // Tracker.addPointeeType(PTy->getPointeeType(), SettagLoc);
+
+      if (!PerfInstFlag)
+        settagOnePointer(M, Builder, BaseAddr, ValType, Offset, Settag);
+      else 
+        settagEstimateOnePointer(M, Builder, BaseAddr, ValType, Offset, SettagLoc);
+    }
+    return;
+  }
+  
+  if (auto *STy = dyn_cast<StructType>(ValType)) {
+
+    if (STy->isOpaque()) {
+      llvm::errs() << "[Warning]: Opaque StructType encountered: " << *STy << "\n";
+    }
+
+    const DataLayout &DLayout = M.getDataLayout();
+    const StructLayout *SLayout = DLayout.getStructLayout(STy);
+    
+    for (unsigned i = 0; i < STy->getNumElements(); i++) {
+      Type *EltTy = STy->getElementType(i);
+      uint64_t InStructOffset = SLayout->getElementOffset(i);
+      
+      if (EltTy->isSensitiveTy()) {
+        settagVariable(M, Builder, BaseAddr, EltTy, Offset + InStructOffset, Settag, PerfInstFlag, SettagLoc);
+      }
+    }
+    return;
+  }
+  
+  // Walk arrays unconditionally to tag the full declared footprint (e.g.
+  // sighand_struct::action[_NSIG]); undersized kmemdup tails, which once
+  // needed a heap exception, are avoided on the kernel side
+  if (auto *ATy = dyn_cast<ArrayType>(ValType)) {
+    Type *EltTy = ATy->getElementType();
+    if (EltTy->isSensitiveTy()) {
+      const DataLayout &DLayout = M.getDataLayout();
+      uint64_t EltSize = DLayout.getTypeAllocSize(EltTy);
+      for (unsigned i = 0; i < ATy->getNumElements(); i++) {
+        settagVariable(M, Builder, BaseAddr, EltTy,
+                       Offset + i * EltSize,
+                       Settag, PerfInstFlag, SettagLoc);
+      }
+    }
+    return;
+  }
+}
