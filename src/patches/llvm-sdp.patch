+  PointerType *&Entry = AddressSpace == 0 ? CImpl->AS0EmitSettagPointerType
+                                          : CImpl->EmitSettagPointerTypes[AddressSpace];
+
+  if (!Entry) {
+    Entry = new (CImpl->Alloc) PointerType(C, AddressSpace);
+    Entry->setEmitSettagFlag(true);
+  }
+
+  return Entry;
