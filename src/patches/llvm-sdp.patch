+PointerType *PointerType::getPointerPointee(Type *EltTy, unsigned AddressSpace) {
+  assert(EltTy && "Can't get a pointer to <null> type!");
+  assert(isValidElementType(EltTy) && "Invalid type for pointer element!");
+
+  // SDP: A pointer to a sensitive pointer should remain sensitive
+  if (auto *PTy = dyn_cast<PointerType>(EltTy)) {
+    if (PTy->getTagoneFlag())
