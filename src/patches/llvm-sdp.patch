+// SDP: Add docs of the sensitive attribute
+def TagoneDocs : Documentation {
+  let Category = DocCatType;
+  let Content = [{
+The ``__tag1`` qualifier specifies that the type of data requires confidentiality and interity gaurantee.
+  }];
+}
+
+// SDP: Add docs of the forcibly-insensitive attribute
+def TagzeroDocs : Documentation {
+  let Category = DocCatType;
+  let Content = [{
+The ``__tag0`` qualifier forces a pointer to be treated as non-sensitive even when the automatic propagation rules (e.g. ``-fsdp-fp``/``-fsdp-fpifp``) would otherwise mark it as sensitive. Loads and stores through a ``__tag0`` pointer are emitted as plain memory accesses (no ``ld_tag1``/``sd_tag1``). It is the inverse of ``__tag1`` and cannot be combined with it on the same pointer.
+  }];
+}
+
+// SDP: Add docs for __emit_settag
+def EmitSettagDocs : Documentation {
+  let Category = DocCatType;
+  let Content = [{
+The ``__emit_settag`` qualifier specifies the special void type for memory allocation and free functions. We detect the assignment of such pointers and emit settag instructions to initialize and remove Sensitivity and TypeID tags for heap sensitive pointers.
+  }];
+}
+
+// SDP: User-copy bookend attributes
+def SDPUserbufDestDocs : Documentation {
+  let Category = DocCatFunction;
+  let Content = [{
+``__attribute__((sdp_userbuf_dest(BufIdx, SizeIdx)))`` marks a kernel
+user-copy primitive whose ``BufIdx``-th argument is a kernel-side buffer
+*written* by an opaque bulk asm copy (e.g. ``copy_from_user``). At each
+call site where the buffer's pointee is a sensitive type with a constant
+size argument matching ``sizeof(*pointee)``, clang reroutes the buffer to
+a fresh untyped stack alloca, then emits a kernel-only typed copy from
+the alloca to the original buffer. Sensitive fields are written with
+``sd_tag1`` (via ``CGBuilder::CreateStore``) so the stack settag pass's
+per-slot TTags remain valid; non-sensitive fields stay plain.
+
+Both indices are 1-based parameter positions. The size argument must be
+an integer expression evaluating at compile time to the destination
+type's size; non-constant or mismatched sizes fall through to a plain
+call (no bookend).
+  }];
+}
+
+def SDPUserbufSrcDocs : Documentation {
+  let Category = DocCatFunction;
+  let Content = [{
+``__attribute__((sdp_userbuf_src(BufIdx, SizeIdx)))`` is the mirror of
+``sdp_userbuf_dest``: the kernel-side buffer is the *read* side of a
+user-copy primitive (e.g. ``copy_to_user``). At each call site where the
+buffer's pointee is a sensitive type with a constant matching size,
+clang allocates a staging buffer, emits a kernel-only typed copy from
+the original buffer into staging (tagged loads via ``ld_tag1`` for
+sensitive fields, plain for the rest), and rewrites the call to read
+from the staging buffer instead.
+
+Both indices are 1-based parameter positions; the size gate matches
+``sdp_userbuf_dest``.
+  }];
+}
 
