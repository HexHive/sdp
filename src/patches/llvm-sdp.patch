+  PointerType *Entry = nullptr;
+  if (AddressSpace == 0) {
+    auto It = CImpl->AS0TypedPointerType.find(EltTy);
+    if (It != CImpl->AS0TypedPointerType.end()) {
+      Entry = It->second;
+    } else {
+      Entry = new (CImpl->Alloc) PointerType(C, AddressSpace);
+      Entry->setPointeeType(EltTy);
+      CImpl->AS0TypedPointerType[EltTy] = Entry;
+    }
+  } else {
+    auto OuterIt = CImpl->TypedPointerTypes.find(AddressSpace);
+    if (OuterIt != CImpl->TypedPointerTypes.end()) {
+      auto &InnerMap = OuterIt->second;
+      auto InnerIt = InnerMap.find(EltTy);
+      if (InnerIt != InnerMap.end()) {
+        Entry = InnerIt->second;
+      } else {
+        Entry = new (CImpl->Alloc) PointerType(C, AddressSpace);
+        Entry->setPointeeType(EltTy);
+        InnerMap[EltTy] = Entry;
+      }
+    } else {
+      CImpl->TypedPointerTypes[AddressSpace] = std::unordered_map<Type*, PointerType*>();
+      Entry = new (CImpl->Alloc) PointerType(C, AddressSpace);
+      Entry->setPointeeType(EltTy);
+      CImpl->TypedPointerTypes[AddressSpace][EltTy] = Entry;
+    }
+  }
