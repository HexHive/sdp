diff --git a/llvm/lib/Target/RISCV/RISCVSDPLoadStoreTagone.cpp b/llvm/lib/Target/RISCV/RISCVSDPLoadStoreTagone.cpp
new file mode 100644
index 0000000000000..d4349d4a09dd0
--- /dev/null
+++ b/llvm/lib/Target/RISCV/RISCVSDPLoadStoreTagone.cpp
@@ -0,0 +1,233 @@
+// SDP: RISC-V SDP load/store pass. Rewrites loads and stores of sensitive
+// (tagone) pointers into the tagged ld_tag1/sd_tag1 encodings, or, in the
+// performance-estimate mode, emits plain instructions of equivalent cost
+
+#include "RISCVSubtarget.h"
+#include "RISCVSettagUtils.h"
+#include "llvm/CodeGen/MachineFunctionPass.h"
+#include "llvm/CodeGen/RegisterScavenging.h"
+#include "llvm/IR/Module.h"
+#include "llvm/Analysis/ValueTracking.h"
+#include "llvm/Support/Format.h"
+
+using namespace llvm;
+#define DEBUG_TYPE "riscv-sdp-load-store-tagone"
+#define RISCV_SDP_LOAD_STORE_TAGONE_NAME "RISC-V emit or estimate SDP load store tagone pass"
+
+namespace {
+
+class RISCVSDPLoadStoreTagone : public MachineFunctionPass {
+public:
+  static char ID;
+  RISCVSDPLoadStoreTagone() : MachineFunctionPass(ID) {}
+
+  bool runOnMachineFunction(MachineFunction &MF) override {
+    const TargetInstrInfo *TII = MF.getSubtarget().getInstrInfo();
+    bool Modified = false;
+
+    const llvm::Module *M = MF.getFunction().getParent();
+    Metadata *RetProtectFlag = M->getModuleFlag("fsdp_ret");
+    Metadata *PerfInstFlag = M->getModuleFlag("fsdp_perf_inst");
+
+    for (MachineBasicBlock &MBB : MF) {
+      for (auto MII = MBB.begin(); MII != MBB.end();) {
+        MachineInstr &MI = *MII;
+        auto NextMII = std::next(MII);
+
+        unsigned Opcode = MI.getOpcode();
+        if (Opcode == RISCV::LD || Opcode == RISCV::SD) {
+
+          // Handle return address ld_tag1/sd_tag1 separately. gp is now holding the return address location
+          if (RetProtectFlag && isRetTagone(MI)) {
+            MI.getOperand(1).setReg(RISCV::X3);
+            setImmediateOperand(MI, 0);
+
+            if (!PerfInstFlag) {
+              if (Opcode == RISCV::LD) {
+                MI.setDesc(TII->get(RISCV::LD_SCP_000));
+              } else {
+                MI.setDesc(TII->get(RISCV::SD_SCP_000));
+              }
+            }
+
+            MII = NextMII;
+            continue;
+          }
+
+          Type *PointeeType = getTagonePointeeType(MI);          
+          if (PointeeType) {
+
+            // Erase ld_tag1 whose destination is x0 to avoid using x0 as the address
+            if (Opcode == RISCV::LD &&
+                MI.getOperand(0).getReg() == RISCV::X0) {
+              MI.eraseFromParent();
+              Modified = true;
+              MII = NextMII;
+              continue;
+            }
+
+            // Check if the immediate offset is non-zero
+            int64_t Offset = getImmediateOperand(MI);
+            if (Offset) {
+              Register AddressReg = MI.getOperand(1).getReg();
+              if (AddressReg == RISCV::NoRegister) {
+                llvm::errs() << "Failed to get address register from instruction:\n";
+                // MI.dump();
+                MII = NextMII;
+                continue;
+              }
+
+              // Add/sub the offset on the address register directly instead of scavenging a register
+
+              Register ValueReg = MI.getOperand(0).getReg();
+
+              if (Opcode == RISCV::LD) {
+                // addi val_reg, addr_reg, imm12
+                BuildMI(MBB, MII, MI.getDebugLoc(), TII->get(RISCV::ADDI))
+                    .addReg(ValueReg, RegState::Define)
+                    .addReg(AddressReg)
+                    .addImm(Offset);
+
+                // ld val_reg, imm12(val_reg)
+                MI.getOperand(1).setReg(ValueReg);
+              } else {
+                // Use a temp register for RISCV::SD since we need to keep the original value register unchanged
+                Register TmpReg = findUnusedRegister(MBB, MII);
+                if (TmpReg != RISCV::NoRegister) {
+                  // addi tmp_reg, addr_reg, imm12
+                  BuildMI(MBB, MII, MI.getDebugLoc(), TII->get(RISCV::ADDI))
+                      .addReg(TmpReg, RegState::Define)
+                      .addReg(AddressReg)
+                      .addImm(Offset);
+
+                  // Set the address register to the new temp register
+                  MI.getOperand(1).setReg(TmpReg);
+                } else {
+                  llvm::errs() << "Failed to find unused register for instruction: " << MI << "\n";
+                  MII = NextMII;
+                  continue;
+                }
+              }
+
+              // Set the immediate operand to zero
+              setImmediateOperand(MI, 0);
+              Modified = true;
+            }
+
+            Metadata *PerfInstFlag =
+                MF.getFunction().getParent()->getModuleFlag("fsdp_perf_inst");
+            if (!PerfInstFlag) {
+              // Change opcode to ld_tag1 or sd_tag1
+              bool IsLoad = (Opcode == RISCV::LD);
+              unsigned int NewOpcode = getNewOpcode(PointeeType, IsLoad);
+              MI.setDesc(TII->get(NewOpcode));
+
+              // Set the immediate operand to TTag
+              setImmediateOperand(MI, getHashLow12(PointeeType));
+
+              Modified = true;
+            }
+          }
+        }
+
+        MII = NextMII;
+      }
+    }
+    return Modified;
+  }
+
+private:
+  long getHashLow12(Type *Ty) {
+    return ::getHash(Ty) & 0xFFF;
+  }
+
+  long getHashMiddle3(Type *Ty) {
+    return (::getHash(Ty) & 0x7000) >> 12;
+  }
+
+  unsigned int getNewOpcode(Type *PointeeType, bool IsLoad) {
+    long Func3 = getHashMiddle3(PointeeType);
+
+    // Debug
+    llvm::errs() << "PointeeType: " << *PointeeType
+                 << ", Hash: "
+                 << format_hex(::getHash(PointeeType) & 0xFFFF, 6)
+                 << ", Func3: " << Func3 << "\n";
+
+    if (PointeeType->isFunctionTy()) {
+      return IsLoad ? RISCV::LD_SCP_000 + Func3 : RISCV::SD_SCP_000 + Func3;
+    }
+    return IsLoad ? RISCV::LD_SDP_000 + Func3 : RISCV::SD_SDP_000 + Func3;
+  }
+
+  bool isRetTagone(const MachineInstr &MI) {
+    if (!MI.memoperands_empty()) {
+      for (const MachineMemOperand *MMO : MI.memoperands()) {
+        if (MMO->getFlags() & MachineMemOperand::MORetTagone) {
+          return true;
+        }
+      }
+    }
+    return false;
+  }
+
+  Type *getTagonePointeeType(const MachineInstr &MI) {
+    if (!MI.memoperands_empty()) {
+      for (const MachineMemOperand *MMO : MI.memoperands()) {
+        if (!MMO->isTagone())
+          continue;
+
+        // Do not tag the global variables in init or discarded sections
+        const Value *V = MMO->getValue();
+        const Value *UO = V ? getUnderlyingObject(V) : nullptr;
+
+        if (UO)
+          if (auto *GV = dyn_cast<GlobalValue>(UO))
+            if (isInDiscardedKernelSection(*GV))
+              continue;
+
+
+        return MMO->getPointerInfo().getPointeeType();
+      }
+    }
+    return nullptr;
+  }
+
+  int64_t getImmediateOperand(const MachineInstr &MI) {
+    for (unsigned i = 0; i < MI.getNumOperands(); ++i) {
+      const MachineOperand &MO = MI.getOperand(i);
+      if (MO.isImm()) {
+        return MO.getImm();
+      }
+    }
+    // Invalid immediate
+    return 0;
+  }
+  
+  void setImmediateOperand(MachineInstr &MI, int64_t NewImm) {
+    for (unsigned i = 0; i < MI.getNumOperands(); ++i) {
+      MachineOperand &MO = MI.getOperand(i);
+      if (MO.isImm()) {
+        MO.setImm(NewImm);
+        return;
+      }
+    }
+  }
+
+  Register findUnusedRegister(MachineBasicBlock &MBB, MachineBasicBlock::iterator &MII) {
+    RegScavenger RS;
+    RS.enterBasicBlockEnd(MBB);
+    RS.backward(MII);
+    return RS.FindUnusedReg(&RISCV::GPRRegClass);
+  }
+};
+} // End anonymous namespace
+
+char RISCVSDPLoadStoreTagone::ID = 0;
+
+INITIALIZE_PASS(RISCVSDPLoadStoreTagone, DEBUG_TYPE,
+                RISCV_SDP_LOAD_STORE_TAGONE_NAME, false, false);
+
+FunctionPass *llvm::createRISCVSDPLoadStoreTagonePass() {
+  return new RISCVSDPLoadStoreTagone();
+}
