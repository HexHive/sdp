+// SDP: Handle PointerType::get with sensitive tag and PointeeType
+PointerType *PointerType::getTagone(LLVMContext &C, unsigned AddressSpace, Type *PointeeType) {
+  LLVMContextImpl *CImpl = C.pImpl;
+
+  // Since AddressSpace #0 is the common case, we special case it.
+  PointerType *Entry = nullptr;
+  if (AddressSpace == 0) {
+    auto It = CImpl->AS0TagonePointerType.find(PointeeType);
+    if (It != CImpl->AS0TagonePointerType.end()) {
+      Entry = It->second;
+    } else {
+      Entry = new (CImpl->Alloc) PointerType(C, AddressSpace);
+      Entry->setTagoneFlag(true);
+      Entry->setPointeeType(PointeeType);
+      CImpl->AS0TagonePointerType[PointeeType] = Entry;
+    }
+  } else {
+    auto OuterIt = CImpl->TagonePointerTypes.find(AddressSpace);
+    if (OuterIt != CImpl->TagonePointerTypes.end()) {
+      auto &InnerMap = OuterIt->second;
+      auto InnerIt = InnerMap.find(PointeeType);
+      if (InnerIt != InnerMap.end()) {
+        Entry = InnerIt->second;
+      } else {
+        Entry = new (CImpl->Alloc) PointerType(C, AddressSpace);
+        Entry->setTagoneFlag(true);
+        Entry->setPointeeType(PointeeType);
+        InnerMap[PointeeType] = Entry;
+      }
+    } else {
+      CImpl->TagonePointerTypes[AddressSpace] = std::unordered_map<Type*, PointerType*>();
+      Entry = new (CImpl->Alloc) PointerType(C, AddressSpace);
+      Entry->setTagoneFlag(true);
+      Entry->setPointeeType(PointeeType);
+      CImpl->TagonePointerTypes[AddressSpace][PointeeType] = Entry;
+    }
+  }
+
+  return Entry;
+}
