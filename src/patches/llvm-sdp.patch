+// SDP: Without -fsdp-fp/-fsdp-fpifp the sensitivity json is unused, so records
+// with only hand-written `__tag1` fields must be named here to stay sensitive
+bool CodeGenFunction::isSecEvalTagoneRecord(QualType Ty) {
+  if (getLangOpts().SDPFPProtect || getLangOpts().SDPFPIFPProtect) // Comment out for sdp-sdretfp
+    return false; // Comment out for sdp-sdretfp
+  const auto *RT = Ty->getAs<RecordType>();
+  if (!RT)
+    return false;
+  const RecordDecl *RD = RT->getDecl();
+  if (!RD->getIdentifier())
+    return false;
+  StringRef Name = RD->getName();
+  return Name == "task_struct" || Name == "mm_struct";
+}
