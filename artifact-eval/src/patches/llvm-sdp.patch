+#include "RISCVInstrInfo.h"
+#include "llvm/Transforms/Utils/BasicBlockUtils.h"
+#include "RISCVSettagUtils.h"
+#include "llvm/IR/IntrinsicInst.h"
+#include "llvm/IR/MDBuilder.h"
+#include "llvm/IR/Module.h"
+
+using namespace llvm;
+#define DEBUG_TYPE "riscv-heap-settag-instrumentation"
+#define RISCV_HEAP_SETTAG_INSTRUMENTATION_NAME "RISC-V heap settag instrumentation pass"
+
+namespace {
+
+// Determine the allocation pointee type for an allocator call.
+//
+// Type comes from the call's sensitive bitcast users / sdp.alloc.type
+// marker. When AllocSize is known, we prefer the largest pointee that
+// *fits within* AllocSize, which gives an exact match when possible and
+// refuses to instrument when every candidate pointee is larger than the
+// allocation (avoids a buffer overshoot through a too-large bitcast
+// type).
+//
+// Array allocations: for `kcalloc(N, sizeof(*p))` / `kmalloc_array(N,
+// sizeof(*p))` and similar two-argument allocators, Clang's marker
+// already carries `[N x Pointee]` directly (see CGExprScalar.cpp —
+// VisitCastExpr reads `__alloc_size(elem, num)` from the source-level
+// callee and wraps the pointee accordingly). Such markers land here as
+// `ArrayType` and are returned as-is; settagVariable walks ArrayType
+// uniformly, so set_tag1 fires for every element's tagone slots. No
+// AllocSize/BestSize back-derivation is needed for that path. The
+// dealloc-side asymmetry (kfree carries no size info, so only one
+// struct's footprint is cleared) is a known slab-pool tag-residue
+// hazard — accepted, because the alternative (panic on first read of
+// any element past [0]) is a hard crash on first use.
+static Type *deriveAllocPointeeType(CallInst *CallI, Module *M,
+                                    std::optional<unsigned> FallbackSizeArgIdx) {
+  // Step 1: Collect sensitive pointee types from direct users of the call.
+  // The allocator returns void* (no pointee in IR), so the type info has to
+  // come from how the value is used.
+  //
+  //   - `llvm.sdp.alloc.type` marker (preferred): Clang emits this at every
+  //     `void* -> T*` cast where T is a sensitive struct. The intrinsic's
+  //     metadata operand wraps a typed undef whose LLVM type IS the
+  //     pointee. Authoritative and survives every IR pass — opaque-pointer
+  //     IR and byte-flat GEPs don't drop the signal.
+  //   - `BitCastInst` (legacy): pre-marker code, and any synthetic IR that
+  //     happens to land an explicit cast to a sensitive typed pointer.
+  //     Kept as a fallback — produces the same pointees the marker would,
+  //     so the ranking step downstream stays deterministic.
+  SmallVector<Type *, 4> Pointees;
+  for (User *U : CallI->users()) {
+    if (auto *MI = dyn_cast<IntrinsicInst>(U)) {
+      if (MI->getIntrinsicID() != Intrinsic::sdp_alloc_type)
+        continue;
+      auto *MAV = dyn_cast<MetadataAsValue>(MI->getArgOperand(1));
+      if (!MAV)
+        continue;
+      // MetadataAsValue::get canonicalizes single-operand MDNodes by
+      // unwrapping the operand, so the metadata here is the
+      // ConstantAsMetadata directly, not an enclosing MDNode. Also accept
+      // an MDNode form defensively for tools that hand-roll the IR.
+      Metadata *MD = MAV->getMetadata();
+      auto *CAM = dyn_cast<ConstantAsMetadata>(MD);
+      if (!CAM) {
+        if (auto *MDN = dyn_cast<MDNode>(MD))
+          if (MDN->getNumOperands() > 0)
+            CAM = dyn_cast<ConstantAsMetadata>(MDN->getOperand(0));
+      }
+      if (!CAM)
+        continue;
+      Type *Pointee = CAM->getValue()->getType();
+      if (Pointee && Pointee->isSensitiveTy())
+        Pointees.push_back(Pointee);
+      continue;
+    }
+    if (auto *BCI = dyn_cast<BitCastInst>(U)) {
+      auto *DestPtrTy = dyn_cast<PointerType>(BCI->getDestTy());
+      if (!DestPtrTy)
+        continue;
+      Type *PointeeType = DestPtrTy->getPointeeType();
+      if (PointeeType && PointeeType->isSensitiveTy())
+        Pointees.push_back(PointeeType);
+      continue;
+    }
+  }
+
+  // Early exit: no sensitive marker/cast user. Most heap allocations — in
+  // particular non-sensitive ones and slab allocs whose result is never
+  // used as a sensitive type in this TU — land here and bail cheaply.
+  if (Pointees.empty())
+    return nullptr;
+
+  const DataLayout &DL = M->getDataLayout();
+  Function *Callee = CallI->getCalledFunction();
+
+  // Step 2: Extract the constant alloc size from the allocsize attribute
+  // or hardcoded fallback index.
+  std::optional<uint64_t> AllocSize;
+  if (Callee && Callee->hasFnAttribute(Attribute::AllocSize)) {
+    auto Args = Callee->getFnAttribute(Attribute::AllocSize).getAllocSizeArgs();
+    if (Args.first < CallI->arg_size()) {
+      if (auto *SC =
+              dyn_cast<ConstantInt>(CallI->getArgOperand(Args.first))) {
+        uint64_t S = SC->getZExtValue();
+        if (Args.second && *Args.second < CallI->arg_size()) {
+          if (auto *NC = dyn_cast<ConstantInt>(CallI->getArgOperand(*Args.second)))
+            AllocSize = S * NC->getZExtValue();
+        } else if (!Args.second) {
+          AllocSize = S;
+        }
+      }
+    }
+  } else if (FallbackSizeArgIdx && *FallbackSizeArgIdx < CallI->arg_size()) {
+    if (auto *SC = dyn_cast<ConstantInt>(
+            CallI->getArgOperand(*FallbackSizeArgIdx)))
+      AllocSize = SC->getZExtValue();
+  }
+
+  // Step 3: AllocSize known — pick the largest pointee that fits within
+  // the allocation. Exact match wins by construction (largest among the
+  // fitters). If no candidate fits, refuse to instrument rather than
+  // overshoot the allocation.
+  if (AllocSize) {
+    Type *Best = nullptr;
+    uint64_t BestSize = 0;
+    for (Type *T : Pointees) {
+      uint64_t PSize = DL.getTypeAllocSize(T);
+      if (PSize == 0 || PSize > *AllocSize)
+        continue;
+      if (PSize > BestSize) {
+        Best = T;
+        BestSize = PSize;
+      }
+    }
+    return Best;
+  }
+
+  // Step 4: AllocSize unknown (typical for kmem_cache_alloc, where the
+  // size lives in the runtime cache descriptor). Fall back to the
+  // largest sensitive pointee. Sub-casts at offset 0 are smaller than
+  // the actual allocation type by construction.
+  Type *Best = nullptr;
+  uint64_t BestSize = 0;
+  for (Type *T : Pointees) {
+    uint64_t S = DL.getTypeAllocSize(T);
+    if (!Best || S > BestSize) {
+      Best = T;
+      BestSize = S;
+    }
+  }
+  return Best;
+}
+
+// Recover the typed base pointer and sensitive pointee type for a value
+// passed to free()/kfree()/etc. stripPointerCasts walks through bitcasts,
+// addrspacecasts, and all-zero GEPs to reach the original typed pointer.
+// Handling the cast chain matters because Clang may emit a bitcast to
+// i8* at the call site, intermediate optimizations can chain casts, and
+// callers occasionally hand the allocator a sub-pointer at offset 0
+// (which still refers to the same underlying allocation).
+struct DeallocInfo {
+  Value *BaseAddr;
+  Type *PointeeType;
+};
+
+static std::optional<DeallocInfo>
+deriveDeallocPointeeType(Value *FreeArg) {
+  // Helper: pull a sensitive pointee out of an llvm.sdp.alloc.type marker's
+  // metadata operand. The metadata operand is the canonicalized
+  // ConstantAsMetadata (see MetadataAsValue::get) — defensively also accept
+  // a wrapping MDNode.
+  auto ReadMarkerPointee = [](IntrinsicInst *MI) -> Type * {
+    if (MI->getIntrinsicID() != Intrinsic::sdp_alloc_type)
+      return nullptr;
+    auto *MAV = dyn_cast<MetadataAsValue>(MI->getArgOperand(1));
+    if (!MAV)
+      return nullptr;
+    Metadata *MD = MAV->getMetadata();
+    auto *CAM = dyn_cast<ConstantAsMetadata>(MD);
+    if (!CAM) {
+      if (auto *MDN = dyn_cast<MDNode>(MD))
+        if (MDN->getNumOperands() > 0)
+          CAM = dyn_cast<ConstantAsMetadata>(MDN->getOperand(0));
+    }
+    if (!CAM)
+      return nullptr;
+    Type *Pointee = CAM->getValue()->getType();
+    if (!Pointee || !Pointee->isSensitiveTy())
+      return nullptr;
+    return Pointee;
+  };
+
+  // Prefer the marker. Clang emits it at the T*->void* cast on the way
+  // into kfree / kmem_cache_free / krealloc; stripPointerCasts walks past
+  // any intervening bitcasts/zero-GEPs to land on the marker call. The
+  // marker is a pointer passthrough — its arg 0 is the original typed
+  // pointer, which is what we hand to the settag emitter as BaseAddr.
+  Value *V = FreeArg->stripPointerCasts();
+  while (auto *MI = dyn_cast<IntrinsicInst>(V)) {
+    if (MI->getIntrinsicID() != Intrinsic::sdp_alloc_type)
+      break;
+    if (Type *Pointee = ReadMarkerPointee(MI))
+      return DeallocInfo{MI->getArgOperand(0)->stripPointerCasts(), Pointee};
+    V = MI->getArgOperand(0)->stripPointerCasts();
+  }
+
+  // Fallback: typed-pointer-based detection (legacy / -fsdp-fpifp where
+  // `struct X *` is itself tagone and carries pointee info in the IR
+  // pointer type).
+  PointerType *BasePtrTy = dyn_cast<PointerType>(V->getType());
+  if (!BasePtrTy)
+    return std::nullopt;
+  Type *PointeeType = BasePtrTy->getPointeeType();
+  if (!PointeeType || !PointeeType->isSensitiveTy())
+    return std::nullopt;
+  return DeallocInfo{V, PointeeType};
+}
+
+// A struct's trailing flexible array member (FAM): a `T attrs[]` field,
+// which Clang lowers to a zero-length array `[0 x T]`. settagVariable walks
+// arrays by their *declared* element count, so a `[0 x T]` tail contributes
+// nothing — its real extent is only known at allocation time. getSensitiveFam
+// recognizes such a tail when T is a sensitive type, so the heap pass can
+// settag it with a runtime loop keyed off the allocator's size argument.
+struct FamInfo {
+  Type *EltTy;         // the sensitive FAM element type T
+  uint64_t ByteOffset; // offset of the FAM within the enclosing struct
+};
+
+static std::optional<FamInfo> getSensitiveFam(Type *PointeeTy,
+                                              const DataLayout &DL) {
+  auto *STy = dyn_cast_or_null<StructType>(PointeeTy);
+  if (!STy || STy->isOpaque() || STy->getNumElements() == 0)
+    return std::nullopt;
+  unsigned LastIdx = STy->getNumElements() - 1;
+  auto *ATy = dyn_cast<ArrayType>(STy->getElementType(LastIdx));
+  // A C flexible array member lowers to a zero-length array. A non-zero
+  // `[N x T]` tail is a real fixed array already covered by the uniform
+  // array walk in settagVariable — don't double-handle it here.
+  if (!ATy || ATy->getNumElements() != 0)
+    return std::nullopt;
+  Type *EltTy = ATy->getElementType();
+  if (!EltTy || !EltTy->isSensitiveTy())
+    return std::nullopt;
+  return FamInfo{EltTy, DL.getStructLayout(STy)->getElementOffset(LastIdx)};
+}
+
+// Return the IR Value for an allocator call's single total-size argument
+// (the `kmalloc(total)` / `krealloc(p, total, flags)` shape). Used to derive
+// a struct-with-FAM's runtime element count. Returns nullptr for the
+// two-argument `calloc(n, size)` shape — that has no single total size and
+// is a pure array, not a struct-with-FAM — and when the size argument index
+// can't be resolved.
+static Value *getAllocSizeValue(CallInst *CallI,
+                                std::optional<unsigned> FallbackSizeArgIdx) {
+  Function *Callee = CallI->getCalledFunction();
+  if (Callee && Callee->hasFnAttribute(Attribute::AllocSize)) {
+    auto Args =
+        Callee->getFnAttribute(Attribute::AllocSize).getAllocSizeArgs();
+    if (Args.second)
+      return nullptr; // elem*count form — handled as an array elsewhere
+    if (Args.first < CallI->arg_size())
+      return CallI->getArgOperand(Args.first);
+    return nullptr;
+  }
+  if (FallbackSizeArgIdx && *FallbackSizeArgIdx < CallI->arg_size())
+    return CallI->getArgOperand(*FallbackSizeArgIdx);
+  return nullptr;
+}
+
+// A pending settag instrumentation site. Sites are collected during the
+// per-function walk and emitted (NULL-guarded) afterwards, so the walk
+// itself doesn't mutate the CFG while iterating.
+struct HeapSite {
+  Instruction *InsertBefore = nullptr;
+  Value *BaseAddr = nullptr;
+  Type *PointeeType = nullptr;
+  bool IsDealloc = false;
+  // FZY: Per-CPU dynamic allocation (alloc_percpu / __alloc_percpu_gfp /
+  // free_percpu). __alloc_percpu returns a percpu *offset* pointer; the
+  // real instances live at BaseAddr + __per_cpu_offset[cpu] for every cpu.
+  // A straight settagVariable on BaseAddr would stamp only the offset
+  // template, so an IsPercpu site is emitted as a per-CPU loop
+  // (emitHeapPercpuSettagLoop) instead. FAM handling does not apply.
+  bool IsPercpu = false;
+  // Flexible-array-member settag. When the pointee is a struct ending in a
+  // sensitive `[0 x T]` FAM, these drive a runtime loop (emitFamSettagLoop)
+  // that settags/clears every FAM element — settagVariable's straight-line
+  // walk covers only the struct's declared (non-FAM) fields. FamEltTy and
+  // FamOffset are set for both alloc and dealloc sites whenever the FAM is
+  // sensitive. FamSizeVal selects the element-count source: an alloc site
+  // stores the allocator's total-size argument directly; a dealloc site
+  // leaves it null (kfree / realloc-free carry no size argument) and the
+  // emission step recovers the size by calling ksize() on the still-live
+  // pointer before it is freed. Without the dealloc-side clear the FAM's
+  // STag=1 lingers in the freed slab block and a later non-FAM reuse (e.g.
+  // a kernfs_node landing on a freed module_param_attrs) hits a plain
+  // ld/sd of tagged memory — "load mismatch" / "store mismatch".
+  Type *FamEltTy = nullptr;
+  uint64_t FamOffset = 0;
+  Value *FamSizeVal = nullptr;
+  // FZY: Count-carrying array free (sdp_kfree_array(ptr, count)). kfree
+  // carries no element count, so an array of `count` sensitive structs is
+  // settagged for all `count` elements at alloc (the `[N x T]` marker) but
+  // the heap pass can only clear element [0] at free — elements [1..N-1]
+  // leak STag=1 into the slab pool, and a later reuse of that block hits a
+  // tag mismatch. sdp_kfree_array passes the count explicitly; when set,
+  // ExplicitArrayCount drives a runtime loop (emitFamSettagLoop) that
+  // clears exactly `count` elements of PointeeType from offset 0 — no
+  // straight-line settagVariable, no ksize over-walk. The count is the
+  // element count (not bytes); it is symmetric with the alloc-side
+  // settagVariable walk of the `[N x T]` marker, so every set_tag0 lands on
+  // a slot a set_tag1 touched.
+  Value *ExplicitArrayCount = nullptr;
+  // FZY: True when this site is a userspace free/realloc. The FAM-on-dealloc
+  // emission queries the live allocation for its bucket-rounded size; the
+  // helper is `ksize` for kernel allocators and `malloc_usable_size` for
+  // glibc-family userspace allocators. Both have the same signature
+  // (size_t fn(void *)) and same bucket-rounding semantics, so only the
+  // function name differs.
+  bool IsUserspace = false;
+};
+
+// Build a HeapSite for an allocator call. When the allocated pointee is a
+// struct whose tail is a sensitive flexible array member, record the FAM
+// element type and the allocator's runtime total-size argument so the
+// emission step can settag the FAM with a runtime loop.
+static HeapSite makeAllocSite(CallInst *CallI, Type *PointeeType, Module *M,
+                              std::optional<unsigned> FallbackIdx) {
+  HeapSite Site;
+  Site.InsertBefore = CallI->getNextNode();
+  Site.BaseAddr = CallI;
+  Site.PointeeType = PointeeType;
+  Site.IsDealloc = false;
+  if (auto Fam = getSensitiveFam(PointeeType, M->getDataLayout())) {
+    if (Value *Sz = getAllocSizeValue(CallI, FallbackIdx)) {
+      if (Sz->getType()->isIntegerTy()) {
+        Site.FamEltTy = Fam->EltTy;
+        Site.FamOffset = Fam->ByteOffset;
+        Site.FamSizeVal = Sz;
+        llvm::errs() << "  FAM tail: [0 x " << *Fam->EltTy << "] @ offset "
+                     << Fam->ByteOffset << "\n";
+      }
+    }
+  }
+  return Site;
+}
+
+// Build a HeapSite for a free / realloc-free site. When the freed pointee is
+// a struct whose tail is a sensitive flexible array member, record the FAM
+// element type and offset so the emission step clears the FAM tail too —
+// settagVariable's straight-line walk covers only the declared header
+// fields. FamSizeVal is left null on purpose: kfree / realloc-free carry no
+// size argument, so the runtime element count is recovered at emission time
+// via a ksize() call on the still-live pointer. Skipping this clear leaves
+// the FAM's STag=1 in the freed slab block; a later non-FAM reuse of that
+// block then traps a plain ld/sd as a tag mismatch.
+static HeapSite makeDeallocSite(Instruction *InsertBefore, Value *BaseAddr,
+                                Type *PointeeType, Module *M,
+                                bool AllowFam = true,
+                                bool IsUserspace = false) {
+  HeapSite Site;
+  Site.InsertBefore = InsertBefore;
+  Site.BaseAddr = BaseAddr;
+  Site.PointeeType = PointeeType;
+  Site.IsDealloc = true;
+  Site.IsUserspace = IsUserspace;
+  // AllowFam=false for vfree: the FAM-on-dealloc path queries the live
+  // allocation for its bucket-rounded size, and the kernel's ksize() is
+  // slab-only — calling it on a vmalloc'd pointer returns garbage or panics.
+  // vmalloc-backed sensitive structs with a sensitive-element FAM are
+  // extremely rare in practice (bpf_prog's insns[] is non-sensitive); if one
+  // shows up, vfree's FAM clear needs a different size source (e.g.
+  // vmap_area lookup). Userspace `free` / `realloc` always allow FAM —
+  // glibc's malloc_usable_size() is defined for every malloc-family pointer.
+  if (AllowFam) {
+    if (auto Fam = getSensitiveFam(PointeeType, M->getDataLayout())) {
+      Site.FamEltTy = Fam->EltTy;
+      Site.FamOffset = Fam->ByteOffset;
+      // FamSizeVal stays null — emission queries the appropriate runtime
+      // sizer (ksize or malloc_usable_size; selected via Site.IsUserspace).
+      const char *Sizer = IsUserspace ? "malloc_usable_size" : "ksize";
+      llvm::errs() << "  FAM tail (dealloc, " << Sizer << "): [0 x "
+                   << *Fam->EltTy << "] @ offset " << Fam->ByteOffset << "\n";
+    }
+  }
+  return Site;
+}
+
+// FZY: RISCVHeapSettagInstrumentation, to instrument code that sets Sensitivity and TypeID tags for heap sensitive pointers
+class RISCVHeapSettagInstrumentation : public FunctionPass {
+public:
+  static char ID;
+  RISCVHeapSettagInstrumentation() : FunctionPass(ID) {}
+  
+  void createSettagLoop(Module *M, Function &F, Instruction *BitCastI, Value *BaseAddr, Value *CountArg, Type *PointeeType, bool Settag, bool PerfInstFlag) {
+    
+    // Split the basic block right after the call instruction
+    BasicBlock *CurrentBlock = BitCastI->getParent();
+    BasicBlock *ContinueBlock = SplitBlock(CurrentBlock, BitCastI->getNextNode());
+    
+    // Create basic blocks for the loop
+    BasicBlock *LoopHeader = BasicBlock::Create(F.getContext(), "loop.header", &F, ContinueBlock);
+    BasicBlock *LoopBody = BasicBlock::Create(F.getContext(), "loop.body", &F, ContinueBlock);
+    BasicBlock *LoopEnd = BasicBlock::Create(F.getContext(), "loop.end", &F, ContinueBlock);
+    
+    // Remove the unconditional branch that was added by SplitBlock and replace with branch to loop header
+    CurrentBlock->getTerminator()->eraseFromParent();
+    IRBuilder<> Builder(CurrentBlock);
+    
+    Builder.CreateBr(LoopHeader);
+    
+    // Loop Header: Initialize loop counter
+    Builder.SetInsertPoint(LoopHeader);
+    PHINode *Counter = Builder.CreatePHI(CountArg->getType(), 2, "loop.counter");
+    Counter->addIncoming(ConstantInt::get(CountArg->getType(), 0), CurrentBlock);
+    
+    // Compare counter with loop count
+    Value *Condition = Builder.CreateICmpULT(Counter, CountArg, "loop.condition");
+    Builder.CreateCondBr(Condition, LoopBody, LoopEnd);
+    
+    // Loop Body: Instrument here
+    Builder.SetInsertPoint(LoopBody);
+                    
+    // Add the current offset (the loop counter) to BaseAddr
+    Value *CurrentBaseAddr = Builder.CreateGEP(PointeeType, BaseAddr, Counter, "current.baseaddr");
+    
+    settagVariable(*M, Builder, CurrentBaseAddr, PointeeType, 0, Settag, PerfInstFlag, AllocationType::Heap);
+                    
+    // Increment counter
+    Value *NextCounter = Builder.CreateAdd(Counter, ConstantInt::get(CountArg->getType(), 1), "loop.next");
+    
+    // Branch back to header
+    Builder.CreateBr(LoopHeader);
+    
+    // Update PHI node with the new counter value from the loop body
+    Counter->addIncoming(NextCounter, LoopBody);
+    
+    // Loop End: Branch to the original continuation block
+    Builder.SetInsertPoint(LoopEnd);
+    Builder.CreateBr(ContinueBlock);
+  }
+
+  // Settag a struct's trailing flexible array member with a runtime loop.
+  // settagVariable's straight-line walk covers only the struct's declared
+  // (non-FAM) fields, so a `T attrs[]` tail — lowered to `[0 x T]` — gets
+  // nothing. The element count is computed by the caller from the
+  // allocator's size argument (Count = (alloc_size - FamByteOffset) /
+  // sizeof(T)); this loop settags every FAM element's tagone slots. The
+  // loop is spliced in before InsertBefore (the terminator of the settag
+  // then-block). Count == 0 (the first, header-only allocation, where
+  // alloc_size == sizeof(struct)) falls straight through.
+  void emitFamSettagLoop(Module *M, Function &F, Instruction *InsertBefore,
+                         Value *BaseAddr, uint64_t FamByteOffset,
+                         Type *FamEltTy, Value *Count, bool Settag,
+                         bool PerfInstFlag, AllocationType AT) {
+    LLVMContext &Ctx = F.getContext();
+    BasicBlock *CurBB = InsertBefore->getParent();
+    BasicBlock *ContBB = SplitBlock(CurBB, InsertBefore);
+    BasicBlock *HdrBB =
+        BasicBlock::Create(Ctx, "fam.settag.header", &F, ContBB);
+    BasicBlock *BodyBB =
+        BasicBlock::Create(Ctx, "fam.settag.body", &F, ContBB);
+
+    // Drop SplitBlock's fallthrough branch; compute the FAM base pointer
+    // (allocation base + FamByteOffset) and enter the loop header.
+    CurBB->getTerminator()->eraseFromParent();
+    IRBuilder<> B(CurBB);
+    Value *FamBase = B.CreateGEP(Type::getInt8Ty(Ctx), BaseAddr,
+                                 B.getInt64(FamByteOffset), "fam.base");
+    B.CreateBr(HdrBB);
+
+    // Header: index PHI + unsigned bound check.
+    B.SetInsertPoint(HdrBB);
+    Type *CntTy = Count->getType();
+    PHINode *Idx = B.CreatePHI(CntTy, 2, "fam.idx");
+    Idx->addIncoming(ConstantInt::get(CntTy, 0), CurBB);
+    Value *Cond = B.CreateICmpULT(Idx, Count, "fam.cond");
+    B.CreateCondBr(Cond, BodyBB, ContBB);
+
+    // Body: settag element [Idx], increment, back-edge. settagVariable
+    // emits only straight-line GEP/asm/store, so the insert point stays in
+    // BodyBB and the back-edge PHI input block is BodyBB.
+    B.SetInsertPoint(BodyBB);
+    Value *EltAddr = B.CreateGEP(FamEltTy, FamBase, Idx, "fam.elt");
+    settagVariable(*M, B, EltAddr, FamEltTy, 0, Settag, PerfInstFlag, AT);
+    Value *Next = B.CreateAdd(Idx, ConstantInt::get(CntTy, 1), "fam.next");
+    B.CreateBr(HdrBB);
+    Idx->addIncoming(Next, BodyBB);
+  }
+
+  // FZY: Settag every per-CPU instance of a dynamically allocated percpu
+  // struct. alloc_percpu(T) / alloc_percpu_gfp(T) lower to __alloc_percpu /
+  // __alloc_percpu_gfp, which return a percpu *offset* pointer — the actual
+  // per-CPU instances live at
+  //   base_cpu = ret + __per_cpu_offset[cpu]
+  // for cpu in [0, nr_cpu_ids). A plain settagVariable on the bare return
+  // value would stamp only the offset template; set_tag's STag is shadow
+  // metadata reached through the real address, so every CPU's instance has
+  // to be stamped at its own runtime address. This mirrors
+  // RISCVGlobalSettagInstrumentation::emitPercpuSettagLoop (for static
+  // DEFINE_PER_CPU globals), but here the loop is spliced inline right at
+  // the alloc/free call site: by the time any __alloc_percpu runs,
+  // setup_per_cpu_areas() has long finished, so __per_cpu_offset[] and
+  // nr_cpu_ids are already valid. The loop is spliced in before
+  // InsertBefore (the terminator of the NULL-guard then-block).
+  void emitHeapPercpuSettagLoop(Module *M, Function &F,
+                                Instruction *InsertBefore, Value *PercpuBase,
+                                Type *PointeeType, bool Settag,
+                                bool PerfInstFlag, AllocationType AT) {
+    LLVMContext &Ctx = F.getContext();
+    Type *I8 = Type::getInt8Ty(Ctx);
+    Type *I32 = Type::getInt32Ty(Ctx);
+    Type *I64 = Type::getInt64Ty(Ctx);
+
+    // Kernel-side externs: __per_cpu_offset[] (filled by setup_per_cpu_areas)
+    // and nr_cpu_ids. Declare them if this TU hasn't referenced them yet.
+    GlobalVariable *PerCpuOffset =
+        M->getGlobalVariable("__per_cpu_offset", /*AllowInternal=*/true);
+    if (!PerCpuOffset)
+      PerCpuOffset = new GlobalVariable(
+          *M, ArrayType::get(I64, 0), /*isConstant=*/false,
+          GlobalValue::ExternalLinkage, nullptr, "__per_cpu_offset");
+    GlobalVariable *NrCpuIds =
+        M->getGlobalVariable("nr_cpu_ids", /*AllowInternal=*/true);
+    if (!NrCpuIds)
+      NrCpuIds = new GlobalVariable(*M, I32, /*isConstant=*/false,
+                                    GlobalValue::ExternalLinkage, nullptr,
+                                    "nr_cpu_ids");
+
+    BasicBlock *CurBB = InsertBefore->getParent();
+    BasicBlock *ContBB = SplitBlock(CurBB, InsertBefore);
+    BasicBlock *HdrBB =
+        BasicBlock::Create(Ctx, "pcpu.settag.header", &F, ContBB);
+    BasicBlock *BodyBB =
+        BasicBlock::Create(Ctx, "pcpu.settag.body", &F, ContBB);
+
+    // Drop SplitBlock's fallthrough branch; load nr_cpu_ids once, enter loop.
+    CurBB->getTerminator()->eraseFromParent();
+    IRBuilder<> B(CurBB);
+    Value *NrCpus =
+        B.CreateLoad(I32, NrCpuIds, /*isVolatile=*/false, "nr.cpu.ids");
+    B.CreateBr(HdrBB);
+
+    // Header: cpu = phi(0, cpu.next); if (cpu < nr_cpus) body else cont.
+    B.SetInsertPoint(HdrBB);
+    PHINode *CpuPhi = B.CreatePHI(I32, 2, "cpu");
+    CpuPhi->addIncoming(ConstantInt::get(I32, 0), CurBB);
+    Value *Cond = B.CreateICmpULT(CpuPhi, NrCpus, "pcpu.cond");
+    B.CreateCondBr(Cond, BodyBB, ContBB);
+
+    // Body: base = PercpuBase + __per_cpu_offset[cpu]; settag; increment.
+    // settagVariable emits only straight-line GEP/asm/store, so the insert
+    // point stays in BodyBB and the back-edge PHI input block is BodyBB.
+    B.SetInsertPoint(BodyBB);
+    Value *OffAddr = B.CreateGEP(I64, PerCpuOffset, CpuPhi, "pcpu.offset.addr");
+    Value *Off =
+        B.CreateLoad(I64, OffAddr, /*isVolatile=*/false, "pcpu.offset");
+    Value *Base = B.CreateGEP(I8, PercpuBase, Off, "pcpu.base");
+    settagVariable(*M, B, Base, PointeeType, 0, Settag, PerfInstFlag, AT);
+    Value *Next = B.CreateAdd(CpuPhi, ConstantInt::get(I32, 1), "cpu.next");
+    B.CreateBr(HdrBB);
+    CpuPhi->addIncoming(Next, B.GetInsertBlock());
+  }
+
+  bool runOnFunction(Function &F) override {
+    Module *M = F.getParent();
+    Metadata *PerfInstFlag = M->getModuleFlag("fsdp_perf_inst");
+    Metadata *SDPFPIFPFlag = M->getModuleFlag("fsdp_fpifp");
+    Metadata *SDPFPFlag    = M->getModuleFlag("fsdp_fp");
+    bool KmemFPMode = SDPFPIFPFlag || SDPFPFlag;
+
+    // FZY: TODO: Infer this automatically
+    bool IsKernel = true;
+
+    bool Modified = false;
+
+    // Collect instrumentation during the function walk but not insert the NULL guard to avoid messing with the CFG while iterating
+    SmallVector<HeapSite, 16> HeapSites;
+
+    for (auto &BB : F) {
+      for (auto I = BB.begin(); I != BB.end(); ++I) {
+        // Walk the function for allocator/deallocator call sites and queue
+        // a HeapSite for each one whose result/argument is a sensitive
+        // pointer type. Actual settag emission is deferred to after the
+        // walk so we don't mutate the CFG mid-iteration.
+        if (CallInst *CallI = dyn_cast<CallInst>(&*I)) {
+          Function *Callee = CallI->getCalledFunction();
+          if (!Callee)
+            continue;
+          StringRef CalleeName = Callee->getName();
+          if (IsKernel) {
+            if (KmemFPMode) { // Broad kmem instrumentation (fsdp_fpifp or fsdp_fp)
+              bool IsSlabAlloc = CalleeName.starts_with("kmem_cache_alloc");
+              // FZY: sdp_cache_alloc(cache) / sdp_cache_free(cache, ptr),
+              // SDP randomized allocator (mm/sdp_cache.c) used for
+              // sensitive heap objects
+              bool IsSdpCacheAlloc = CalleeName == "sdp_cache_alloc";
+              // The kernel's kmalloc / kmalloc_node / kzalloc / kzalloc_node
+              // are static inlines that dispatch on size to several real
+              // callees: small constants → kmalloc_trace / kmalloc_node_trace,
+              // large constants → kmalloc_large / kmalloc_large_node,
+              // variable size → __kmalloc / __kmalloc_node. We match the
+              // whole `kmalloc*` family (plus `__kmalloc*` and `kvmalloc*`)
+              // rather than enumerating each leaf — non-allocator names like
+              // `kmalloc_size_roundup` are filtered out downstream by the
+              // "no sensitive bitcast user" early-return in
+              // deriveAllocPointeeType, since they don't return a sensitive
+              // pointer.
+              // FZY: kmemdup(src, len, gfp) duplicates a buffer —
+              // kmalloc_track_caller + memcpy. The memcpy carries the
+              // source's TTag word (top-16 of each slot) but NOT its
+              // STag shadow, so a kmemdup of a settagged source (e.g. a
+              // static `struct ctl_table[]` global) lands STag=0 in the
+              // heap copy and the first tagged read traps. Fold it into
+              // the kmalloc family: it returns a kmalloc-backed pointer,
+              // is freed by kfree, and carries __alloc_size(2) so
+              // deriveAllocPointeeType reads the size from the
+              // attribute. When the source is an array, Clang's marker
+              // carries [N x T] and settagVariable walks every element.
+              bool IsKmallocAlloc = CalleeName.starts_with("kmalloc") ||
+                                    CalleeName.starts_with("__kmalloc") ||
+                                    CalleeName.starts_with("kvmalloc") ||
+                                    CalleeName == "kmemdup";
+              // FZY: Bare `__vmalloc(size, gfp)` — exact-match only. The
+              // wider vmalloc family (`__vmalloc_node_range`, `vmalloc*`,
+              // `vzalloc*`, `vmalloc_user`, …) is currently excluded.
+              // `__vmalloc` carries `__alloc_size(1)`, so
+              // deriveAllocPointeeType picks the size up via the AllocSize
+              // attribute path; FallbackIdx=0 is the defensive backstop.
+              bool IsVmallocAlloc = CalleeName == "__vmalloc";
+              // krealloc(p, new_size, flags) and
+              // kvrealloc(p, oldsize, newsize, flags) both behave like
+              // userspace realloc — they may move memory and implicitly
+              // free the old buffer. Treated as alloc + dealloc.
+              bool IsKreallocLike = CalleeName.starts_with("krealloc") ||
+                                    CalleeName.starts_with("kvrealloc");
+              bool IsSlabFree = CalleeName.starts_with("kmem_cache_free");
+              bool IsSdpCacheFree = CalleeName == "sdp_cache_free";
+              bool IsKmallocFree = CalleeName == "kfree" ||
+                                   CalleeName == "kfree_sensitive" ||
+                                   CalleeName == "kvfree";
+              // FZY: vfree releases a __vmalloc-backed buffer. Distinct from
+              // IsKmallocFree because the FAM-on-dealloc clear (which uses
+              // ksize()) does not work on vmalloc pointers — see AllowFam
+              // in makeDeallocSite.
+              bool IsVmallocFree = CalleeName == "vfree";
+              // Dynamic per-CPU allocation. The kernel macros alloc_percpu /
+              // alloc_percpu_gfp lower to __alloc_percpu / __alloc_percpu_gfp;
+              // __alloc_reserved_percpu is the early-boot reserved-chunk
+              // variant. All three return a percpu *offset* pointer and carry
+              // __alloc_size(1). free_percpu releases it. These need a
+              // per-CPU settag loop (emitHeapPercpuSettagLoop), not a plain
+              // settagVariable on the offset pointer.
+              bool IsPercpuAlloc = CalleeName == "__alloc_percpu" ||
+                                   CalleeName == "__alloc_percpu_gfp" ||
+                                   CalleeName == "__alloc_reserved_percpu";
+              bool IsPercpuFree = CalleeName == "free_percpu";
+              // FZY: kfree_rcu(ptr, rcu_head) expands to
+              //   kvfree_call_rcu(&ptr->rcu_head, (void *)ptr);
+              // — the actual kfree happens in another TU (rcu/tree.c) from
+              // an RCU callback with only a void* argument, so the dealloc
+              // detector never sees the typed pointer. Recognize the
+              // kvfree_call_rcu call site here and recover the type from
+              // its 2nd argument (the (void *)ptr cast carries Clang's
+              // sdp.alloc.type marker under -fsdp-fp). set_tag0 is emitted
+              // synchronously at the call (before the grace period) — safe
+              // because RCU readers go through tagged-typed accesses that
+              // only validate STag/TTag of the bits read, and a 1→0 STag
+              // transition does not corrupt the value bits.
+              bool IsRcuFree = CalleeName == "kvfree_call_rcu";
+              // FZY: sdp_kfree_array(ptr, count) — count-carrying free for an
+              // array of `count` sensitive structs. kfree carries no count,
+              // so the heap pass can only clear element [0] of an array and
+              // elements [1..count-1] leak STag=1 into the slab pool. The
+              // explicit count makes the dealloc walk EXACT — symmetric with
+              // the alloc, which already settags every element of the
+              // `[N x T]` marker. Out-of-line in mm/slab_common.c so the
+              // call (and its count argument) survives to this backend pass.
+              bool IsSdpArrayFree = CalleeName == "sdp_kfree_array";
+
+              if (IsSlabAlloc || IsSdpCacheAlloc || IsKmallocAlloc ||
+                  IsVmallocAlloc || IsKreallocLike) {
+                std::optional<unsigned> FallbackIdx;
+                // Order matters: longer prefixes must be checked first so
+                // kmalloc_node_trace / kmalloc_large_node don't get matched
+                // by their shorter cousins.
+                if (CalleeName.starts_with("kmalloc_node_trace"))
+                  FallbackIdx = 3; // (s, gfp, node, size)
+                else if (CalleeName.starts_with("kmalloc_trace"))
+                  FallbackIdx = 2; // (s, flags, size)
+                else if (CalleeName.starts_with("kmalloc_large_node") ||
+                         CalleeName.starts_with("kmalloc_large") ||
+                         CalleeName.starts_with("kvmalloc_node"))
+                  FallbackIdx = 0; // (size, ...)
+                else if (CalleeName.starts_with("__kmalloc"))
+                  FallbackIdx = 0;
+                else if (CalleeName == "kmemdup")
+                  FallbackIdx = 1; // kmemdup(src, len, gfp) — defensive
+                                   // backstop; __alloc_size(2) is the
+                                   // primary path.
+                else if (CalleeName == "krealloc")
+                  FallbackIdx = 1;
+                else if (CalleeName == "kvrealloc")
+                  FallbackIdx = 2; // newsize
+                else if (IsVmallocAlloc)
+                  FallbackIdx = 0; // __vmalloc(size, gfp)
+                if (Type *PointeeType =
+                        deriveAllocPointeeType(CallI, M, FallbackIdx)) {
+                  llvm::errs() << "Kernel heap alloc (" << CalleeName
+                              << "): " << *PointeeType << ", Loc: ";
+                  CallI->getDebugLoc().print(llvm::errs());
+                  llvm::errs() << "\n";
+
+                  HeapSites.push_back(
+                      makeAllocSite(CallI, PointeeType, M, FallbackIdx));
+                }
+
+                // Same tag-leakage rationale as userspace realloc (see
+                // the long comment further down): clear the old pointer
+                // before the call so a moved allocation goes back to
+                // the slab pool untagged. Failure-case edge accepted.
+                if (IsKreallocLike) {
+                  if (auto Info = deriveDeallocPointeeType(
+                          CallI->getArgOperand(0))) {
+                    llvm::errs() << "Kernel heap realloc dealloc ("
+                                << CalleeName
+                                << "): " << *Info->PointeeType
+                                << ", Loc: ";
+                    CallI->getDebugLoc().print(llvm::errs());
+                    llvm::errs() << "\n";
+
+                    HeapSites.push_back(makeDeallocSite(
+                        CallI, Info->BaseAddr, Info->PointeeType, M));
+                  }
+                }
+              } else if (IsSlabFree || IsSdpCacheFree || IsKmallocFree ||
+                         IsVmallocFree || IsRcuFree) {
+                // Argument index of the typed pointer:
+                //   kmem_cache_free(s, ptr)        → arg 1
+                //   sdp_cache_free(cache, ptr)     → arg 1
+                //   kvfree_call_rcu(&rhp, ptr)     → arg 1
+                //   kfree / kvfree / vfree (ptr)   → arg 0
+                unsigned PtrIdx =
+                    (IsSlabFree || IsSdpCacheFree || IsRcuFree) ? 1 : 0;
+                Value *FreeArg = CallI->getArgOperand(PtrIdx);
+                if (auto Info = deriveDeallocPointeeType(FreeArg)) {
+                  llvm::errs() << "Kernel heap free (" << CalleeName
+                              << "): " << *Info->PointeeType << ", Loc: ";
+                  CallI->getDebugLoc().print(llvm::errs());
+                  llvm::errs() << "\n";
+
+                  // vfree freed memory cannot be sized via ksize() — skip
+                  // FAM-on-dealloc for it. sdp_cache_free is gen_pool-backed
+                  // (mm/sdp_cache.c), not slab — ksize() doesn't work there
+                  // either, so same exclusion. See AllowFam in makeDeallocSite.
+                  HeapSites.push_back(makeDeallocSite(
+                      CallI, Info->BaseAddr, Info->PointeeType, M,
+                      /*AllowFam=*/!(IsVmallocFree || IsSdpCacheFree)));
+                }
+              } else if (IsPercpuAlloc) {
+                // __alloc_percpu carries __alloc_size(1); deriveAllocPointeeType
+                // reads that attribute, so the FallbackIdx hint is only a
+                // backstop. The returned pointee is the per-CPU struct; emit a
+                // per-CPU settag loop (not a plain settagVariable) because the
+                // call returns an offset pointer, not a real address.
+                if (Type *PointeeType =
+                        deriveAllocPointeeType(CallI, M, /*FallbackIdx=*/0)) {
+                  llvm::errs() << "Kernel percpu alloc (" << CalleeName
+                              << "): " << *PointeeType << ", Loc: ";
+                  CallI->getDebugLoc().print(llvm::errs());
+                  llvm::errs() << "\n";
+
+                  HeapSite Site;
+                  Site.InsertBefore = CallI->getNextNode();
+                  Site.BaseAddr = CallI;
+                  Site.PointeeType = PointeeType;
+                  Site.IsDealloc = false;
+                  Site.IsPercpu = true;
+                  HeapSites.push_back(Site);
+                }
+              } else if (IsPercpuFree) {
+                if (auto Info =
+                        deriveDeallocPointeeType(CallI->getArgOperand(0))) {
+                  llvm::errs() << "Kernel percpu free (" << CalleeName
+                              << "): " << *Info->PointeeType << ", Loc: ";
+                  CallI->getDebugLoc().print(llvm::errs());
+                  llvm::errs() << "\n";
+
+                  HeapSite Site;
+                  Site.InsertBefore = CallI;
+                  Site.BaseAddr = Info->BaseAddr;
+                  Site.PointeeType = Info->PointeeType;
+                  Site.IsDealloc = true;
+                  Site.IsPercpu = true;
+                  HeapSites.push_back(Site);
+                }
+              } else if (IsSdpArrayFree) {
+                // sdp_kfree_array(ptr, count): clear set_tag0 on exactly
+                // `count` elements. The typed pointer is arg 0 (the
+                // T*->const void* cast carries Clang's sdp.alloc.type
+                // marker); `count` is arg 1, an element count.
+                if (CallI->arg_size() >= 2) {
+                  Value *Count = CallI->getArgOperand(1);
+                  if (auto Info = deriveDeallocPointeeType(
+                          CallI->getArgOperand(0))) {
+                    if (Count->getType()->isIntegerTy()) {
+                      // The kfree-site cast yields the singular element type
+                      // T; peel a stray array wrapper defensively.
+                      Type *EltTy = Info->PointeeType;
+                      if (auto *ATy = dyn_cast<ArrayType>(EltTy))
+                        EltTy = ATy->getElementType();
+                      llvm::errs() << "Kernel heap array free (sdp_kfree_array): "
+                                  << *EltTy << ", Loc: ";
+                      CallI->getDebugLoc().print(llvm::errs());
+                      llvm::errs() << "\n";
+
+                      HeapSite Site;
+                      Site.InsertBefore = CallI;
+                      Site.BaseAddr = Info->BaseAddr;
+                      Site.PointeeType = EltTy;
+                      Site.IsDealloc = true;
+                      Site.ExplicitArrayCount = Count;
+                      HeapSites.push_back(Site);
+                    }
+                  }
+                }
+              }
+            } else { // Security evaluation for the kernel
+              // FZY: Slab caches whose objects carry __tagone fields; their
+              // wrappers are inlined away, so match on the cachep global.
+              static const struct {
+                const char *CachepName;
+                const char *StructName;
+                const char *AllocName;
+                const char *FreeName;
+              } SensitiveCaches[] = {
+                  {"task_struct_cachep", "struct.task_struct",
+                   "alloc_task_struct_node", "free_task_struct"},
+                  {"mm_cachep", "struct.mm_struct", "allocate_mm", "free_mm"},
+              };
+
+              bool IsCacheAlloc =
+                  CalleeName == "kmem_cache_alloc" ||
+                  CalleeName == "kmem_cache_alloc_node";
+              bool IsCacheFree = CalleeName == "kmem_cache_free";
+
+              if (IsCacheAlloc || IsCacheFree) {
+                Value *CachepArg = CallI->getArgOperand(0);
+                auto *LI = dyn_cast<LoadInst>(CachepArg);
+                if (!LI)
+                  continue;
+                auto *GV = dyn_cast<GlobalVariable>(
+                    LI->getPointerOperand()->stripPointerCasts());
+                if (!GV)
+                  continue;
+
+                StringRef StructName, WrapperName;
+                for (const auto &C : SensitiveCaches) {
+                  if (GV->getName() == C.CachepName) {
+                    StructName = C.StructName;
+                    WrapperName = IsCacheFree ? C.FreeName : C.AllocName;
+                    break;
+                  }
+                }
+                if (StructName.empty())
+                  continue;
+
+                StructType *PointeeType =
+                    StructType::getTypeByName(M->getContext(), StructName);
+                if (!PointeeType) {
+                  llvm::errs() << "Warning: " << StructName
+                               << " not found in module\n";
+                  continue;
+                }
+
+                // kmem_cache_free(s, ptr): freed pointer is arg 1.
+                // kmem_cache_alloc*: BaseAddr is the call result itself.
+                Value *BaseAddr = IsCacheFree
+                                      ? CallI->getArgOperand(1)
+                                      : cast<Value>(CallI);
+
+                llvm::errs() << WrapperName << " instrumentation ("
+                             << CalleeName << "), Loc: ";
+                CallI->getDebugLoc().print(llvm::errs());
+                llvm::errs() << "\n";
+
+                Instruction *InsertBefore =
+                    IsCacheFree ? cast<Instruction>(CallI)
+                                : CallI->getNextNode();
+
+                HeapSites.push_back(
+                    {InsertBefore, BaseAddr, PointeeType, IsCacheFree});
+                continue;
+              }
+
+              // FZY: SDP randomized caches (mm/sdp_cache.c) bypass the cachep
+              // table above; key off Clang's llvm.sdp.alloc.type marker instead.
+              bool IsSdpCacheAlloc = CalleeName == "sdp_cache_alloc";
+              bool IsSdpCacheFree = CalleeName == "sdp_cache_free";
+
+              if (IsSdpCacheAlloc) {
+                // No __alloc_size: the marker names the allocation type.
+                if (Type *PointeeType =
+                        deriveAllocPointeeType(CallI, M, std::nullopt)) {
+                  llvm::errs() << "sdp_cache_alloc instrumentation, Loc: ";
+                  CallI->getDebugLoc().print(llvm::errs());
+                  llvm::errs() << "\n";
+                  HeapSites.push_back(
+                      makeAllocSite(CallI, PointeeType, M, std::nullopt));
+                }
+                continue;
+              }
+
+              if (IsSdpCacheFree) {
+                // Typed pointer is arg 1. AllowFam=false: the FAM clear uses
+                // ksize(), which is slab-only; sdp_cache is gen_pool-backed.
+                if (auto Info =
+                        deriveDeallocPointeeType(CallI->getArgOperand(1))) {
+                  llvm::errs() << "sdp_cache_free instrumentation, Loc: ";
+                  CallI->getDebugLoc().print(llvm::errs());
+                  llvm::errs() << "\n";
+                  HeapSites.push_back(
+                      makeDeallocSite(CallI, Info->BaseAddr, Info->PointeeType,
+                                      M, /*AllowFam=*/false));
+                }
+                continue;
+              }
+            }
+          } else { // Performance evaluation for user space
+            // glibc carries __alloc_size on every common allocator (see
+            // malloc.h):
+            //   malloc(size)            -> allocsize(0)
+            //   calloc(nmemb, size)     -> allocsize(0, 1)   (nmemb * size)
+            //   realloc(ptr, size)      -> allocsize(1)
+            //   reallocarray(ptr, n, s) -> allocsize(1, 2)   (n * s)
+            //   aligned_alloc(a, size)  -> allocsize(1)
+            //   memalign(a, size)       -> allocsize(1)
+            //   valloc(size)            -> allocsize(0)
+            //   pvalloc(size)           -> allocsize(0)
+            // deriveAllocPointeeType consumes those automatically.
+            // FallbackIdx is a backstop for builds whose libc headers lack
+            // the attribute (e.g. user-built libcs / wrappers); calloc and
+            // reallocarray have no single-size fallback. posix_memalign
+            // (returns int, writes the allocation via *memptr) would need
+            // a *memptr cast-site marker rather than the call return — not
+            // wired up here.
+            bool IsUserspaceAlloc =
+                CalleeName == "malloc" || CalleeName == "calloc" ||
+                CalleeName == "realloc" || CalleeName == "reallocarray" ||
+                CalleeName == "aligned_alloc" || CalleeName == "memalign" ||
+                CalleeName == "valloc" || CalleeName == "pvalloc";
+            // realloc / reallocarray may move the old buffer and implicitly
+            // free it. Treat as alloc + dealloc, mirroring kernel krealloc.
+            bool IsReallocLike = CalleeName == "realloc" ||
+                                 CalleeName == "reallocarray";
+            bool IsUserspaceFree = CalleeName == "free";
+
+            if (IsUserspaceAlloc) {
+              std::optional<unsigned> FallbackIdx;
+              if (CalleeName == "malloc" || CalleeName == "valloc" ||
+                  CalleeName == "pvalloc")
+                FallbackIdx = 0;
+              else if (CalleeName == "realloc" ||
+                       CalleeName == "aligned_alloc" ||
+                       CalleeName == "memalign")
+                FallbackIdx = 1;
+              // calloc / reallocarray: nmemb * size, no single-size
+              // fallback — rely on the allocsize attribute or the
+              // largest-pointee fallback inside deriveAllocPointeeType.
+
+              if (Type *PointeeType =
+                      deriveAllocPointeeType(CallI, M, FallbackIdx)) {
+                llvm::errs() << "Userspace heap alloc (" << CalleeName
+                            << "): " << *PointeeType << ", Loc: ";
+                CallI->getDebugLoc().print(llvm::errs());
+                llvm::errs() << "\n";
+
+                // makeAllocSite picks up a sensitive flexible-array-member
+                // tail when the allocator's total-size argument is
+                // recoverable; the emission step then settags every FAM
+                // element with a runtime loop, symmetric with kernel
+                // kmalloc-of-struct-with-FAM.
+                HeapSites.push_back(
+                    makeAllocSite(CallI, PointeeType, M, FallbackIdx));
+              }
+
+              // realloc-like(old, ...) implicitly frees the old buffer
+              // when it has to move. Without clearing the old pointer's
+              // tags, they leak with the freed memory back into the
+              // allocator pool — a later non-sensitive allocation reusing
+              // that memory would then trigger a tag mismatch on
+              // legitimate access. Clear before the call so the freed
+              // bytes go back untagged. Trade-off: if realloc fails, the
+              // original buffer is still valid; conforming code that
+              // retries on the old pointer would see cleared tags.
+              // Real-world code overwhelmingly aborts on realloc failure,
+              // so we accept this edge rather than gate on a runtime
+              // success check.
+              if (IsReallocLike) {
+                if (auto Info = deriveDeallocPointeeType(
+                        CallI->getArgOperand(0))) {
+                  llvm::errs() << "Userspace realloc dealloc ("
+                              << CalleeName
+                              << "): " << *Info->PointeeType << ", Loc: ";
+                  CallI->getDebugLoc().print(llvm::errs());
+                  llvm::errs() << "\n";
+
+                  // IsUserspace=true routes the FAM-dealloc sizer to
+                  // malloc_usable_size() instead of ksize(). AllowFam stays
+                  // on — glibc's malloc_usable_size is defined for every
+                  // malloc-family pointer (no vmalloc-style exclusion).
+                  HeapSites.push_back(makeDeallocSite(
+                      CallI, Info->BaseAddr, Info->PointeeType, M,
+                      /*AllowFam=*/true, /*IsUserspace=*/true));
+                }
+              }
+            } else if (IsUserspaceFree) {
+              if (auto Info = deriveDeallocPointeeType(
+                      CallI->getArgOperand(0))) {
+                llvm::errs() << "Userspace heap free: "
+                            << *Info->PointeeType << ", Loc: ";
+                CallI->getDebugLoc().print(llvm::errs());
+                llvm::errs() << "\n";
+
+                // makeDeallocSite with IsUserspace=true: FAM-on-dealloc
+                // sizer is malloc_usable_size(). Without this, an array of
+                // sensitive structs (or a struct-with-FAM) freed via plain
+                // free() would leave STag=1 elements [1..N-1] in the
+                // freed block, identical to the kernel-side leak class
+                // that motivated the FAM-on-dealloc clear.
+                HeapSites.push_back(makeDeallocSite(
+                    CallI, Info->BaseAddr, Info->PointeeType, M,
+                    /*AllowFam=*/true, /*IsUserspace=*/true));
+              }
+            }
+          }
+        }
+      }
+    }
+
+    // Emit the NULL-guarded settag for each collected site
+    if (!HeapSites.empty()) {
+      MDBuilder MDB(F.getContext());
+      MDNode *Weights = MDB.createBranchWeights(/*TrueWeight=*/1000000,
+                                                /*FalseWeight=*/1);
+      for (auto &S : HeapSites) {
+        IRBuilder<> Builder(S.InsertBefore);
+        Value *NotNull = Builder.CreateIsNotNull(S.BaseAddr, "addr.notnull");
+        Instruction *ThenTerm = SplitBlockAndInsertIfThen(
+            NotNull, S.InsertBefore, /*Unreachable=*/false, Weights);
+        IRBuilder<> ThenBuilder(ThenTerm);
+        bool Settag = S.IsDealloc ? DeallocFuncSettag : AllocFuncSettag;
+          AllocationType AT = S.IsDealloc ? AllocationType::HeapSettagDealloc
+                                          : AllocationType::HeapSettagAlloc;
+          // FZY: Per-CPU dynamic allocation — settagVariable on the bare
+          // offset pointer would stamp only the percpu template. Emit a
+          // per-CPU loop that stamps each CPU's instance at its real address
+          // (BaseAddr + __per_cpu_offset[cpu]). No FAM handling for percpu.
+          if (S.IsPercpu) {
+            emitHeapPercpuSettagLoop(M, F, ThenTerm, S.BaseAddr, S.PointeeType,
+                                     Settag, PerfInstFlag, AT);
+            Modified = true;
+            continue;
+          }
+          // FZY: sdp_kfree_array(ptr, count) — clear set_tag0 on exactly
+          // `count` elements of PointeeType from offset 0. No straight-line
+          // settagVariable (the loop's iteration [i] covers element [i]);
+          // the count is the explicit call argument, so the walk is exact —
+          // symmetric with the alloc's settagVariable walk of the `[N x T]`
+          // marker, and never over-walks slab-bucket slack.
+          if (S.ExplicitArrayCount) {
+            emitFamSettagLoop(M, F, ThenTerm, S.BaseAddr, /*FamByteOffset=*/0,
+                              S.PointeeType, S.ExplicitArrayCount, Settag,
+                              PerfInstFlag, AT);
+            Modified = true;
+            continue;
+          }
+          settagVariable(*M, ThenBuilder, S.BaseAddr, S.PointeeType, 0, Settag,
+                         PerfInstFlag, AT);
+          // FZY: Settag/clear the trailing flexible-array-member with a
+          // runtime loop — settagVariable's straight-line walk above only
+          // covers the struct's declared (non-FAM) fields. The FAM element
+          // count is (size - FamOffset) / sizeof(elt): an alloc site has the
+          // allocator's size argument in FamSizeVal; a dealloc site has no
+          // size argument (kfree / realloc-free), so query the live
+          // allocation with ksize() before it is freed. The dealloc clear
+          // keeps STag symmetric with the alloc settag — without it the
+          // FAM's STag=1 leaks into the freed slab block.
+          if (S.FamEltTy) {
+            Value *SizeVal = S.FamSizeVal;
+            if (!SizeVal) {
+              // Dealloc site: the sizer returns the actual (bucket-rounded)
+              // allocation size for the live pointer. Kernel sites use
+              // ksize(); userspace sites use glibc's malloc_usable_size().
+              // Both have the same signature and same rounding semantics.
+              // Rounding up can over-count the FAM extent by up to one
+              // bucket, but every byte in [ptr, ptr+sizer(ptr)) is part of
+              // this freed allocation, so clearing past the logical FAM
+              // tail is safe — it just guarantees the whole reused block
+              // starts STag=0.
+              const char *SizeFnName =
+                  S.IsUserspace ? "malloc_usable_size" : "ksize";
+              FunctionCallee SizeFn = M->getOrInsertFunction(
+                  SizeFnName, Type::getInt64Ty(F.getContext()),
+                  ThenBuilder.getPtrTy());
+              // Keep the kernel SSA value name unchanged ("fam.ksize") so
+              // kernel IR/MIR diffs against pre-change builds stay clean.
+              const char *SizeName =
+                  S.IsUserspace ? "fam.musize" : "fam.ksize";
+              SizeVal =
+                  ThenBuilder.CreateCall(SizeFn, {S.BaseAddr}, SizeName);
+            }
+            Type *SzTy = SizeVal->getType();
+            uint64_t EltSz = M->getDataLayout().getTypeAllocSize(S.FamEltTy);
+            // Count = (size - FamOffset) / sizeof(elt), unsigned. udiv
+            // truncation only ever undershoots, so a non-exact size never
+            // overshoots the allocation.
+            Value *FamBytes = ThenBuilder.CreateSub(
+                SizeVal, ConstantInt::get(SzTy, S.FamOffset), "fam.bytes");
+            Value *Count = ThenBuilder.CreateUDiv(
+                FamBytes, ConstantInt::get(SzTy, EltSz), "fam.count");
+            emitFamSettagLoop(M, F, ThenTerm, S.BaseAddr, S.FamOffset,
+                              S.FamEltTy, Count, Settag, PerfInstFlag, AT);
+          }
+        Modified = true;
+      }
+    }
+
+    // FZY: Strip llvm.sdp.alloc.type markers before ISel sees them. The
+    // marker is a pointer passthrough whose only purpose was to carry the
+    // source-language pointee type to the heap settag detector above
+    // (`deriveAllocPointeeType`). It has no SelectionDAG pattern, so
+    // leaving it in the IR would crash ISel with "Cannot select intrinsic
+    // %llvm.sdp.alloc.type". RAUW with the first argument (the original
+    // pointer) and erase. Markers exist in every function that emitted a
+    // void*->sensitive_struct* cast — including ones with no allocator
+    // call paired with them — so we sweep unconditionally.
+    SmallVector<IntrinsicInst *, 8> Markers;
+    for (BasicBlock &BB : F)
+      for (Instruction &I : BB)
+        if (auto *MI = dyn_cast<IntrinsicInst>(&I))
+          if (MI->getIntrinsicID() == Intrinsic::sdp_alloc_type)
+            Markers.push_back(MI);
+    for (IntrinsicInst *MI : Markers) {
+      MI->replaceAllUsesWith(MI->getArgOperand(0));
+      MI->eraseFromParent();
+      Modified = true;
+    }
+
+    return Modified;
+  }
+};
