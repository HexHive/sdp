+#ifndef LLVM_RISCV_SETTAG_UTILS_H
+#define LLVM_RISCV_SETTAG_UTILS_H
+
+#include "llvm/IR/IRBuilder.h"
+#include "llvm/IR/GlobalValue.h"
+#include "llvm/ADT/StringRef.h"
+#include "RISCVTagonePointerTracker.h"
+
+using namespace llvm;
+
+// FZY: Define constants for allocation and deallocation functions
+const bool AllocFuncSettag = true;
+const bool DeallocFuncSettag = false;
+
+// FZY: Check if a global variable is in an init section or a section that the kernel linker script discards
+inline bool isInDiscardedKernelSection(const GlobalValue &GV) {
+  if (!GV.hasSection())
+    return false;
+  StringRef S = GV.getSection();
+  return S.starts_with(".exit.") ||
+         S.starts_with(".exitcall.") ||
+         S.starts_with(".init.") ||
+         S.starts_with(".initcall") ||
+         S.starts_with(".discard");
+}
+
+// FZY: Type tag hash for TTags
+long getHash(Type *Ty);
+
+// FZY: Declare settag utility functions
+void settagOnePointer(Module &M, IRBuilder<> &Builder, Value *BaseAddr, Type *ValType, uint64_t Offset, bool Settag);
+void settagEstimateOnePointer(Module &M, IRBuilder<> &Builder, Value *BaseAddr, Type *ValType, uint64_t Offset, AllocationType SettagLoc);
+void settagVariable(Module &M, IRBuilder<> &Builder, Value *BaseAddr, Type* ValType, uint64_t Offset, bool Settag, bool PerfInstFlag, AllocationType SettagLoc);
+
+#endif // LLVM_RISCV_SETTAG_UTILS_H
