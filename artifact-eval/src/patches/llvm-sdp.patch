+// FZY: Auto-tagzero declaration-site automation for tagone pointer fields
+// buried in *heterogeneous* unions.
+// A homogeneous all-function-pointer union (LSM hooks:
+// `union security_list_options`) is statically initialized per-variant;
+// clang emits a per-entry-typed global representation, the global settag
+// pass stamps each `.hook` slot with that variant's specific TTag, and
+// tagged accesses match — leave it alone.
+//
+// A heterogeneous union (any non-FP variant exists, e.g. `struct sk_buff`'s
+// `union { struct {ulong _skb_refdst; FP destructor}; list_head; ulong }`)
+// can never be reliably settagged: a plain store through a non-FP variant
+// (e.g. `tcp_tsorted_anchor.pprev`) clobbers the top-16 TTag bits regardless
+// of storage class, so the FP variant's slot is unsafe to tag anywhere.
+// Rewrite the FP field's type to its tagzero variant so every access lowers
+// to plain ld/sd — matching the (uniformly absent) settag on both sides.
+//
+// The walk only descends into *anonymous* aggregate members (their fields
+// physically share the enclosing union's storage). It stops at named-type
+// members (e.g. `struct callback_head` embedded in `struct file`'s union as
+// `f_rcuhead`): mutating those would globally affect their other uses.
+
+// Detect an explicit `__tagone` annotation on the field's type — mirrors
+// the conflict check in SemaType.cpp::handleTagzeroAttr. Auto-propagated
+// sensitivity from -fsdp-fp/-fsdp-fpifp does NOT appear as an
+// AttributedType layer, which is exactly the case we want to override.
+static bool sdpFieldHasExplicitTagone(QualType T) {
+  for (const Type *Ty = T.getTypePtr();;) {
+    const auto *AT = dyn_cast<AttributedType>(Ty);
+    if (!AT)
+      return false;
+    if (AT->getAttrKind() == attr::Tagone)
+      return true;
+    Ty = AT->getEquivalentType().getTypePtr();
+  }
+}
+
+static void sdpAutoTagzeroInUnionStorage(ASTContext &Context, RecordDecl *RD) {
+  for (FieldDecl *F : RD->fields()) {
+    QualType FT = F->getType();
+
+    // Recurse only through anonymous aggregate members — their fields share
+    // the enclosing union's storage and are physically union-buried. Named
+    // record members stop the walk.
+    if (const auto *RT = FT->getAs<RecordType>()) {
+      if (RecordDecl *Inner = RT->getDecl())
+        if (Inner->isAnonymousStructOrUnion())
+          sdpAutoTagzeroInUnionStorage(Context, Inner);
+      continue;
+    }
+
+    if (!FT->isSensitivePointerType(Context))
+      continue;
+    const auto *PT = FT->getAs<PointerType>();
+    if (!PT || PT->getTagzeroAttr())
+      continue;
+    if (sdpFieldHasExplicitTagone(FT))
+      continue;
+
+    QualType NewType = Context.getInsensitivePointerType(PT->getPointeeType());
+    NewType = Context.getQualifiedType(NewType, FT.getQualifiers());
+    F->setType(NewType);
+  }
+}
