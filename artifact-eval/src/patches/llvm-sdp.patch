+// FZY: SDP user-copy bookend attribute handler. Shared between
+// sdp_userbuf_dest and sdp_userbuf_src — both take (BufIdx, SizeIdx)
+// as 1-based parameter positions. BufIdx must refer to a pointer
+// parameter; SizeIdx to an integer parameter.
+template <typename AttrTy>
+static void handleSDPUserbufAttrImpl(Sema &S, Decl *D, const ParsedAttr &AL) {
+  if (!AL.checkExactlyNumArgs(S, 2))
+    return;
+  assert(isFuncOrMethodForAttrSubject(D) && hasFunctionProto(D));
+
+  int BufArgVal, SizeArgVal;
+  if (!checkPositiveIntArgument(S, AL, AL.getArgAsExpr(0), BufArgVal,
+                                /*Idx=*/1))
+    return;
+  if (!checkPositiveIntArgument(S, AL, AL.getArgAsExpr(1), SizeArgVal,
+                                /*Idx=*/2))
+    return;
+
+  ParamIdx BufIdx(BufArgVal, D);
+  ParamIdx SizeIdx(SizeArgVal, D);
+
+  // Validate buffer param is a pointer type.
+  QualType BufTy = getFunctionOrMethodParamType(D, BufIdx.getASTIndex());
+  if (!BufTy->isPointerType()) {
+    S.Diag(AL.getArgAsExpr(0)->getBeginLoc(),
+           diag::err_attribute_pointers_only)
+        << AL << 0;
+    return;
+  }
+  // Validate size param is an integer type.
+  if (!checkParamIsIntegerType(S, D, AL, /*AttrArgNo=*/1))
+    return;
+
+  D->addAttr(::new (S.Context) AttrTy(S.Context, AL, BufIdx, SizeIdx));
+}
