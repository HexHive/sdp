+// FZY: Add isSensitive function for PointerType to determine the sensitivity
+uint8_t PointerType::isSensitive(const ASTContext &Context) const {
+
+  // FZY: __tagzero forcibly suppresses sensitivity regardless of pointee type
+  if (getTagzeroAttr())
+    return 0;
+
+  // Annotated sensitive pointers
+  if (getSensitiveAttr())
+    return 2;
+
+  bool FPIFPFlag = Context.getLangOpts().SDPFPIFPProtect;
+  bool FPFlag = Context.getLangOpts().SDPFPProtect;
+
+  if ((FPIFPFlag || FPFlag) && isFunctionPointerType())
+    return 2;
+
+  // -fsdp-fpifp and the no-flag (Generic) default both propagate
+  // sensitivity through pointer-to-struct fields. During the struct-dump
+  // phase, mark such fields "undetermined" so the resolver can promote
+  // them based on the pointee's resolved ss. -fsdp-fp does not propagate.
+  if (!FPFlag && Context.getLangOpts().DumpStruct &&
+      PointeeType->isStructureType())
+    return 1;
+
+  return 0;
+}
+
+// FZY: Define isSensitive() in RecordType. Return true if it contains any sensitive pointer
+uint8_t RecordType::isSensitive(const ASTContext &Context) const {
+  if (!isStructureType())
+    return 0;
+
+  if (Context.getLangOpts().DumpStruct || Context.getLangOpts().SDPFPProtect) {
+    uint8_t Ret = 0;
+    for (FieldDecl *FD : getDecl()->fields()) {
+      QualType FieldTy = FD->getType();
+      const ASTContext &Context = FD->getASTContext();
+
+      uint8_t FieldRet = FieldTy->isSensitiveType(Context);
+      if (FieldRet == 2) {
+        Ret = 2;
+        break;
+      }
+      if (FieldRet == 1) {
+        Ret = 1;
+      }
+    }
+    return Ret;
+  }
+
+  // -fsdp-fpifp and generic: Answered via the JSON-resolved struct list
+  if (Context.getLangOpts().SDPFPIFPProtect)
+    return StructTypeTracker::getInstance(/*dumpEnabled=*/false, StructTypeTracker::FPIFP)
+      .getStructSensitivity(getDecl());
+  
+  return StructTypeTracker::getInstance(/*dumpEnabled=*/false, StructTypeTracker::Generic)
+    .getStructSensitivity(getDecl());
+}
