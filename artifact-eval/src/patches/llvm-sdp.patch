+//
+// Clang plugin instrumenting settag instructions for heap sensitive pointers.
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/AST.h"
+#include "clang/AST/ASTConsumer.h"
+#include "clang/AST/RecursiveASTVisitor.h"
+#include "clang/Frontend/CompilerInstance.h"
+#include "clang/Frontend/FrontendPluginRegistry.h"
+#include "clang/Rewrite/Core/Rewriter.h"
+
+#include <unordered_map>
+
+using namespace clang;
+
+struct AllocInfo {
+  Expr *SizeExpr;
+  SourceLocation CallLocation;
+};
+
+class CountCollector : public RecursiveASTVisitor<CountCollector> {
+private:
+  ASTContext *Context;
+  std::unordered_map<const Expr *, AllocInfo> &AllocCountMap;
+
+public:
+  explicit CountCollector(
+      ASTContext *Context, Rewriter &Rewriter,
+      std::unordered_map<const Expr *, AllocInfo> &AllocCountMap)
+      : Context(Context), AllocCountMap(AllocCountMap) {}
+
+  bool VisitCallExpr(CallExpr *Call) {
+    if (const FunctionDecl *FD = Call->getDirectCallee()) {
+
+      QualType RetType = FD->getReturnType();
+      if (RetType->isEmitSettagPointerType()) {
+        if (Call->getNumArgs() > 1) {
+          AllocInfo Info;
+          Info.SizeExpr = Call->getArg(1);
+          Info.CallLocation = Call->getBeginLoc();
+          AllocCountMap[Call] = Info;
+        }
+      }
+    }
+    return true;
+  }
+};
+
+class BitcastInstrumenter : public RecursiveASTVisitor<BitcastInstrumenter> {
+private:
+  ASTContext *Context;
+  Rewriter &TheRewriter;
+  std::unordered_map<const Expr *, AllocInfo> &AllocCountMap;
+
+public:
+  explicit BitcastInstrumenter(
+      ASTContext *Context, Rewriter &TheRewriter,
+      std::unordered_map<const Expr *, AllocInfo> &AllocCountMap)
+      : Context(Context), TheRewriter(TheRewriter),
+        AllocCountMap(AllocCountMap) {}
+
+  bool VisitCastExpr(CastExpr *Cast) {
+    if (Cast->getCastKind() == CK_BitCast) {
+
+      QualType SrcType = Cast->getSubExpr()->getType();
+      QualType DstType = Cast->getType();
+      ASTContext &Context = *this->Context;
+      if (SrcType->isEmitSettagPointerType() &&
+          DstType->isSensitivePointerType(Context)) {
+
+        // Check if the pointee type contains any sensitive pointers
+        QualType PointeeType = DstType->getPointeeType();
+        if (PointeeType->isSensitivePointerType(Context)) { // FZY: TODO: Change it to check if any part of the type is sensitive
+
+          Expr *SubExpr = Cast->getSubExpr()->IgnoreParenImpCasts();
+          if (const CallExpr *AllocCall = llvm::dyn_cast<CallExpr>(SubExpr)) {
+
+            auto It = AllocCountMap.find(AllocCall);
+            if (It != AllocCountMap.end()) {
+              AllocInfo &Info = It->second;
+              SourceLocation AfterCast = Cast->getEndLoc().getLocWithOffset(1);
+              SourceRange CountRange = Info.SizeExpr->getSourceRange();
+              std::string CountText = TheRewriter.getRewrittenText(CountRange);
+
+              // address = base address + offset
+              // settag_1 type_id, address
+              std::string SettagOnePointer =  "    __asm__ __volatile__ (\n"
+                                              "      \"add a1, a0, %0\\n\"\n"
+                                              "      \"settag_1 type_id, 0(a1)\\n\"\n" // TODO: Repeat this if multiple sub-fields in the struct are sensitive, the 0 can be hardcoded according to the field offset 
+                                              "      :\n"
+                                              "      : \"r\"(offset)\n"
+                                              "      : \"a0\", \"a1\", \"memory\"\n"
+                                              "    );\n";
+              
+              // {
+              //   unsigned long offset = 0;
+              //   for (unsigned long i = 0; i < Count; i++) {
+              //     offset = i * sizeof(PointeeType);
+              //     SettagOnePointer
+              //   }
+              // }
+              std::string Instrumentation =   "\n{ // Settag for sensitive pointers on heap\n"
+                                              "  unsigned long offset = 0;\n"
+                                              "  for (unsigned long i = 0; i < " + CountText + "; i++) {\n"
+                                              "    offset = i * 8;\n" // TODO: Change this to sizeof(PointeeType)
+                                              + SettagOnePointer +
+                                              "  }\n"
+                                              "} // End of settag for sensitive pointers on heap";
+
+              bool Failed = TheRewriter.InsertTextAfterToken(AfterCast, Instrumentation);
+              if (Failed) {
+                llvm::errs()
+                    << "Failed to insert instrumentation after bitcast at "
+                    << AfterCast.printToString(TheRewriter.getSourceMgr())
+                    << "\n";
+              }
+            }
+          }
+        }
+      }
+    }
+    return true;
+  }
+};
+
+class HeapSettagInstrumentASTConsumer : public ASTConsumer {
+private:
+  ASTContext *Context;
+  Rewriter &TheRewriter;
+  std::unordered_map<const Expr *, AllocInfo> AllocCountMap;
+
+public:
+  explicit HeapSettagInstrumentASTConsumer(ASTContext *Context,
+                                           Rewriter &TheRewriter)
+      : Context(Context), TheRewriter(TheRewriter) {}
+
+  virtual void HandleTranslationUnit(ASTContext &Context) override {
+    CountCollector Collector(&Context, TheRewriter, AllocCountMap);
+    Collector.TraverseDecl(Context.getTranslationUnitDecl());
+
+    BitcastInstrumenter Instrumenter(&Context, TheRewriter, AllocCountMap);
+    Instrumenter.TraverseDecl(Context.getTranslationUnitDecl());
+  }
+};
+
+class HeapSettagInstrumentPluginAction : public PluginASTAction {
+private:
+  Rewriter TheRewriter;
+
+protected:
+  std::unique_ptr<ASTConsumer>
+  CreateASTConsumer(CompilerInstance &CI, llvm::StringRef file) override {
+    TheRewriter.setSourceMgr(CI.getSourceManager(), CI.getLangOpts());
+    return std::make_unique<HeapSettagInstrumentASTConsumer>(
+        &CI.getASTContext(), TheRewriter);
+  }
+
+  bool ParseArgs(const CompilerInstance &CI,
+                 const std::vector<std::string> &args) override {
+    return true;
+  }
+
+  void EndSourceFileAction() override { TheRewriter.overwriteChangedFiles(); }
+};
+
+static FrontendPluginRegistry::Add<HeapSettagInstrumentPluginAction>
+    X("instrument-heap-settag",
+      "instrument settag instructions for heap sensitive pointers");
