+// FZY: RISCVTagonePointerCollect pass to track and dump pointer types under
+// -fcount-allptrtype and -fcount-sptrtype.
+
+#include "RISCV.h"
+#include "RISCVTagonePointerTracker.h"
+#include "RISCVInstrInfo.h"
+#include "llvm/IR/Function.h"
+#include "llvm/IR/Instructions.h"
+#include "llvm/IR/Module.h"
+#include "llvm/Support/raw_ostream.h"
+
+using namespace llvm;
+#define DEBUG_TYPE "riscv-tagone-pointer-collection"
+#define RISCV_TAGONE_POINTER_COLLECTION_NAME                                   \
+  "RISC-V tagone pointer collection pass"
+
+namespace {
+
+class RISCVTagonePointerCollection : public FunctionPass {
+public:
+  static char ID;
+  RISCVTagonePointerCollection() : FunctionPass(ID) {}
+
+  bool runOnFunction(Function &F) override {
+    Module *M = F.getParent();
+    bool CountAll = M->getModuleFlag("fcount_allptrtype") != nullptr;
+    bool CountSensitive = M->getModuleFlag("fcount_sptrtype") != nullptr;
+
+    if (!CountAll && !CountSensitive)
+      return false;
+
+    TagonePointerTracker &Tracker = TagonePointerTracker::getInstance();
+
+    for (auto &BB : F) {
+      for (auto &I : BB) {
+        Type *PointeeType = nullptr;
+        Value *PtrOperand = nullptr;
+        bool IsTagone = false;
+
+        if (auto *LI = dyn_cast<LoadInst>(&I)) {
+          PointeeType = LI->getPointeeType();
+          PtrOperand = LI->getPointerOperand();
+          IsTagone = LI->isTagone();
+        } else if (auto *SI = dyn_cast<StoreInst>(&I)) {
+          PointeeType = SI->getPointeeType();
+          PtrOperand = SI->getPointerOperand();
+          IsTagone = SI->isTagone();
+        } else {
+          continue;
+        }
+
+        if (!PointeeType)
+          continue;
+
+        AllocationType AllocType = Tracker.getAllocationType(PtrOperand);
+
+        if (CountAll)
+          Tracker.addPointeeType(PointeeType, AllocType);
+        if (CountSensitive && IsTagone)
+          Tracker.addTagonePointeeType(PointeeType, AllocType);
+      }
+    }
+    return false;
+  }
+};
+} // End anonymous namespace
+
+char RISCVTagonePointerCollection::ID = 0;
+
+INITIALIZE_PASS(RISCVTagonePointerCollection, DEBUG_TYPE,
+                RISCV_TAGONE_POINTER_COLLECTION_NAME, false, false)
+
+FunctionPass *llvm::createRISCVTagonePointerCollectionPass() {
+  return new RISCVTagonePointerCollection();
+}
+
+// FZY: Shared walk used by both the legacy FunctionPass and the new-PM pass.
+static void collectPointerTypesInFunction(Function &F, bool CountAll,
+                                          bool CountSensitive) {
+  TagonePointerTracker &Tracker = TagonePointerTracker::getInstance();
+
+  for (auto &BB : F) {
+    for (auto &I : BB) {
+      Type *PointeeType = nullptr;
+      Value *PtrOperand = nullptr;
+      bool IsTagone = false;
+
+      if (auto *LI = dyn_cast<LoadInst>(&I)) {
+        PointeeType = LI->getPointeeType();
+        PtrOperand = LI->getPointerOperand();
+        IsTagone = LI->isTagone();
+      } else if (auto *SI = dyn_cast<StoreInst>(&I)) {
+        PointeeType = SI->getPointeeType();
+        PtrOperand = SI->getPointerOperand();
+        IsTagone = SI->isTagone();
+      } else {
+        continue;
+      }
+
+      if (!PointeeType)
+        continue;
+
+      AllocationType AllocType = Tracker.getAllocationType(PtrOperand);
+
+      if (CountAll)
+        Tracker.addPointeeType(PointeeType, AllocType);
+      if (CountSensitive && IsTagone)
+        Tracker.addTagonePointeeType(PointeeType, AllocType);
+    }
+  }
+}
+
+// FZY: New-PM module pass. Registered at PipelineStartEP so it sees the
+// unoptimized IR emitted by Clang CodeGen (PointeeType / tagone bits intact),
+// before inlining/DCE can delete or hoist the loads/stores. Walks every
+// function in the module so dead/never-inlined helpers are counted too.
+PreservedAnalyses
+RISCVTagonePointerCollectionPass::run(Module &M, ModuleAnalysisManager &AM) {
+  bool CountAll = M.getModuleFlag("fcount_allptrtype") != nullptr;
+  bool CountSensitive = M.getModuleFlag("fcount_sptrtype") != nullptr;
+
+  if (!CountAll && !CountSensitive)
+    return PreservedAnalyses::all();
+
+  for (Function &F : M)
+    if (!F.isDeclaration())
+      collectPointerTypesInFunction(F, CountAll, CountSensitive);
+
+  return PreservedAnalyses::all();
+}
