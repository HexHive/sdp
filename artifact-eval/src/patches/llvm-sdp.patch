+  if (V->getType() == MemTy)
+    return V;
+  if (MemTy->isPointerTy())
+    return CGF.Builder.CreateIntToPtr(V, MemTy);
+  if (MemTy->isIntegerTy()) {
+    uint64_t SrcW = V->getType()->getIntegerBitWidth();
+    uint64_t DstW = MemTy->getIntegerBitWidth();
+    if (SrcW == DstW)
+      return CGF.Builder.CreateBitCast(V, MemTy);
+    if (SrcW < DstW)
+      return CGF.Builder.CreateZExt(V, MemTy);
+    return CGF.Builder.CreateTrunc(V, MemTy);
+  }
+  // float / vector / etc.: same-width bitcast.
+  return CGF.Builder.CreateBitCast(V, MemTy);
+}
+
+// Convert a value of LLVM `MemTy` (whatever the typed side just produced)
+// back into a same-width integer for plain storage into the opaque buffer.
+static llvm::Value *coerceMemTyToInt(CodeGenFunction &CGF, llvm::Value *V,
+                                     llvm::IntegerType *IntTy) {
+  llvm::Type *VTy = V->getType();
+  if (VTy == IntTy)
+    return V;
+  if (VTy->isPointerTy())
+    return CGF.Builder.CreatePtrToInt(V, IntTy);
+  if (VTy->isIntegerTy()) {
+    uint64_t SrcW = VTy->getIntegerBitWidth();
+    uint64_t DstW = IntTy->getIntegerBitWidth();
+    if (SrcW == DstW)
+      return CGF.Builder.CreateBitCast(V, IntTy);
+    if (SrcW < DstW)
+      return CGF.Builder.CreateZExt(V, IntTy);
+    return CGF.Builder.CreateTrunc(V, IntTy);
+  }
+  return CGF.Builder.CreateBitCast(V, IntTy);
+}
+} // end anonymous namespace
+
+// FromOpaque direction: plain load from opaque-buf[Off], typed store to DstLV.
+static void emitOpaqueLeafFromOpaque(CodeGenFunction &CGF, LValue DstLV,
+                                     Address SrcBuf, CharUnits Off,
+                                     QualType FT, bool isVolatile) {
+  llvm::IntegerType *IntTy = getPlainStorageIntTy(CGF, FT);
+  CharUnits FieldAlign = CGF.getContext().getTypeAlignInChars(FT);
+  Address SrcByte = CGF.Builder.CreateConstInBoundsByteGEP(
+      SrcBuf.withElementType(CGF.Int8Ty), Off);
+  Address SrcPlain(SrcByte.getBasePointer(), IntTy,
+                   SrcByte.getAlignment().alignmentAtOffset(CharUnits::Zero()),
+                   SrcByte.isKnownNonNull());
+  // Use the IRBuilder base so the load does NOT auto-stamp tagone.
+  llvm::Value *RawInt = CGF.Builder.CGBuilderBaseTy::CreateAlignedLoad(
+      IntTy, SrcPlain.emitRawPointer(CGF), FieldAlign.getAsAlign(), isVolatile);
+  llvm::Type *MemTy = CGF.ConvertTypeForMem(FT);
+  llvm::Value *Coerced = coerceIntToMemTy(CGF, RawInt, MemTy);
+  // Store through DstLV.getAddress() — CGBuilder::CreateStore auto-stamps
+  // tagone based on the destination pointer's element type, so sensitive
+  // fields get sd_tag1 and the rest stay plain.
+  CGF.Builder.CreateStore(Coerced, DstLV.getAddress(), isVolatile);
+}
+
+// ToOpaque direction: typed load from SrcLV (may emit ld_tag1), plain store
+// into opaque-buf[Off].
+static void emitOpaqueLeafToOpaque(CodeGenFunction &CGF, LValue SrcLV,
+                                   Address DstBuf, CharUnits Off,
+                                   QualType FT, bool isVolatile) {
+  // EmitLoadOfLValue goes through CGBuilder::CreateLoad which auto-stamps
+  // tagone from the source pointer's element type.
+  RValue V = CGF.EmitLoadOfLValue(SrcLV, SourceLocation());
+  llvm::Value *Scalar = V.getScalarVal();
+  llvm::IntegerType *IntTy = getPlainStorageIntTy(CGF, FT);
+  llvm::Value *RawInt = coerceMemTyToInt(CGF, Scalar, IntTy);
+  CharUnits FieldAlign = CGF.getContext().getTypeAlignInChars(FT);
+  Address DstByte = CGF.Builder.CreateConstInBoundsByteGEP(
+      DstBuf.withElementType(CGF.Int8Ty), Off);
+  // Use the IRBuilder base so the store does NOT auto-stamp tagone.
+  CGF.Builder.CGBuilderBaseTy::CreateAlignedStore(
+      RawInt, DstByte.emitRawPointer(CGF), FieldAlign.getAsAlign(), isVolatile);
+}
+
+static void emitTagoneAwareCopyOpaque(CodeGenFunction &CGF, LValue TypedLV,
+                                       Address Opaque, CharUnits Off,
+                                       QualType Ty, bool isVolatile,
+                                       bool FromOpaque);
+
+static void emitFieldOpaque(CodeGenFunction &CGF, LValue TypedFieldLV,
+                             Address Opaque, CharUnits Off, QualType FT,
+                             bool isVolatile, bool FromOpaque) {
+  ASTContext &Ctx = CGF.getContext();
+  if (FT->isRecordType() || Ctx.getAsConstantArrayType(FT)) {
+    emitTagoneAwareCopyOpaque(CGF, TypedFieldLV, Opaque, Off, FT, isVolatile,
+                              FromOpaque);
+    return;
+  }
+  if (FT->isArrayType()) {
+    // FAM / VLA: no constant size, nothing to copy at C-sizeof granularity.
+    // Mirrors the FAM guard in emitTagoneFieldCopyOrZero — see CLAUDE.md.
+    return;
+  }
+  if (FromOpaque)
+    emitOpaqueLeafFromOpaque(CGF, TypedFieldLV, Opaque, Off, FT, isVolatile);
+  else
+    emitOpaqueLeafToOpaque(CGF, TypedFieldLV, Opaque, Off, FT, isVolatile);
+}
+
+static void emitTagoneAwareCopyOpaque(CodeGenFunction &CGF, LValue TypedLV,
+                                       Address Opaque, CharUnits Off,
+                                       QualType Ty, bool isVolatile,
+                                       bool FromOpaque) {
+  ASTContext &Ctx = CGF.getContext();
+
+  if (const RecordType *RT = Ty->getAs<RecordType>()) {
+    const RecordDecl *RD = RT->getDecl();
+    // Unions cannot have a well-defined per-leaf walk (the variants overlap).
+    // Their `isSensitive` predicate already short-circuits to 0
+    // (RecordType::isSensitive `if (!isStructureType()) return 0;`), so a
+    // union won't ever pass the call-site gate — we fall back to memcpy here
+    // only as defense-in-depth in case a union appears nested inside a
+    // sensitive record.
+    if (RD->isUnion()) {
+      CharUnits TySize = Ctx.getTypeSizeInChars(Ty);
+      llvm::Value *SizeVal =
+          llvm::ConstantInt::get(CGF.SizeTy, TySize.getQuantity());
+      Address TypedBytes = TypedLV.getAddress().withElementType(CGF.Int8Ty);
+      Address OpaqueAt = CGF.Builder.CreateConstInBoundsByteGEP(
+          Opaque.withElementType(CGF.Int8Ty), Off);
+      if (FromOpaque)
+        CGF.Builder.CreateMemCpy(TypedBytes, OpaqueAt, SizeVal, isVolatile);
+      else
+        CGF.Builder.CreateMemCpy(OpaqueAt, TypedBytes, SizeVal, isVolatile);
+      return;
+    }
+    const ASTRecordLayout &Layout = Ctx.getASTRecordLayout(RD);
+        for (const FieldDecl *FD : RD->fields()) {
+      if (FD->isZeroLengthBitField(Ctx))
+        continue;
+      if (FD->isBitField()) {
+        // Bitfields share storage; the typed access goes through a bitfield
+        // lvalue, but the opaque side has no notion of the bit layout. Fall
+        // back to byte-level memcpy of the bitfield's storage range.
+        // (Rare for the sensitive structs we care about; the user-buffer
+        // attribute is meant for primitives whose dest has C-typed fields.)
+        // For correctness, bail out of the per-field walk for the whole
+        // record and let the caller's plain memcpy handle it — this is
+        // signaled by raising the un-handled flag through a CGM diag.
+        // For now we conservatively memcpy the whole record range.
+        CharUnits TySize = Ctx.getTypeSizeInChars(Ty);
+        llvm::Value *SizeVal =
+            llvm::ConstantInt::get(CGF.SizeTy, TySize.getQuantity());
+        Address TypedBytes =
+            TypedLV.getAddress().withElementType(CGF.Int8Ty);
+        Address OpaqueAt = CGF.Builder.CreateConstInBoundsByteGEP(
+            Opaque.withElementType(CGF.Int8Ty), Off);
+        if (FromOpaque)
+          CGF.Builder.CreateMemCpy(TypedBytes, OpaqueAt, SizeVal, isVolatile);
+        else
+          CGF.Builder.CreateMemCpy(OpaqueAt, TypedBytes, SizeVal, isVolatile);
+        return;
+      }
+      uint64_t FieldOffsetBits = Layout.getFieldOffset(FD->getFieldIndex());
+      CharUnits FieldOff = Ctx.toCharUnitsFromBits(FieldOffsetBits);
+      LValue TypedFieldLV = CGF.EmitLValueForField(TypedLV, FD);
+      emitFieldOpaque(CGF, TypedFieldLV, Opaque, Off + FieldOff,
+                       FD->getType(), isVolatile, FromOpaque);
+    }
+    return;
+  }
+
+  if (const ConstantArrayType *CAT = Ctx.getAsConstantArrayType(Ty)) {
+    QualType ElemTy = CAT->getElementType();
+    CharUnits ElemSize = Ctx.getTypeSizeInChars(ElemTy);
+    uint64_t NumElems = CAT->getZExtSize();
+    Address TypedAddr = TypedLV.getAddress();
+    for (uint64_t i = 0; i < NumElems; ++i) {
+      Address TElem = CGF.Builder.CreateConstArrayGEP(TypedAddr, i);
+      LValue TypedElemLV = CGF.MakeAddrLValue(TElem, ElemTy);
+      emitFieldOpaque(CGF, TypedElemLV, Opaque, Off + ElemSize * i, ElemTy,
+                       isVolatile, FromOpaque);
+    }
+    return;
+  }
+
+  // Scalar at top level (unusual entry — the call-site gate is meant for
+  // record / constant-array types, but handle it correctly anyway).
+  emitFieldOpaque(CGF, TypedLV, Opaque, Off, Ty, isVolatile, FromOpaque);
+}
+
+void CodeGenFunction::EmitTagoneAwareCopyFromOpaque(LValue Dest,
+                                                     Address SrcBytes,
+                                                     QualType Ty,
+                                                     bool isVolatile) {
+  emitTagoneAwareCopyOpaque(*this, Dest, SrcBytes, CharUnits::Zero(), Ty,
+                            isVolatile, /*FromOpaque=*/true);
+}
+
+void CodeGenFunction::EmitTagoneAwareCopyToOpaque(Address DstBytes,
+                                                    LValue Src,
+                                                    QualType Ty,
+                                                    bool isVolatile) {
+  emitTagoneAwareCopyOpaque(*this, Src, DstBytes, CharUnits::Zero(), Ty,
+                            isVolatile, /*FromOpaque=*/false);
+}
+
+// FZY: Without -fsdp-fp/-fsdp-fpifp the sensitivity json is unused, so records
+// with only hand-written `__tagone` fields must be named here to stay sensitive.
+bool CodeGenFunction::isSecEvalTagoneRecord(QualType Ty) {
+  if (getLangOpts().SDPFPProtect || getLangOpts().SDPFPIFPProtect) // Comment out for sdp-sdretfp
+    return false; // Comment out for sdp-sdretfp
+  const auto *RT = Ty->getAs<RecordType>();
+  if (!RT)
+    return false;
+  const RecordDecl *RD = RT->getDecl();
+  if (!RD->getIdentifier())
+    return false;
+  StringRef Name = RD->getName();
+  return Name == "task_struct" || Name == "mm_struct";
+}
