+// FZY: Header file for TagonePointerTracker to track and dump tagone pointer types
+
+#ifndef LLVM_LIB_TARGET_RISCV_RISCVTAGONEPOINTERTRACKER_H
+#define LLVM_LIB_TARGET_RISCV_RISCVTAGONEPOINTERTRACKER_H
+
+#include "llvm/IR/DebugLoc.h"
+#include "llvm/IR/Type.h"
+#include "llvm/Support/JSON.h"
+#include <mutex>
+#include <set>
+#include <string>
+
+namespace llvm {
+
+enum class AllocationType {
+  Heap,
+  Stack,
+  Global,
+  HeapSettagAlloc,
+  HeapSettagDealloc,
+  StackSettag,
+  GlobalSettag
+};
+
+struct PointeeTypeInfo {
+  std::string typeName;
+  std::set<AllocationType> locations;
+
+  PointeeTypeInfo() = default;
+  PointeeTypeInfo(const std::string &name)
+      : typeName(name) {}
+
+  bool operator<(const PointeeTypeInfo &other) const {
+    return typeName < other.typeName;
+  }
+
+  void addLocation(AllocationType loc) {
+    locations.insert(loc);
+  }
+
+  json::Object toJSON() const;
+};
+
+class TagonePointerTracker {
+public:
+  static TagonePointerTracker &getInstance();
+
+  void addPointeeType(Type *pointeeType, AllocationType location);
+  void addTagonePointeeType(Type *pointeeType, AllocationType location);
+  void loadFromJSON();
+  void saveToJSON();
+  void printFinalCounts();
+
+  size_t getPointeeTypeCount() const;
+  AllocationType getAllocationType(Value *PtrValue);
+
+private:
+  TagonePointerTracker();
+  ~TagonePointerTracker();
+
+  void safeWriteJSON(const std::string &filename,
+                     const json::Object &data);
+  std::string getTypeString(Type *Ty);
+
+  mutable std::mutex trackerMutex;
+  static std::mutex fileMutex; // For file I/O synchronization
+  std::set<PointeeTypeInfo> pointeeTypes;
+  std::set<PointeeTypeInfo> tagonePointeeTypes;
+
+  std::string jsonFilePath = "backend_pointers.json";
+  std::string tagoneJsonFilePath = "backend_tagone_pointers.json";
+};
+
+} // namespace llvm
+
+#endif // LLVM_LIB_TARGET_RISCV_RISCVTAGONEPOINTERTRACKER_H
