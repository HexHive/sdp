+#include "RISCVSubtarget.h"
+#include "llvm/CodeGen/MachineFunctionPass.h"
+#include "llvm/CodeGen/RegisterScavenging.h"
+#include "llvm/IR/Module.h"
+
+using namespace llvm;
+#define DEBUG_TYPE "riscv-sdp-settag"
+#define RISCV_SDP_SETTAG_NAME "RISC-V emit SDP set_tag1/set_tag0 instructions pass"
+
+namespace {
+
+class RISCVSDPSettag : public MachineFunctionPass {
+public:
+  static char ID;
+  RISCVSDPSettag() : MachineFunctionPass(ID) {}
+
+  bool runOnMachineFunction(MachineFunction &MF) override {
+    const TargetInstrInfo *TII = MF.getSubtarget().getInstrInfo();
+    bool Modified = false;
+
+    for (MachineBasicBlock &MBB : MF) {
+      for (auto MII = MBB.begin(); MII != MBB.end(); ++MII) {
+        MachineInstr &MI = *MII;
+
+        unsigned Opcode = MI.getOpcode();
+        if (Opcode == RISCV::SD) {
+          int SettagRet = isSettag(MI);
+          if (SettagRet == -1) {
+            continue;
+          }
+          
+          // Update opcode
+          if (SettagRet) {
+            MI.setDesc(TII->get(RISCV::SET_TAG1));
+          } else {
+            MI.setDesc(TII->get(RISCV::SET_TAG0));
+          }
+
+          // Get TypeID
+          // uint64_t TypeID = 0xBEEF0;          
+          // Register TmpReg = MF.getRegInfo().createVirtualRegister(&RISCV::GPRRegClass);
+          // BuildMI(MBB, MII, MI.getDebugLoc(), TII->get(RISCV::LUI), TmpReg)
+          //     .addImm(TypeID);
+          
+          // Update register operand for the TypeID
+          // MI.getOperand(0).setReg(TmpReg);
+          
+          Modified = true;
+        }
+      }
+    }
+    return Modified;
+  }
+
+private:
+  int isSettag(const MachineInstr &MI) {
+    if (!MI.memoperands_empty()) {
+      for (const MachineMemOperand *MMO : MI.memoperands()) {
+        if (MMO->isSettagOne()) {
+          return 1;
+        }
+        if (MMO->isSettagZero()) {
+          return 0;
+        }
+      }
+    }
+    return -1;
+  }
+};
+} // End anonymous namespace
+
+char RISCVSDPSettag::ID = 0;
+
+INITIALIZE_PASS(RISCVSDPSettag, DEBUG_TYPE,
+                RISCV_SDP_SETTAG_NAME, false, false);
+
+FunctionPass *llvm::createRISCVSDPSettagPass() {
+  return new RISCVSDPSettag();
+}
