+/*
+stack (local variables), complex types, no specifiers, load/store
+2. Pointers to complex data types
+   - Pointers to structs
+   - Pointers to unions
+   - Pointers to arrays (T(\*)[])
+     - Fixed-size arrays
+     - Variable-length arrays
+   - Function pointers
+*/
+
+#include <stdio.h>
+
+struct st_t {
+  int a;
+  int b;
+};
+
+union un_t {
+  int c;
+  float d;
+};
+
+int f(int a, int b) { return a + b; }
+
+int main() {
+
+  // Sensitive data
+  struct st_t st; // Struct
+  union un_t un;  // Union
+  int arr_fix[2]; // Fixed-size array
+
+  int arr_var_size;
+  scanf("%d", &arr_var_size);
+  int arr_var[arr_var_size]; // Variable-length array
+
+  int (*__tagone f_dptr)(
+      int, int); // Function pointer, consider it as a direct sensitive pointer
+
+  // Direct pointers to sensitive data
+  struct st_t *__tagone st_dptr = &st;  // sd_tag1(st_dptr)
+  union un_t *__tagone un_dptr = &un;   // sd_tag1(un_dptr)
+  int *__tagone arr_fix_dptr = arr_fix; // sd_tag1(arr_fix_dptr)
+  int *__tagone arr_var_dptr = arr_var; // sd_tag1(arr_var_dptr)
+  f_dptr = f;                           // sd_tag1(f_dptr)
+
+  st_dptr->a = 1;      // ld_tag1(st_dptr)
+  st_dptr->b = 2;      // ld_tag1(st_dptr)
+  un_dptr->c = 3;      // ld_tag1(un_dptr)
+  un_dptr->d = 4.4;    // ld_tag1(un_dptr)
+  arr_fix_dptr[0] = 5; // ld_tag1(arr_fix_dptr)
+  arr_fix_dptr[1] = 6; // ld_tag1(arr_fix_dptr)
+  for (int i = 0; i < arr_var_size; i++) {
+    arr_var_dptr[i] = 7 + i; // ld_tag1(arr_var_dptr)
+  }
+
+  // Indirect pointers to sensitive data
+  struct st_t *__tagone *__tagone st_iptr = &st_dptr;   // sd_tag1(st_iptr)
+  union un_t *__tagone *__tagone un_iptr = &un_dptr;    // sd_tag1(un_iptr)
+  int *__tagone *__tagone arr_fix_iptr = &arr_fix_dptr; // sd_tag1(arr_fix_iptr)
+  int *__tagone *__tagone arr_var_iptr = &arr_var_dptr; // sd_tag1(arr_var_iptr)
+  int (*__tagone * __tagone f_iptr)(int, int) = &f_dptr; // sd_tag1(f_iptr)
+
+  printf("st: %d, %d, st_dptr: %p, st_iptr: %p\n",
+         st_dptr->a, // ld_tag1(st_dptr)
+         st_dptr->b, // ld_tag1(st_dptr)
+         *st_iptr,   // ld_tag1(st_iptr), ld_tag1(*st_iptr)
+         st_iptr     // ld_tag1(st_iptr)
+  );
+  printf("un: %d, %f, un_dptr: %p, un_iptr: %p\n",
+         un_dptr->c, // ld_tag1(un_dptr)
+         un_dptr->d, // ld_tag1(un_dptr)
+         *un_iptr,   // ld_tag1(un_iptr), ld_tag1(*un_iptr)
