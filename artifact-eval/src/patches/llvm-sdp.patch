@@ -0,0 +1,101 @@
+import os
+import subprocess
+import shutil
+import sys
+
+# Directories
+C_DIR = "c/"
+LL_DIR = "ll/"
+S_DIR = "s/"
+O_DIR = "o/"
+
+# Commands
+# ../build/bin/clang --sysroot=/opt/riscv/sysroot/ --target=riscv64-unknown-linux-gnu -march=rv64gc -S -emit-llvm test.c -o test.ll
+# ../build/bin/clang --sysroot=/opt/riscv/sysroot/ --target=riscv64-unknown-linux-gnu -march=rv64gc -S test.c -o test.s
+# ../build/bin/clang --sysroot=/opt/riscv/sysroot/ --target=riscv64-unknown-linux-gnu -march=rv64gc test.c -o test
+
+CMD1 = "../build_debug/bin/clang --sysroot=/opt/riscv/sysroot/ --target=riscv64-unknown-linux-gnu -march=rv64gc -S -emit-llvm"
+CMD2 = "../build_debug/bin/clang --sysroot=/opt/riscv/sysroot/ --target=riscv64-unknown-linux-gnu -march=rv64gc -S"
+CMD3 = "../build_debug/bin/clang --sysroot=/opt/riscv/sysroot/ --target=riscv64-unknown-linux-gnu -march=rv64gc"
+
+def clean_directory(directory):
+    """
+    Removes all contents of a directory and recreates it.
+    """
+    if os.path.exists(directory):
+        shutil.rmtree(directory)
+    os.makedirs(directory, exist_ok=True)
+
+def run_command(command):
+    """
+    Runs a shell command. Prints the command only if it fails.
+    """
+    try:
+        subprocess.run(command, shell=True, check=True)
+    except subprocess.CalledProcessError as e:
+        # print(f"Command failed: {command}")
+        # print(f"Error: {e}")
+        return False
+    return True
+
+def compile_file(filename):
+    """
+    Compiles a single .c file in the C_DIR to .ll, .s, and .o files,
+    placing them in LL_DIR, S_DIR, and O_DIR respectively.
+    """
+    c_file = os.path.join(C_DIR, filename)
+    if not os.path.isfile(c_file):
+        print(f"Error: {filename} does not exist in {C_DIR}")
+        return
+    base_name = filename.split(".")[0]
+
+    # Generate .ll file
+    ll_file = os.path.join(LL_DIR, f"{base_name}.ll")
+    if os.path.exists(ll_file):
+        os.remove(ll_file)
+    cmd = f"{CMD1} {c_file} -o {ll_file}"
+    print(f"\n{cmd}")
+    run_command(cmd)
+
+    # Generate .s file
+    s_file = os.path.join(S_DIR, f"{base_name}.s")
+    if os.path.exists(s_file):
+        os.remove(s_file)
+    cmd = f"{CMD2} {c_file} -o {s_file}"
+    print(f"\n{cmd}")
+    run_command(cmd)
+
+    # Generate .o file
+    o_file = os.path.join(O_DIR, f"{base_name}")
+    if os.path.exists(o_file):
+        os.remove(o_file)
+    cmd = f"{CMD3} {c_file} -o {o_file}"
+    print(f"\n{cmd}")
+    run_command(cmd)
+
+def compile_files(filename=None):
+    """
+    Compiles all .c files in the C_DIR to .ll, .s, and .o files,
+    placing them in LL_DIR, S_DIR, and O_DIR respectively.
+    """
+
+    # Process each .c file in the C_DIR
+    for file in os.listdir(C_DIR):
+        if file.endswith(".c"):
+            compile_file(file)
+
+def main():
+    """
+    Main function to clean directories and compile .c files.
+    """
+    if len(sys.argv) > 1:
+        filename = sys.argv[1]
+        compile_file(filename)
+    else:
+        clean_directory(LL_DIR)
+        clean_directory(S_DIR)
+        clean_directory(O_DIR)
+        compile_files()
+
+if __name__ == "__main__":
+    main()
