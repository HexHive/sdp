+namespace clang {
+
+struct FieldInfo {
+  std::string fieldName;
+  std::string fieldType;
+  std::uint8_t sensitivity;
+  // FZY: Byte offset of the field within its enclosing struct, and the byte
+  // size of the field's type. Used by the backend opaque-struct heap settag
+  // path under -fsdp-fp / -fsdp-fpifp to emit per-field set_tag at the right
+  // address without seeing the struct body in the current TU.
+  std::uint64_t offset;
+  std::uint64_t size;
+
+  FieldInfo(const std::string &name, const std::string &type,
+            std::uint8_t sensitivity = 1, std::uint64_t offset = 0,
+            std::uint64_t size = 0)
+      : fieldName(name), fieldType(type), sensitivity(sensitivity),
+        offset(offset), size(size) {}
+
+  llvm::json::Object toJSON() const;
+};
+
+struct StructTypeInfo {
+  std::string structName;
+  std::uint8_t structSensitivity;
+  std::vector<FieldInfo> fields;
+  // FZY: Total byte size of the struct (sizeof). Lets the backend opaque-struct
+  // path bound its per-field walk against the alloc size.
+  std::uint64_t structSize;
+
+  StructTypeInfo() = default;
+  StructTypeInfo(const std::string &name, std::uint8_t sensitivity);
+  StructTypeInfo(const std::string &name, std::uint8_t sensitivity,
+                 const std::vector<FieldInfo> &fieldList,
+                 std::uint64_t structSize = 0);
+
+  llvm::json::Object toJSON() const;
+};
+
+class StructTypeTracker {
+public:
+  // FZY: `Mode` picks the JSON filename suffix — `_fp` for -fsdp-fp,
+  // `_fpifp` for -fsdp-fpifp, no suffix for plain -fdump-struct. Lets the
+  // three flag combinations coexist on disk without overwriting each other.
+  enum Mode { Generic, FP, FPIFP };
+
+  static StructTypeTracker &getInstance(bool dumpEnabled, Mode mode);
+
+  void addStructType(RecordDecl *RD);
+  uint8_t getStructSensitivity(RecordDecl *RD) const;
+
+  void loadFromJSON(const std::string &structsFile);
+  void saveToJSON(const std::string &structsFile);
+  void printFinalCounts();
+
+  size_t getStructCount() const;
+
+private:
+  StructTypeTracker(bool dumpEnabled, Mode mode);
+  ~StructTypeTracker();
+
+  void safeWriteJSON(const std::string &filename,
+                     const llvm::json::Object &data);
+  std::vector<FieldInfo> extractFields(RecordDecl *RD);
+
+  mutable std::mutex trackerMutex;
+  static std::mutex fileMutex; // For file I/O synchronization
+  std::unordered_map<std::string, StructTypeInfo> structTypes;
+
+  std::string structFilePath;
+  std::string resolvedStructFilePath;
+
+  bool dumpEnabled; // Whether struct dumping is enabled
+};
+
+} // namespace clang
