+  if (sys::fs::exists(jsonFilePath)) {
+    auto bufferOrErr = MemoryBuffer::getFile(jsonFilePath);
+    if (bufferOrErr) {
+      auto jsonOrErr = json::parse(bufferOrErr.get()->getBuffer());
+      if (!jsonOrErr) {
+        consumeError(jsonOrErr.takeError());
+        return;
+      }
+      const auto &jsonValue = *jsonOrErr;
+      if (auto *root = jsonValue.getAsObject()) {
+        if (auto *typesArray = root->getArray("pointee_types")) {
+          for (const auto &item : *typesArray) {
+            if (auto *obj = item.getAsObject()) {
+              auto typeNameOpt = obj->getString("type_name");
+
+              if (typeNameOpt) {
+                PointeeTypeInfo info(typeNameOpt->str());
+
+                // Load locations if present
+                if (auto *locationsArray = obj->getArray("locations")) {
+                  for (const auto &locItem : *locationsArray) {
+                    if (auto locStr = locItem.getAsString()) {
+                      if (*locStr == "heap") {
+                        info.addLocation(AllocationType::Heap);
+                      } else if (*locStr == "stack") {
+                        info.addLocation(AllocationType::Stack);
+                      } else if (*locStr == "global") {
+                        info.addLocation(AllocationType::Global);
+                      } else if (*locStr == "heap_settag_alloc") {
+                        info.addLocation(AllocationType::HeapSettagAlloc);
+                      } else if (*locStr == "heap_settag_dealloc") {
+                        info.addLocation(AllocationType::HeapSettagDealloc);
+                      } else if (*locStr == "stack_settag") {
+                        info.addLocation(AllocationType::StackSettag);
+                      } else if (*locStr == "global_settag") {
+                        info.addLocation(AllocationType::GlobalSettag);
+                      }
+                    }
+                  }
+                }
+
+                pointeeTypes.insert(info);
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+  
+  if (sys::fs::exists(tagoneJsonFilePath)) {
+    auto bufferOrErr = MemoryBuffer::getFile(tagoneJsonFilePath);
+    if (bufferOrErr) {
+      auto jsonOrErr = json::parse(bufferOrErr.get()->getBuffer());
+      if (!jsonOrErr) {
+        consumeError(jsonOrErr.takeError());
+        return;
+      }
+      const auto &jsonValue = *jsonOrErr;
+      if (auto *root = jsonValue.getAsObject()) {
+        if (auto *typesArray = root->getArray("tagone_pointee_types")) {
+          for (const auto &item : *typesArray) {
+            if (auto *obj = item.getAsObject()) {
+              auto typeNameOpt = obj->getString("type_name");
+
+              if (typeNameOpt) {
+                PointeeTypeInfo info(typeNameOpt->str());
+
+                // Load locations if present
+                if (auto *locationsArray = obj->getArray("locations")) {
+                  for (const auto &locItem : *locationsArray) {
+                    if (auto locStr = locItem.getAsString()) {
+                      if (*locStr == "heap") {
+                        info.addLocation(AllocationType::Heap);
+                      } else if (*locStr == "stack") {
+                        info.addLocation(AllocationType::Stack);
+                      } else if (*locStr == "global") {
+                        info.addLocation(AllocationType::Global);
+                      } else if (*locStr == "heap_settag_alloc") {
+                        info.addLocation(AllocationType::HeapSettagAlloc);
+                      } else if (*locStr == "heap_settag_dealloc") {
+                        info.addLocation(AllocationType::HeapSettagDealloc);
+                      } else if (*locStr == "stack_settag") {
+                        info.addLocation(AllocationType::StackSettag);
+                      } else if (*locStr == "global_settag") {
+                        info.addLocation(AllocationType::GlobalSettag);
+                      }
+                    }
+                  }
+                }
+
+                tagonePointeeTypes.insert(info);
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+  
+}
+
+std::string TagonePointerTracker::getTypeString(Type *Ty) {
+  std::string typeStr;
+  raw_string_ostream rso(typeStr);
+  Ty->print(rso);
+  return rso.str();
+}
+
+void TagonePointerTracker::addPointeeType(Type *pointeeType, AllocationType location) {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+
+  std::string typeStr = getTypeString(pointeeType);
+  
+  // Strip the type definition if it contains " = ". E.g., "%struct.cop = type { ... }" -> "%struct.cop"
+  size_t equalPos = typeStr.find(" = ");
+  if (equalPos != std::string::npos) {
+    typeStr = typeStr.substr(0, equalPos);
+  }
+
+  // Find if this type already exists
+  auto it = pointeeTypes.find(PointeeTypeInfo(typeStr));
+  if (it != pointeeTypes.end()) {
+    PointeeTypeInfo updatedInfo = *it;
+    updatedInfo.addLocation(location);
+    pointeeTypes.erase(it);
+    pointeeTypes.insert(updatedInfo);
+  } else {
+    PointeeTypeInfo info(typeStr);
+    info.addLocation(location);
+    pointeeTypes.insert(info);
+  }
+}
+
+void TagonePointerTracker::addTagonePointeeType(Type *pointeeType, AllocationType location) {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+
+  std::string typeStr = getTypeString(pointeeType);
+  
+  // Strip the type definition if it contains " = ". E.g., "%struct.cop = type { ... }" -> "%struct.cop"
+  size_t equalPos = typeStr.find(" = ");
+  if (equalPos != std::string::npos) {
+    typeStr = typeStr.substr(0, equalPos);
+  }
+
+  // Find if this type already exists
+  auto it = tagonePointeeTypes.find(PointeeTypeInfo(typeStr));
+  if (it != tagonePointeeTypes.end()) {
+    PointeeTypeInfo updatedInfo = *it;
+    updatedInfo.addLocation(location);
+    tagonePointeeTypes.erase(it);
+    tagonePointeeTypes.insert(updatedInfo);
+  } else {
+    PointeeTypeInfo info(typeStr);
+    info.addLocation(location);
+    tagonePointeeTypes.insert(info);
+  }
+}
+
+void TagonePointerTracker::safeWriteJSON(const std::string &filename, const json::Object &data) {
+  std::lock_guard<std::mutex> fileLock(fileMutex);
+
+  std::error_code EC;
+  raw_fd_ostream OS(filename, EC);
+  if (!EC) {
+    OS << json::Value(json::Object(data)) << "\n";
+    OS.close();
+    outs() << "Tagone pointer types written to: " << filename << "\n";
+  } else {
+    errs() << "Error writing tagone pointer file: " << EC.message() << "\n";
+  }
+}
+
+void TagonePointerTracker::saveToJSON() {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+
+  json::Array typesArray;
+  for (const auto &info : pointeeTypes) {
+    typesArray.push_back(info.toJSON());
+  }
+
+  json::Object root;
+  root["pointee_types"] = std::move(typesArray);
+  root["count"] = static_cast<int64_t>(pointeeTypes.size());
+
+  safeWriteJSON(jsonFilePath, root);
+  
+  
+  json::Array tagoneTypesArray;
+  for (const auto &info : tagonePointeeTypes) {
+    tagoneTypesArray.push_back(info.toJSON());
+  }
+
+  json::Object tagoneRoot;
+  tagoneRoot["tagone_pointee_types"] = std::move(tagoneTypesArray);
+  tagoneRoot["count"] = static_cast<int64_t>(tagonePointeeTypes.size());
+
+  safeWriteJSON(tagoneJsonFilePath, tagoneRoot);
+}
+
+void TagonePointerTracker::printFinalCounts() {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+
+  errs() << "\n===== TAGONE POINTER COLLECTION RESULTS =====\n";
+  errs() << "Total pointee types: " << pointeeTypes.size() << "\n";
+  errs() << "Total tagone pointee types: " << tagonePointeeTypes.size() << "\n";
+  errs() << "==============================================\n\n";
+}
+
+size_t TagonePointerTracker::getPointeeTypeCount() const {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+  return pointeeTypes.size();
+}
+
+AllocationType TagonePointerTracker::getAllocationType(Value *PtrValue) {
+  const Value *PtrObj = getUnderlyingObject(PtrValue);
+  if (isa<AllocaInst>(PtrObj)) {
+    return AllocationType::Stack;
+  }
+  if (isa<GlobalVariable>(PtrObj)) {
+    return AllocationType::Global;
+  }
+  return AllocationType::Heap;
+}
