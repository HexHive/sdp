+// FZY: Count the number of unique pointer types (code and data) and save to JSON files
+
+#include "PointerTypeTracker.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/Basic/SourceManager.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/raw_ostream.h"
+#include <fstream>
+
+using namespace clang;
+using namespace llvm;
+
+PointerTypeInfo::PointerTypeInfo(const std::string& pointeeTypeName, unsigned profileHash)
+    : pointeeTypeName(pointeeTypeName), profileHash(profileHash) {
+  // This constructor is used for loading from JSON
+}
+
+json::Object PointerTypeInfo::toJSON() const {
+  return json::Object{
+    {"name", pointeeTypeName},
+    {"hash", profileHash}
+  };
+}
+
+bool PointerTypeInfo::operator<(const PointerTypeInfo& other) const {
+  return pointeeTypeName < other.pointeeTypeName;
+  // return profileHash < other.profileHash;
+}
+
+// Static mutex for file I/O synchronization
+std::mutex PointerTypeTracker::fileMutex;
+
+PointerTypeTracker& PointerTypeTracker::getInstance() {
+  static PointerTypeTracker instance;
+  return instance;
+}
+
+PointerTypeTracker::PointerTypeTracker() 
+  : codePointerFilePath("code_pointers.json")
+  , dataPointerFilePath("data_pointers.json")
+  , sensitiveCodePointerFilePath("sensitive_code_pointers.json")
+  , sensitiveDataPointerFilePath("sensitive_data_pointers.json") {
+  // Load existing data when the tracker is first created
+  loadFromJSON();
+}
+
+PointerTypeTracker::~PointerTypeTracker() {
+  // Save results when the tracker is destroyed
+  saveToJSON();
+  printFinalCounts();
+}
+
+void PointerTypeTracker::loadFromJSON() {
+  std::lock_guard<std::mutex> fileLock(fileMutex);
+  std::lock_guard<std::mutex> lock(trackerMutex);
+  
+  // Load code pointers
+  if (llvm::sys::fs::exists(codePointerFilePath)) {
+    auto bufferOrErr = llvm::MemoryBuffer::getFile(codePointerFilePath);
+    if (bufferOrErr) {
+      auto jsonOrErr = json::parse(bufferOrErr.get()->getBuffer());
+      if (!jsonOrErr) {
+        llvm::consumeError(jsonOrErr.takeError());
+        return;
+      }
+      const auto &jsonValue = *jsonOrErr;
+      if (jsonOrErr) {
+        if (auto *root = jsonValue.getAsObject()) {
+          if (auto *codeArray = root->getArray("code_pointers")) {
+            for (const auto& item : *codeArray) {
+              if (auto *obj = item.getAsObject()) {
+                if (auto hashOpt = obj->getInteger("hash")) {
+                  unsigned profileHash = *hashOpt;
+                  
+                  if (auto nameOpt = obj->getString("name")) {
+                    std::string pointeeTypeName = nameOpt->str();
+                    PointerTypeInfo info(pointeeTypeName, profileHash);
+                                                  
+                    codePointerTypes.insert(info);
+                  }
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+
+  // Load data pointers
+  if (llvm::sys::fs::exists(dataPointerFilePath)) {
+    auto bufferOrErr = llvm::MemoryBuffer::getFile(dataPointerFilePath);
+    if (bufferOrErr) {
+      auto jsonOrErr = json::parse(bufferOrErr.get()->getBuffer());
+      if (!jsonOrErr) {
+        llvm::consumeError(jsonOrErr.takeError());
+        return;
+      }
+      const auto &jsonValue = *jsonOrErr;
+      if (jsonOrErr) {
+        if (auto *root = jsonValue.getAsObject()) {
+          if (auto *dataArray = root->getArray("data_pointers")) {
+            for (const auto& item : *dataArray) {
+              if (auto *obj = item.getAsObject()) {
+                // if (auto *typeName = obj->getString("pointee_type")) {
+                //   PointerTypeInfo info;
+                //   info.pointeeTypeName = typeName->str();
+                //   dataPointerTypes.insert(info);
+                //   seenTypes.insert(info.pointeeTypeName);
+                // }
+                if (auto hashOpt = obj->getInteger("hash")) {
+                  unsigned profileHash = *hashOpt;
+                  
+                  if (auto nameOpt = obj->getString("name")) {
+
+                    std::string pointeeTypeName = nameOpt->str();
+                    PointerTypeInfo info(pointeeTypeName, profileHash);
+                                                  
+                    dataPointerTypes.insert(info);
+                  }
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+  
+  // Load sensitive code pointers
+  if (llvm::sys::fs::exists(sensitiveCodePointerFilePath)) {
+    auto bufferOrErr = llvm::MemoryBuffer::getFile(sensitiveCodePointerFilePath);
+    if (bufferOrErr) {
+      auto jsonOrErr = json::parse(bufferOrErr.get()->getBuffer());
+      if (jsonOrErr) {
+        const auto &jsonValue = *jsonOrErr;
+        if (auto *root = jsonValue.getAsObject()) {
+          if (auto *sensArray = root->getArray("sensitive_code_pointers")) {
+            for (const auto& item : *sensArray) {
+              if (auto *obj = item.getAsObject()) {
+                if (auto hashOpt = obj->getInteger("hash")) {
+                  unsigned profileHash = *hashOpt;
+                  if (auto nameOpt = obj->getString("name")) {
+                    std::string pointeeTypeName = nameOpt->str();
+                    PointerTypeInfo info(pointeeTypeName, profileHash);
+                    sensitiveCodePointerTypes.insert(info);
+                  }
+                }
+              }
+            }
+          }
+        }
+      } else {
+        llvm::consumeError(jsonOrErr.takeError());
+      }
+    }
+  }
+  
+  // Load sensitive data pointers
+  if (llvm::sys::fs::exists(sensitiveDataPointerFilePath)) {
+    auto bufferOrErr = llvm::MemoryBuffer::getFile(sensitiveDataPointerFilePath);
+    if (bufferOrErr) {
+      auto jsonOrErr = json::parse(bufferOrErr.get()->getBuffer());
+      if (jsonOrErr) {
+        const auto &jsonValue = *jsonOrErr;
+        if (auto *root = jsonValue.getAsObject()) {
+          if (auto *sensArray = root->getArray("sensitive_data_pointers")) {
+            for (const auto& item : *sensArray) {
+              if (auto *obj = item.getAsObject()) {
+                if (auto hashOpt = obj->getInteger("hash")) {
+                  unsigned profileHash = *hashOpt;
+                  if (auto nameOpt = obj->getString("name")) {
+                    std::string pointeeTypeName = nameOpt->str();
+                    PointerTypeInfo info(pointeeTypeName, profileHash);
+                    sensitiveDataPointerTypes.insert(info);
+                  }
+                }
+              }
+            }
+          }
+        }
+      } else {
+        llvm::consumeError(jsonOrErr.takeError());
+      }
+    }
+  }
+}
+
+void PointerTypeTracker::addPointerType(const PointerType* PT, unsigned profileHash) {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+  
+  QualType pointeeType = PT->getPointeeType().getCanonicalType();
+  // pointeeType->dump();
+  
+  std::string pointeeTypeName = pointeeType.getAsString();
+  PointerTypeInfo info(pointeeTypeName, profileHash);
+  
+  // Classify and add to appropriate set
+  if (pointeeType->isFunctionType()) {
+    codePointerTypes.insert(info);
+  } else {
+    dataPointerTypes.insert(info);
+  }
+}
+
+void PointerTypeTracker::addSensitivePointerType(const PointerType* PT, unsigned profileHash) {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+  
+  QualType pointeeType = PT->getPointeeType().getCanonicalType();
+  // pointeeType->dump();
+  
+  std::string pointeeTypeName = pointeeType.getAsString();
+  PointerTypeInfo info(pointeeTypeName, profileHash);
+  
+  // Classify and add to appropriate set
+  if (pointeeType->isFunctionType()) {
+    sensitiveCodePointerTypes.insert(info);
+  } else {
+    sensitiveDataPointerTypes.insert(info);
+  }
+}
+
+void PointerTypeTracker::safeWriteJSON(const std::string& filename, const llvm::json::Object& data) {
+  std::lock_guard<std::mutex> fileLock(fileMutex);
+  
+  std::error_code EC;
+  raw_fd_ostream OS(filename, EC);
+  if (!EC) {
+    OS << json::Value(json::Object(data)) << "\n";
+    OS.close();
+    llvm::errs() << "Pointer types written to: " << filename << "\n";
+  } else {
+    llvm::errs() << "Error writing pointer type file: " << EC.message() << "\n";
+  }
+}
+
+void PointerTypeTracker::saveToJSON() {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+  
+  // Dump code pointers
+  {
+    json::Array codeArray;
+    for (const auto& info : codePointerTypes) {
+      codeArray.push_back(info.toJSON());
+    }
+    
+    json::Object root;
+    root["code_pointers"] = std::move(codeArray);
+    root["count"] = static_cast<int64_t>(codePointerTypes.size());
+    
+    // std::error_code EC;
+    // raw_fd_ostream OS(codePointerFile, EC);
+    // if (!EC) {
+    //   OS << json::Value(std::move(root)) << "\n";
+    //   OS.close();
+    //   llvm::outs() << "Code pointer types written to: " << codePointerFile << "\n";
+    // } else {
+    //   llvm::errs() << "Error writing code pointer file: " << EC.message() << "\n";
+    // }
+    safeWriteJSON(codePointerFilePath, root);
+  }
+  
+  // Dump data pointers
+  {
+    json::Array dataArray;
+    for (const auto& info : dataPointerTypes) {
+      dataArray.push_back(info.toJSON());
+    }
+    
+    json::Object root;
+    root["data_pointers"] = std::move(dataArray);
+    root["count"] = static_cast<int64_t>(dataPointerTypes.size());
+    
+    // std::error_code EC;
+    // raw_fd_ostream OS(dataPointerFile, EC);
+    // if (!EC) {
+    //   OS << json::Value(std::move(root)) << "\n";
+    //   OS.close();
+    //   llvm::outs() << "Data pointer types written to: " << dataPointerFile << "\n";
+    // } else {
+    //   llvm::errs() << "Error writing data pointer file: " << EC.message() << "\n";
+    // }
+    safeWriteJSON(dataPointerFilePath, root);
+  }
+  
+  // Dump sensitive code pointers
+  {
+    json::Array sensCodeArray;
+    for (const auto& info : sensitiveCodePointerTypes) {
+      sensCodeArray.push_back(info.toJSON());
+    }
+    
+    json::Object root;
+    root["sensitive_code_pointers"] = std::move(sensCodeArray);
+    root["count"] = static_cast<int64_t>(sensitiveCodePointerTypes.size());
+    
+    safeWriteJSON(sensitiveCodePointerFilePath, root);
+  }
+  
+  // Dump sensitive data pointers
+  {
+    json::Array sensDataArray;
+    for (const auto& info : sensitiveDataPointerTypes) {
+      sensDataArray.push_back(info.toJSON());
+    }
+    
+    json::Object root;
+    root["sensitive_data_pointers"] = std::move(sensDataArray);
+    root["count"] = static_cast<int64_t>(sensitiveDataPointerTypes.size());
+    
+    safeWriteJSON(sensitiveDataPointerFilePath, root);
+  }
+}
+
+void PointerTypeTracker::printFinalCounts() {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+  
+  llvm::errs() << "\n=== POINTER TYPE ANALYSIS RESULTS ===\n";
+  llvm::errs() << "Code pointer types: " << codePointerTypes.size() << "\n";
+  llvm::errs() << "Data pointer types: " << dataPointerTypes.size() << "\n";
+  llvm::errs() << "Total pointer types: " << (codePointerTypes.size() + dataPointerTypes.size()) << "\n";
+  llvm::errs() << "\n--- SENSITIVE POINTER TYPES ---\n";
+  llvm::errs() << "Sensitive code pointer types: " << sensitiveCodePointerTypes.size() << "\n";
+  llvm::errs() << "Sensitive data pointer types: " << sensitiveDataPointerTypes.size() << "\n";
+  llvm::errs() << "Total sensitive pointer types: " << (sensitiveCodePointerTypes.size() + sensitiveDataPointerTypes.size()) << "\n";
+  llvm::errs() << "=====================================\n\n";
+}
+
+size_t PointerTypeTracker::getCodePointerCount() const {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+  return codePointerTypes.size();
+}
+
+size_t PointerTypeTracker::getDataPointerCount() const {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+  return dataPointerTypes.size();
+}
+
+size_t PointerTypeTracker::getSensitiveCodePointerCount() const {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+  return sensitiveCodePointerTypes.size();
+}
+
+size_t PointerTypeTracker::getSensitiveDataPointerCount() const {
+  std::lock_guard<std::mutex> lock(trackerMutex);
+  return sensitiveDataPointerTypes.size();
+}
