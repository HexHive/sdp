diff --git a/static_instcount.py b/static_instcount.py
new file mode 100755
index 000000000000..1fd9dc7e42ae
--- /dev/null
+++ b/static_instcount.py
@@ -0,0 +1,276 @@
+#!/usr/bin/env python3
+# FZY: Static instruction counter for an SDP-extended RV64 kernel image.
+#
+# Mirrors the classification in contrib/plugins/sdp_counter.c so a static
+# count of the kernel binary is directly comparable to a dynamic snapshot
+# from the QEMU plugin.
+#
+# Categories (one column per):
+#   all, normal_load, normal_store,
+#   ld_scp, ld_sdp, sd_scp, sd_sdp,
+#   set_tag0, set_tag1, clear_tag
+#
+# Input: an ELF kernel image (e.g. vmlinux). By default the script runs
+# riscv64-linux-gnu-objdump -d and classifies every disassembled instruction
+# by its raw bytes. Lines rendered as `.word` / `.byte` / `.short` / etc. are
+# data (e.g. the EFI PE-COFF header in .head.text) and are skipped.
+# `.insn 4, 0xHEX` lines — used by objdump for instructions it doesn't
+# recognise, including all SDP custom encodings — are classified by their
+# bytes via the same logic the sdp_counter plugin uses, so SDP opcodes get
+# bucketed correctly without a patched binutils. With --bytes, the ELF's
+# executable PT_LOAD segments are byte-scanned directly instead.
+#
+# Usage:
+#   ./static_instcount.py vmlinux
+#   ./static_instcount.py vmlinux --bytes              # force byte scan
+#   ./static_instcount.py vmlinux --objdump=/path/to/riscv64-objdump
+
+import argparse
+import re
+import struct
+import subprocess
+import sys
+
+CAT_NAMES = [
+    "all", "normal_load", "normal_store",
+    "ld_scp", "ld_sdp", "sd_scp", "sd_sdp",
+    "set_tag0", "set_tag1", "clear_tag",
+]
+(CAT_ALL, CAT_NORMAL_LOAD, CAT_NORMAL_STORE,
+ CAT_LD_SCP, CAT_LD_SDP, CAT_SD_SCP, CAT_SD_SDP,
+ CAT_SET_TAG0, CAT_SET_TAG1, CAT_CLEAR_TAG) = range(len(CAT_NAMES))
+CAT_MAX = len(CAT_NAMES)
+
+
+def classify(bits, size):
+    """Return category index or -1. Mirrors classify() in sdp_counter.c."""
+    if size == 2:
+        c = bits & 0xFFFF
+        quadrant = c & 0x3
+        f3 = (c >> 13) & 0x7
+        if quadrant in (0, 2):
+            if f3 in (1, 2, 3):
+                return CAT_NORMAL_LOAD
+            if f3 in (5, 6, 7):
+                return CAT_NORMAL_STORE
+        return -1
+
+    if size != 4:
+        return -1
+
+    opcode = bits & 0x7F
+    f3 = (bits >> 12) & 0x7
+
+    if opcode in (0x03, 0x07):
+        return CAT_NORMAL_LOAD
+    if opcode == 0x23:
+        if f3 in (0, 1, 2, 3):
+            return CAT_NORMAL_STORE
+        if f3 == 5:
+            return CAT_SET_TAG0
+        if f3 == 6:
+            return CAT_CLEAR_TAG
+        if f3 == 7:
+            return CAT_SET_TAG1
+        return -1
+    if opcode == 0x27:
+        return CAT_NORMAL_STORE
+    if opcode == 0x2F:
+        funct5 = (bits >> 27) & 0x1F
+        if funct5 in (0x02, 0x1E):  # LR.W/D, lr_sdp.d
+            return CAT_NORMAL_LOAD
+        return CAT_NORMAL_STORE  # SC.*, sc_sdp.d, AMO*
+    if opcode == 0x0B:
+        return CAT_LD_SCP
+    if opcode == 0x2B:
+        return CAT_LD_SDP
+    if opcode == 0x5B:
+        return CAT_SD_SCP
+    if opcode == 0x7B:
+        return CAT_SD_SDP
+    return -1
+
+
+def insn_size(first_parcel):
+    """RISC-V instruction length in bytes from its first 16-bit parcel."""
+    if (first_parcel & 0x3) != 0x3:
+        return 2
+    if (first_parcel & 0x1F) != 0x1F:
+        return 4
+    if (first_parcel & 0x3F) == 0x1F:
+        return 6
+    if (first_parcel & 0x7F) == 0x3F:
+        return 8
+    return 0
+
+
+def count_buffer(buf, counts, stats):
+    off = 0
+    n = len(buf)
+    while off + 2 <= n:
+        first = struct.unpack_from("<H", buf, off)[0]
+        sz = insn_size(first)
+        if sz == 0 or off + sz > n:
+            stats["skipped_bytes"] += 2
+            off += 2
+            continue
+        if sz == 2:
+            bits = first
+        elif sz == 4:
+            bits = struct.unpack_from("<I", buf, off)[0]
+        else:
+            stats["long_insns"] += 1
+            off += sz
+            continue
+        counts[CAT_ALL] += 1
+        cat = classify(bits, sz)
+        if cat >= 0:
+            counts[cat] += 1
+        off += sz
+    if off < n:
+        stats["skipped_bytes"] += n - off
+
+
+DEFAULT_OBJDUMP = "riscv64-linux-gnu-objdump"
+
+# Mnemonics objdump uses when it considers the bytes to be data, not code.
+DATA_DIRECTIVES = frozenset({
+    ".word", ".byte", ".short", ".half", ".long", ".dword", ".quad",
+    ".string", ".asciz", ".ascii", ".zero",
+})
+
+# An objdump disassembly line: leading spaces, hex address, ':', whitespace,
+# a single run of hex (4 or 8 chars for RV64 GC), then optional mnemonic+args.
+OBJDUMP_LINE_RE = re.compile(
+    r"^\s*([0-9a-f]+):\s+([0-9a-f]+)(?:\s+(\S.*))?\s*$"
+)
+
+
+def count_via_objdump(image, objdump, counts, stats):
+    """Run objdump -d and classify each disassembled instruction by its bytes.
+    Mnemonics are only consulted to decide data-vs-code; bit-level
+    classification matches the runtime plugin exactly."""
+    cmd = [objdump, "-d", image]
+    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                          text=True, check=False)
+    if proc.returncode != 0:
+        print(f"# objdump exited with {proc.returncode}: {proc.stderr.strip()}",
+              file=sys.stderr)
+        sys.exit(proc.returncode)
+    for raw in proc.stdout.splitlines():
+        m = OBJDUMP_LINE_RE.match(raw)
+        if not m:
+            continue
+        hex_bytes = m.group(2)
+        if len(hex_bytes) not in (4, 8):
+            stats["odd_width"] += 1
+            continue
+        bits = int(hex_bytes, 16)
+        size = len(hex_bytes) // 2
+        mnemonic = (m.group(3) or "").lstrip()
+        first_tok = mnemonic.split(None, 1)[0] if mnemonic else ""
+        if first_tok in DATA_DIRECTIVES:
+            stats["data_bytes"] += size
+            continue
+        counts[CAT_ALL] += 1
+        cat = classify(bits, size)
+        if cat >= 0:
+            counts[cat] += 1
+
+
+def parse_elf_text(path):
+    """Yield (vaddr, bytes) for executable PT_LOAD segments. Returns None
+    if the file is not ELF."""
+    with open(path, "rb") as f:
+        data = f.read()
+    if data[:4] != b"\x7fELF":
+        return None
+    ei_class = data[4]
+    ei_data = data[5]
+    endian = "<" if ei_data == 1 else ">"
+    is64 = (ei_class == 2)
+
+    if is64:
+        e_phoff = struct.unpack_from(endian + "Q", data, 0x20)[0]
+        e_phentsz = struct.unpack_from(endian + "H", data, 0x36)[0]
+        e_phnum = struct.unpack_from(endian + "H", data, 0x38)[0]
+        ph_fmt = endian + "IIQQQQQQ"
+    else:
+        e_phoff = struct.unpack_from(endian + "I", data, 0x1C)[0]
+        e_phentsz = struct.unpack_from(endian + "H", data, 0x2A)[0]
+        e_phnum = struct.unpack_from(endian + "H", data, 0x2C)[0]
+        ph_fmt = endian + "IIIIIIII"
+
+    segs = []
+    for i in range(e_phnum):
+        base = e_phoff + i * e_phentsz
+        if is64:
+            p_type, p_flags, p_offset, p_vaddr, _, p_filesz, _, _ = \
+                struct.unpack_from(ph_fmt, data, base)
+        else:
+            p_type, p_offset, p_vaddr, _, p_filesz, _, p_flags, _ = \
+                struct.unpack_from(ph_fmt, data, base)
+        if p_type == 1 and (p_flags & 0x1):  # PT_LOAD with PF_X
+            segs.append((p_vaddr, data[p_offset:p_offset + p_filesz]))
+    return segs
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("image", help="ELF kernel image (e.g. vmlinux)")
+    ap.add_argument("--bytes", action="store_true",
+                    help="Force raw byte scanning of executable PT_LOAD segments (skip objdump)")
+    ap.add_argument("--objdump", default=DEFAULT_OBJDUMP,
+                    help=f"objdump binary to use (default: {DEFAULT_OBJDUMP})")
+    ap.add_argument("--csv", action="store_true",
+                    help="Emit comma-separated values on a single line (header + row)")
+    args = ap.parse_args()
+
+    counts = [0] * CAT_MAX
+    stats = {"skipped_bytes": 0, "long_insns": 0, "data_bytes": 0, "odd_width": 0}
+
+    with open(args.image, "rb") as f:
+        if f.read(4) != b"\x7fELF":
+            print(f"# {args.image}: not an ELF file", file=sys.stderr)
+            sys.exit(1)
+
+    if not args.bytes:
+        print(f"# {args.image}: ELF, disassembling with {args.objdump}")
+        count_via_objdump(args.image, args.objdump, counts, stats)
+        if stats["data_bytes"]:
+            print(f"# note: {stats['data_bytes']} byte(s) marked as data by objdump and skipped",
+                  file=sys.stderr)
+        if stats["odd_width"]:
+            print(f"# note: {stats['odd_width']} disassembly line(s) with non-2/4-byte width skipped",
+                  file=sys.stderr)
+    else:
+        segs = parse_elf_text(args.image)
+        if not segs:
+            print(f"# {args.image}: ELF with no executable PT_LOAD segments",
+                  file=sys.stderr)
+            sys.exit(1)
+        total = sum(len(b) for _, b in segs)
+        print(f"# {args.image}: ELF, {len(segs)} exec segment(s), {total} bytes (byte-scan)")
+        for vaddr, buf in segs:
+            print(f"#   vaddr=0x{vaddr:016x} size={len(buf)}")
+            count_buffer(buf, counts, stats)
+
+    if stats["long_insns"]:
+        print(f"# note: {stats['long_insns']} insn(s) longer than 4 bytes skipped",
+              file=sys.stderr)
+    if stats["skipped_bytes"]:
+        print(f"# note: {stats['skipped_bytes']} trailing/unaligned byte(s) skipped",
+              file=sys.stderr)
+
+    if args.csv:
+        print(",".join(CAT_NAMES))
+        print(",".join(str(counts[i]) for i in range(CAT_MAX)))
+    else:
+        width = max(len(n) for n in CAT_NAMES)
+        for i, name in enumerate(CAT_NAMES):
+            print(f"{name:<{width}}  {counts[i]}")
+
+
+if __name__ == "__main__":
+    main()
