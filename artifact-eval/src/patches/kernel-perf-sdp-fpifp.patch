+    result.obj0_addr     = (unsigned long)obj0;
+    result.obj1_addr     = (unsigned long)obj1;
+    result.write_read_ok = ok ? 1 : 0;
+
+    if (copy_to_user((void __user *)arg, &result, sizeof(result)))
+      return -EFAULT;
+    break;
+  }
+#endif
+
+  case ARB_GET_CURRENT_TASK: {
+    unsigned long task_addr = (unsigned long)current;
+    printk(KERN_INFO "arb_rw: current task_struct @ %px\n", current);
+    if (copy_to_user((void __user *)arg, &task_addr, sizeof(task_addr)))
+      return -EFAULT;
+    break;
+  }
+
+  case ARB_FLUSH_TLB:
+    asm volatile ("sfence.vma" ::: "memory");
+    printk(KERN_INFO "arb_rw: TLB flushed (sfence.vma)\n");
+    break;
+
+  default:
+    return -EINVAL;
+  }
+  return 0;
+}
+
+static int device_open(struct inode *inode, struct file *file) { return 0; }
+
+static int device_release(struct inode *inode, struct file *file) { return 0; }
+
+static struct file_operations fops = {
+    .open = device_open,
+    .unlocked_ioctl = device_ioctl,
+    .release = device_release,
+};
+
+static char *arb_devnode(const struct device *dev, umode_t *mode) {
+  if (mode)
+    *mode = 0666; // Make device readable/writable by all users
+  return NULL;
+}
+
+static int __init arb_init(void) {
+  printk(KERN_INFO "arb_rw: Initializing module\n");
+
+  major_number = register_chrdev(0, DEVICE_NAME, &fops);
+  if (major_number < 0) {
+    return major_number;
+  }
+
+  arb_class = class_create(CLASS_NAME);
+  if (IS_ERR(arb_class)) {
+    unregister_chrdev(major_number, DEVICE_NAME);
+    return PTR_ERR(arb_class);
+  }
+
+  // Set the devnode callback to control permissions
+  arb_class->devnode = arb_devnode;
+
+  arb_device = device_create(arb_class, NULL, MKDEV(major_number, 0), NULL, DEVICE_NAME);
+
+  if (IS_ERR(arb_device)) {
+    class_destroy(arb_class);
+    unregister_chrdev(major_number, DEVICE_NAME);
+    return PTR_ERR(arb_device);
+  }
+  
+  // Set device permissions to be accessible by all users, quivalent to chmod 666
+  arb_device->devt = MKDEV(major_number, 0);
+
+  printk(KERN_INFO "arb_rw: Module loaded, major number %d\n", major_number);
+  return 0;
+}
+
+static void __exit arb_exit(void) {
+  device_destroy(arb_class, MKDEV(major_number, 0));
+  class_destroy(arb_class);
+  unregister_chrdev(major_number, DEVICE_NAME);
+  printk(KERN_INFO "arb_rw: Module unloaded\n");
+}
