diff --git a/sifive_orilinux.config b/sifive_orilinux.config
new file mode 100644
index 000000000000..84a27e70881e
--- /dev/null
+++ b/sifive_orilinux.config
@@ -0,0 +1,164 @@
+# Core system features
+CONFIG_CGROUPS=y
+CONFIG_SECCOMP_FILTER=y
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_SMP=y
+CONFIG_SYSVIPC=y
+CONFIG_RCU_TRACE=n
+
+# Networking stack
+CONFIG_NET=y
+CONFIG_UNIX=y
+CONFIG_PACKET=y
+CONFIG_INET=y
+CONFIG_NETDEVICES=y
+# CONFIG_NF_TABLES is not set
+
+# Device and filesystem support
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_TMPFS=y
+CONFIG_EXT4_FS=y
+CONFIG_EXT4_FS_POSIX_ACL=y
+CONFIG_AUTOFS_FS=y
+CONFIG_NET_9P=y
+CONFIG_NET_9P_VIRTIO=y
+CONFIG_9P_FS=y
+
+# Serial console
+CONFIG_SERIAL_8250=y
+CONFIG_SERIAL_8250_CONSOLE=y
+CONFIG_SERIAL_OF_PLATFORM=y
+
+# SiFive Unmatched SoC
+CONFIG_SOC_SIFIVE=y
+CONFIG_SIFIVE_CCACHE=y
+CONFIG_SERIAL_SIFIVE=y
+CONFIG_SERIAL_SIFIVE_CONSOLE=y
+CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
+CONFIG_HVC_RISCV_SBI=y
+CONFIG_SPI_SIFIVE=y
+CONFIG_GPIO_SIFIVE=y
+CONFIG_PWM_SIFIVE=y
+
+# PCIe (Unmatched has PCIe slots, needed for NVMe)
+CONFIG_PCI=y
+CONFIG_PCIEPORTBUS=y
+CONFIG_PCIE_FU740=y
+
+# Storage
+CONFIG_SCSI=y
+CONFIG_BLK_DEV_SD=y
+CONFIG_BLK_DEV_NVME=y
+CONFIG_MMC=y
+CONFIG_MMC_SDHCI=y
+CONFIG_MMC_SPI=y
+CONFIG_SPI=y
+
+# DMA
+CONFIG_DMADEVICES=y
+
+# USB
+CONFIG_USB=y
+CONFIG_USB_XHCI_HCD=y
+
+# Ethernet (Cadence MACB)
+CONFIG_MACB=y
+
+# GPIO framework
+CONFIG_GPIOLIB=y
+
+# Virtio drivers
+CONFIG_VIRTIO_MMIO=y
+CONFIG_VIRTIO_CONSOLE=y
+CONFIG_VIRTIO_BLK=y
+CONFIG_VIRTIO_NET=y
+
+# Security/crypto
+CONFIG_SYSTEM_TRUSTED_KEYS=""
+
+# Debug options
+CONFIG_DEBUG_KERNEL=y
+CONFIG_DEBUG_INFO=y
+CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
+CONFIG_GDB_SCRIPTS=y
+CONFIG_DEBUG_VM=y
+
+# Testing driver with arbitrary read/write primitives
+CONFIG_ARB_RW_DEVICE=y
+
+# Sensitive Data Protection Cache
+CONFIG_SDP_CACHE=y
+
+# Allow modprobe_path exploitation
+CONFIG_MODULES=y
+CONFIG_BINFMT_MISC=y
+
+# Enable SELinux, to allow selinux_state exploitation
+CONFIG_SECURITY=y
+CONFIG_AUDIT=y
+CONFIG_AUDITSYSCALL=y
+CONFIG_SECURITY_NETWORK=y
+CONFIG_SECURITY_SELINUX=y
+CONFIG_SECURITY_SELINUX_BOOTPARAM=y
+CONFIG_SECURITYFS=y
+CONFIG_EXT4_FS_SECURITY=y
+CONFIG_DEFAULT_SECURITY_SELINUX=y
+CONFIG_LSM="selinux"
+CONFIG_SECURITY_PATH=y
+# Boot command: selinux=1
+
+# Enable Apparmor, to allow aa_g_audit exploitation
+CONFIG_SECURITY=y
+CONFIG_AUDIT=y
+CONFIG_AUDITSYSCALL=y
+CONFIG_SECURITY_APPARMOR=y
+CONFIG_SECURITY_NETWORK=y
+CONFIG_SECURITY_PATH=y
+CONFIG_DEFAULT_SECURITY_APPARMOR=y
+CONFIG_DEFAULT_SECURITY_DAC=n
+CONFIG_SECURITYFS=y
+CONFIG_EXT4_FS_SECURITY=y
+CONFIG_LSM="apparmor"
+# Boot command: lsm=apparmor
+
+# Enable eBPF
+CONFIG_BPF=y
+CONFIG_HAVE_EBPF_JIT=y
+CONFIG_BPF_SYSCALL=y
+CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
+
+# Enable panic_on_oops
+CONFIG_PANIC_ON_OOPS=y
+
+# Enable sig_enforce
+CONFIG_MODULES=y
