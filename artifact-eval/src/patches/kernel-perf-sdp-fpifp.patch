diff --git a/arch/riscv/kernel/sdp_stack.c b/arch/riscv/kernel/sdp_stack.c
new file mode 100644
index 000000000000..f03827e21eb0
--- /dev/null
+++ b/arch/riscv/kernel/sdp_stack.c
@@ -0,0 +1,23 @@
+// FZY: Clear tags on all stack memory of dead tasks
+
+#include <linux/sched.h>
+#include <linux/sched/task_stack.h>
+
+#include <asm/thread_info.h>
+
+static __always_inline void slot_clear_tag(unsigned long *addr)
+{
+	asm volatile ("clear_tag zero, 0(%0)"
+		      :
+		      : "r" (addr)
+		      : "memory");
+}
+
+void sdp_clear_task_stack_tags(struct task_struct *tsk)
+{
+	unsigned long *slot = (unsigned long *)task_stack_page(tsk);
+	unsigned long *end = slot + (THREAD_SIZE / sizeof(unsigned long));
+
+	for (; slot < end; slot++)
+		slot_clear_tag(slot);
+}
