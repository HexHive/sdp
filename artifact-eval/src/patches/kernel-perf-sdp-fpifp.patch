+//   5. Returns the virtual addresses and pass/fail status to userspace
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#define DEVICE_PATH "/dev/arb_rw"
+
+struct sdp_cache_test_result {
+    unsigned long obj0_addr;     // virtual address of first allocated object  */
+    unsigned long obj1_addr;     // virtual address of second allocated object */
+    int           write_read_ok; // 1 if write/read verification passed        */
+};
+
+#define ARB_SDP_CACHE_TEST _IOR('A', 7, struct sdp_cache_test_result)
+
+int main(void)
+{
+    int fd;
+    struct sdp_cache_test_result result;
+
+    fd = open(DEVICE_PATH, O_RDWR);
+    if (fd < 0) {
+        fprintf(stderr, "Failed to open %s: %s\n", DEVICE_PATH, strerror(errno));
+        fprintf(stderr, "Is the arb_rw driver loaded and CONFIG_SDP_CACHE=y?\n");
+        return EXIT_FAILURE;
+    }
+
+    memset(&result, 0, sizeof(result));
+
+    printf("Issuing ARB_SDP_CACHE_TEST ioctl...\n");
+
+    if (ioctl(fd, ARB_SDP_CACHE_TEST, &result) < 0) {
+        fprintf(stderr, "ioctl ARB_SDP_CACHE_TEST failed: %s\n", strerror(errno));
+        close(fd);
+        return EXIT_FAILURE;
+    }
+
+    close(fd);
+
+    printf("\n=== SDP Cache Test Results ===\n");
+    printf("  obj0 kernel virtual address : 0x%016lx\n", result.obj0_addr);
+    printf("  obj1 kernel virtual address : 0x%016lx\n", result.obj1_addr);
+    printf("  Address delta (obj1 - obj0) : %ld bytes\n",
+           (long)(result.obj1_addr - result.obj0_addr));
+    printf("  Write/read verification     : %s\n",
+           result.write_read_ok ? "PASSED" : "FAILED");
+
+    if (result.obj0_addr == 0 || result.obj1_addr == 0) {
+        fprintf(stderr, "\nERROR: kernel returned null object address(es)\n");
+        return EXIT_FAILURE;
+    }
+
+    if (!result.write_read_ok) {
+        fprintf(stderr, "\nERROR: write/read verification failed\n");
+        return EXIT_FAILURE;
+    }
+
+    printf("\nSDP cache test PASSED.\n");
+    printf("Tip: run 'dmesg | grep sdp_cache' for kernel-side details.\n");
+    return EXIT_SUCCESS;
+}
