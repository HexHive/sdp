diff --git a/include/linux/sdp-atomics.h b/include/linux/sdp-atomics.h
new file mode 100644
index 000000000000..4daf77fcee05
--- /dev/null
+++ b/include/linux/sdp-atomics.h
@@ -0,0 +1,91 @@
+// FZY: SDP tag-aware atomic primitives for sensitive pointers with lr_sdp.d/sc_sdp.d instructions.
+//
+// The standard xchg() / try_cmpxchg() macros lower to amoswap.d / lr.d+sc.d,
+// which read and write the full 64-bit memory word and therefore clobber the
+// per-line TTag that lives in bits [63:48]. Once the TTag is gone, the next
+// compiler-emitted ld_sdp / sd_sdp on the same slot tag-mismatches and returns
+// a stripped pointer.
+//
+// lr_sdp.d / sc_sdp.d.rl operate on bits [47:0] only, leaving the TTag intact.
+// The C-level helpers below are typeless (operate on unsigned long * directly)
+// and the macros wrap them with typeof() so call sites read the same as the
+// generic kernel atomic API.
+//
+// Usage:
+//   epi->next = sdp_xchg(&ep->ovflist, epi);
+//
+//   struct callback_head *head = READ_ONCE(...);
+//   if (!sdp_try_cmpxchg(&task->task_works, &head, work))
+//           ...;  // head now holds the value that was actually in memory
+//
+// Use these only on slots whose pointee struct has ss=2 in
+// struct_definitions_resolved.json (or whose field has fs=2). Slots on
+// non-sensitive types (e.g. struct list_head) are not set_tagged and the
+// generic atomics work correctly on them.
+
+#ifndef _LINUX_SDP_ATOMICS_H
+#define _LINUX_SDP_ATOMICS_H
+
+#include <linux/compiler.h>
+#include <linux/types.h>
+
+static __always_inline unsigned long
+__sdp_xchg(volatile unsigned long *ptr, unsigned long val)
+{
+	unsigned long old, sc_res;
+
+	__asm__ __volatile__ (
+		"0:	lr_sdp.d	%0, (%2)\n"
+		"	sc_sdp.d.rl	%1, %z3, (%2)\n"
+		"	bnez	%1, 0b\n"
+		"	fence	rw, rw\n"
+		: "=&r" (old), "=&r" (sc_res)
+		: "r" (ptr), "rJ" (val)
+		: "memory");
+
+	return old;
+}
+
+static __always_inline bool
+__sdp_try_cmpxchg(volatile unsigned long *ptr,
+		  unsigned long *expected,
+		  unsigned long val)
+{
+	unsigned long got, sc_res;
+	unsigned long want = *expected;
+
+	__asm__ __volatile__ (
+		"0:	lr_sdp.d	%0, (%2)\n"
+		"	bne	%0, %z3, 1f\n"
+		"	sc_sdp.d.rl	%1, %z4, (%2)\n"
+		"	bnez	%1, 0b\n"
+		"	fence	rw, rw\n"
+		"1:"
+		: "=&r" (got), "=&r" (sc_res)
+		: "r" (ptr), "rJ" (want), "rJ" (val)
+		: "memory");
+
+	if (unlikely(got != want)) {
+		*expected = got;
+		return false;
+	}
+	return true;
+}
+
+#define sdp_xchg(ptr, new)						\
+	((typeof(*(ptr)))__sdp_xchg(					\
+		(volatile unsigned long *)(ptr),			\
+		(unsigned long)(new)))
+
+#define sdp_try_cmpxchg(ptr, oldp, new) ({				\
+	unsigned long __sdp_exp = (unsigned long)*(oldp);		\
+	bool __sdp_ok = __sdp_try_cmpxchg(				\
+		(volatile unsigned long *)(ptr),			\
+		&__sdp_exp,						\
+		(unsigned long)(new));					\
+	if (!__sdp_ok)							\
+		*(oldp) = (typeof(*(oldp)))__sdp_exp;			\
