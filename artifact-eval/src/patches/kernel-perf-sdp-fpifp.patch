diff --git a/mm/sdp_cache.c b/mm/sdp_cache.c
new file mode 100644
index 000000000000..f50a16c231d0
--- /dev/null
+++ b/mm/sdp_cache.c
@@ -0,0 +1,334 @@
+// FZY: Implementation of the sdp cache, a random allocator for sensitive data in kernel. Each type of sensitive data has its own sdp_cache, which is randomly placed in the vmalloc/ioremap area backed by a gen_pool.
+
+#include <linux/bitmap.h>
+#include <linux/genalloc.h>
+#include <linux/list.h>
+#include <linux/log2.h>
+#include <linux/mm.h>
+#include <linux/random.h>
+#include <linux/sdp_cache.h>
+#include <linux/slab.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+
+struct sdp_chunk_meta {
+  unsigned long base;
+  unsigned long nr_granules;
+  unsigned long *tripwire_bits;
+  unsigned long *placement_bits;
+};
+
+struct sdp_cache {
+  struct gen_pool *pool;
+  size_t obj_size;
+  size_t pool_size;
+  int min_alloc_order;
+  const char *name;
+  struct mutex grow_lock;
+  struct list_head list;
+};
+
+static LIST_HEAD(sdp_cache_list);
+static DEFINE_SPINLOCK(sdp_cache_list_lock);
+
+#define SDP_INITIAL_OBJECTS 256
+#define SDP_GROW_RETRIES 5
+
+static void *sdp_vmalloc_random(size_t size) {
+  unsigned long range, offset, base, end;
+  void *addr;
+  int i;
+
+  range = VMALLOC_END - VMALLOC_START - size;
+
+  for (i = 0; i < SDP_GROW_RETRIES; i++) {
+    offset = ALIGN_DOWN(get_random_long() % range, PAGE_SIZE);
+    base = VMALLOC_START + offset;
+    // Last retry: widen to full vmalloc range as fallback
+    if (i == SDP_GROW_RETRIES - 1)
+      end = VMALLOC_END;
+    else
+      end = min(base + size * 4, (unsigned long)VMALLOC_END);
+
+    addr = __vmalloc_node_range(size, PAGE_SIZE, base, end,
+                                GFP_KERNEL | __GFP_ZERO, PAGE_KERNEL, 0,
+                                NUMA_NO_NODE, __builtin_return_address(1));
+    if (addr)
+      return addr;
+  }
+  // All random placements failed; fall back to plain vmalloc
+  return vzalloc(size);
+}
+
+static struct sdp_chunk_meta *sdp_chunk_meta_alloc(unsigned long base,
+                                                   size_t nr_granules) {
+  struct sdp_chunk_meta *meta;
+
+  meta = kzalloc(sizeof(*meta), GFP_KERNEL);
+  if (!meta)
+    return NULL;
+
+  meta->base = base;
+  meta->nr_granules = nr_granules;
+  meta->tripwire_bits = bitmap_zalloc(nr_granules, GFP_KERNEL);
+  meta->placement_bits = bitmap_zalloc(nr_granules, GFP_KERNEL);
+  if (!meta->tripwire_bits || !meta->placement_bits) {
+    bitmap_free(meta->tripwire_bits);
+    bitmap_free(meta->placement_bits);
+    kfree(meta);
+    return NULL;
+  }
+  return meta;
+}
+
+static void sdp_chunk_meta_free(struct sdp_chunk_meta *meta) {
+  if (!meta)
+    return;
+  bitmap_free(meta->tripwire_bits);
+  bitmap_free(meta->placement_bits);
+  kfree(meta);
+}
+
+struct sdp_cache *sdp_cache_create(const char *name, size_t size,
+                                   size_t align) {
+  struct sdp_cache *cache;
+  struct sdp_chunk_meta *meta;
+  void *base;
+  size_t pool_size;
+  int min_order;
+
+  if (align < sizeof(unsigned long))
+    align = sizeof(unsigned long);
+  size = ALIGN(size, align);
+  min_order = ilog2(align);
+
+  pool_size = max(size * SDP_INITIAL_OBJECTS, (size_t)PAGE_SIZE);
+  pool_size = PAGE_ALIGN(pool_size);
+
+  cache = kzalloc(sizeof(*cache), GFP_KERNEL);
+  if (!cache)
+    return NULL;
+
+  cache->obj_size = size;
+  cache->pool_size = pool_size;
+  cache->min_alloc_order = min_order;
+  cache->name = name;
+  mutex_init(&cache->grow_lock);
+
+  cache->pool = gen_pool_create(min_order, NUMA_NO_NODE);
+  if (!cache->pool)
+    goto err_pool;
+
+  base = sdp_vmalloc_random(pool_size);
+  if (!base)
+    goto err_vmalloc;
+
+  meta = sdp_chunk_meta_alloc((unsigned long)base, pool_size >> min_order);
+  if (!meta)
+    goto err_meta;
+
+  if (gen_pool_add_owner(cache->pool, (unsigned long)base, -1, pool_size,
+                         NUMA_NO_NODE, meta))
+    goto err_add;
+
+  spin_lock(&sdp_cache_list_lock);
+  list_add(&cache->list, &sdp_cache_list);
+  spin_unlock(&sdp_cache_list_lock);
+
+  // pr_info("sdp_cache: created '%s' obj_size=%zu pool=%zu base=%px\n", name,
+  //         size, pool_size, base);
+  return cache;
+
+err_add:
+  sdp_chunk_meta_free(meta);
+err_meta:
+  vfree(base);
+err_vmalloc:
+  gen_pool_destroy(cache->pool);
+err_pool:
+  kfree(cache);
+  return NULL;
+}
+
+static int sdp_cache_grow(struct sdp_cache *cache, size_t needed) {
+  struct sdp_chunk_meta *meta;
+  void *base;
+  int ret;
+
+  mutex_lock(&cache->grow_lock);
+  if (gen_pool_avail(cache->pool) >= needed) {
+    mutex_unlock(&cache->grow_lock);
+    return 0;
+  }
+
+  base = sdp_vmalloc_random(cache->pool_size);
+  if (!base) {
+    mutex_unlock(&cache->grow_lock);
+    return -ENOMEM;
+  }
+
+  meta = sdp_chunk_meta_alloc((unsigned long)base, cache->pool_size >> cache->min_alloc_order);
+  if (!meta) {
+    vfree(base);
+    mutex_unlock(&cache->grow_lock);
+    return -ENOMEM;
+  }
+
+  ret = gen_pool_add_owner(cache->pool, (unsigned long)base, -1,
+                           cache->pool_size, NUMA_NO_NODE, meta);
+  if (ret) {
+    sdp_chunk_meta_free(meta);
+    vfree(base);
+    mutex_unlock(&cache->grow_lock);
+    return ret;
+  }
+
+  mutex_unlock(&cache->grow_lock);
+  // pr_info("sdp_cache: grew '%s' by %zu bytes at %px\n", cache->name,
+  //         cache->pool_size, base);
+  return 0;
+}
+
+
+static unsigned long sdp_pool_alloc(struct sdp_cache *cache, size_t size,
+                                    struct sdp_chunk_meta **meta_out)
+{
+  unsigned long addr;
+
+  addr = gen_pool_alloc_owner(cache->pool, size, (void **)meta_out);
+  if (!addr) {
+    if (sdp_cache_grow(cache, size))
+      return 0;
+    addr = gen_pool_alloc_owner(cache->pool, size, (void **)meta_out);
+  }
+  return addr;
+}
+
+// FZY: Emulate performance impact of set_tag by writing a 16-bit TTag value to a single 8-byte slot using RISC-V sd
+static __always_inline void sdp_tripwire_sd(void *slot, u64 ttag)
+{
+  asm volatile("sd %0, 0(%1)" : : "r"(ttag), "r"(slot) : "memory");
+}
+
+/*
+ * Bit layout of a single prandom value (32 bits):
+ *   [0..1]   - allocate tripwire? both set → yes (~1/4 probability)
+ *   [2]      - tripwire placement (0 = before object, 1 = after)
+ *   [3..18]  - 16-bit TTag value
+ *   (other bits ignored)
+ */
+#define SDP_RND_TRIPWIRE_MASK  3U
+#define SDP_RND_PLACE_BIT      2
+#define SDP_RND_TTAG_SHIFT   3
+#define SDP_RND_TTAG_MASK    0xFFFFU
+
+void *sdp_cache_alloc(struct sdp_cache *cache) {
+  struct sdp_chunk_meta *meta;
+  u32 rnd;
+  unsigned long addr;
+  u64 ttag;
+  size_t obj_size = cache->obj_size;
+  size_t nslots, slot_idx, i;
+  void *tripwire, *obj;
+
+  rnd = get_random_u32();
+
+  if (likely((rnd & SDP_RND_TRIPWIRE_MASK) != SDP_RND_TRIPWIRE_MASK)) {
+    // No tripwire, single object allocation
+    addr = sdp_pool_alloc(cache, obj_size, NULL);
+    if (!addr)
+      return NULL;
+
+    // FZY: Emulate the performance impact of set_tag
+    memset((void *)addr, 0, obj_size);
+    return (void *)addr;
+  }
+
+  // Tripwire path: allocate two adjacent objects as one block
+  addr = sdp_pool_alloc(cache, obj_size * 2, &meta);
+  if (!addr)
+    return NULL;
+
+  if (rnd & (1U << SDP_RND_PLACE_BIT)) {
+    // tripwire after object
+    obj = (void *)addr;
+    tripwire = (void *)(addr + obj_size);
+  } else {
+    // tripwire before object
+    tripwire = (void *)addr;
+    obj = (void *)(addr + obj_size);
+  }
+
+  // FZY: Emulate the performance impact of set_tag
+  memset(obj, 0, obj_size);
+
+  // Fill all slots in the tripwire with TTag via sd instructions
+  ttag = (rnd >> SDP_RND_TTAG_SHIFT) & SDP_RND_TTAG_MASK;
+  nslots = obj_size / sizeof(u64);
+
+  ttag = ttag << 48; // Shift TTag to the upper 16 bits of the 64-bit slot value
+  for (i = 0; i < nslots; i++) {
+    sdp_tripwire_sd((char *)tripwire + i * sizeof(u64), (u64)ttag);
+  }
+
+  // Mark in per-chunk bitmap (indexed by first granule of the object)
+  slot_idx = ((unsigned long)obj - meta->base) >> cache->min_alloc_order;
+  set_bit(slot_idx, meta->tripwire_bits);
+  if (rnd & (1U << SDP_RND_PLACE_BIT))
+    set_bit(slot_idx, meta->placement_bits);
+
+  return obj;
+}
+
+void sdp_cache_free(struct sdp_cache *cache, void *ptr) {
+  struct gen_pool_chunk *chunk;
+  struct sdp_chunk_meta *meta;
+  size_t obj_size = cache->obj_size;
+  unsigned long slot_idx, base, free_size;
+
+  rcu_read_lock();
+  chunk = gen_pool_find_chunk(cache->pool, (unsigned long)ptr);
+  if (unlikely(!chunk)) {
+    rcu_read_unlock();
+    return;
+  }
+  meta = (struct sdp_chunk_meta *)chunk->owner;
+
+  slot_idx = ((unsigned long)ptr - meta->base) >> cache->min_alloc_order;
+
+  if (test_and_clear_bit(slot_idx, meta->tripwire_bits)) {
+    if (test_and_clear_bit(slot_idx, meta->placement_bits)) {
+      base = (unsigned long)ptr;
+    } else {
+      base = (unsigned long)ptr - obj_size;
+    }
+    free_size = obj_size * 2;
+  } else {
+    base = (unsigned long)ptr;
+    free_size = obj_size;
+  }
+
+  // FZY: Emulate the performance impact of clear_tag for the tripwire slot
+  // memset((void *)(base), 0, free_size);
+
+  gen_pool_free_in_chunk(cache->pool, chunk, base, free_size);
+  rcu_read_unlock();
+}
+
+static void sdp_vfree_chunk(struct gen_pool *pool, struct gen_pool_chunk *chunk,
+                            void *data) {
+  sdp_chunk_meta_free((struct sdp_chunk_meta *)chunk->owner);
+  vfree((void *)chunk->start_addr);
+}
+
+void sdp_cache_destroy(struct sdp_cache *cache) {
+  spin_lock(&sdp_cache_list_lock);
+  list_del(&cache->list);
+  spin_unlock(&sdp_cache_list_lock);
+
+  gen_pool_for_each_chunk(cache->pool, sdp_vfree_chunk, NULL);
+  gen_pool_destroy(cache->pool);
+  kfree(cache);
+}
