+ *
+ * Returns the chunk containing @addr, or NULL if not found.
+ * Caller must hold rcu_read_lock().
+ */
+struct gen_pool_chunk *gen_pool_find_chunk(struct gen_pool *pool,
+					  unsigned long addr)
+{
+	struct gen_pool_chunk *chunk;
+
+	list_for_each_entry_rcu(chunk, &pool->chunks, next_chunk) {
+		if (addr >= chunk->start_addr && addr <= chunk->end_addr)
+			return chunk;
+	}
+	return NULL;
+}
+EXPORT_SYMBOL(gen_pool_find_chunk);
+
+/**
+ * gen_pool_free_in_chunk - free memory back to pool given the chunk
+ * @pool: pool to free to
+ * @chunk: the chunk the memory belongs to (as returned by gen_pool_find_chunk)
+ * @addr: starting address of memory to free
+ * @size: size in bytes of memory to free
+ *
+ * Like gen_pool_free, but skips the chunk lookup since the caller already
+ * knows which chunk the address belongs to.
+ */
