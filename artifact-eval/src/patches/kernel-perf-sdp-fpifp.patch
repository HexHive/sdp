+  char path[64];
+  char target[128];
+  snprintf(path, sizeof(path), "/proc/self/ns/%s", which);
+  ssize_t n = readlink(path, target, sizeof(target) - 1);
+  if (n < 0) {
+    perror("readlink");
+    return 0;
+  }
+  target[n] = '\0';
+  char *lb = strchr(target, '[');
+  char *rb = strchr(target, ']');
+  if (!lb || !rb) {
+    fprintf(stderr, "Failed to parse ns link: %s\n", target);
+    return 0;
+  }
