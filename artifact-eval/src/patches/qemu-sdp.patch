+#include "sensitive_data_protection.h"
+
+#include "exec/helper-proto.h"
+#include "qemu/log.h"
+#include "exec/exec-all.h"
+#include "exec/cpu_ldst.h"
+
+// FZY: Define the memtag related variables
+const uint64_t MEMPTR_SIZE_IN_BIT = 64;
+const uint64_t MEMPTR_SIZE_IN_BYTE = MEMPTR_SIZE_IN_BIT / 8;
+const uint64_t MEMTAG_SIZE_IN_BIT = 1;
+const uint64_t MEMTAG_MASK = (1 << MEMTAG_SIZE_IN_BIT) - 1;
+const uint64_t TAGS_PER_BYTE = 8 / MEMTAG_SIZE_IN_BIT;
+const uint64_t DRAM_BASE = 0x80000000;
+
+uint64_t total_mem_size;
+uint64_t memtag_size; // In bytes
+atomic_uchar *memtag_array;
+
+const char * const riscv_regnames[] = {
+    "zero", "ra",   "sp",   "gp",   "tp",   "t0",   "t1",   "t2",
+    "s0",   "s1",   "a0",   "a1",   "a2",   "a3",   "a4",   "a5",
+    "a6",   "a7",   "s2",   "s3",   "s4",   "s5",   "s6",   "s7",
+    "s8",   "s9",   "s10",  "s11",  "t3",   "t4",   "t5",   "t6",
+};
+
+// FZY: In enforcing mode a tag mismatch traps with an STag/TTag specific
+// cause; in permissive mode the caller only logs and carries on.
+static void sdp_raise(CPURISCVState *env, uint64_t vaddr, bool is_ttag,
+                      uintptr_t ra) {
+    if (!(env->msdpc & MSDPC_ENFORCING)) {
+        return;
+    }
+    env->badaddr = vaddr;
+    riscv_raise_exception(env, is_ttag ? RISCV_EXCP_SDP_TTAG_MISMATCH : RISCV_EXCP_SDP_STAG_MISMATCH, ra);
+}
+
+// FZY: Add helper functions for sensitive data protection
+void helper_inst_log(CPURISCVState *env, uint64_t reg_1, uint64_t reg_2, uint64_t imm, uint64_t inst_flag, uint64_t pc) {
+
+    // FZY: Debug
+    // (void)env;
+    // (void)reg_1;
+    // (void)reg_2;
+    // (void)imm;
+    // (void)inst_flag;
+
+    switch(inst_flag) {
+        case 0:
+            qemu_log_mask(CPU_LOG_SDP, "ld_tag1, rd: %s, addr: %lx, subject_ttag: %04lx\n", riscv_regnames[reg_1], reg_2, imm & 0xFFFF);
+            break;
+
+            // FZY: Debug
+            // hwaddr paddr = get_paddr(env, reg_2, MMU_DATA_LOAD);
+            // qemu_log_mask(CPU_LOG_SDP, "ld_tag1, rd: %s, addr: %lx, paddr: %lx, subject_ttag: %04lx\n", riscv_regnames[reg_1], reg_2, (uint64_t)paddr, imm & 0xFFFF);
+            // break;
+
+        case 1:
+            qemu_log_mask(CPU_LOG_SDP, "sd_tag1, rs: %lx, addr: %lx, subject_ttag: %04lx, pc: %lx\n", reg_2, reg_1, imm & 0xFFFF, pc);
+            break;
+        case 2:
+            qemu_log_mask(CPU_LOG_SDP, "set_tag0, ttag: %04lx, %lx (%lx + %ld), pc: %lx\n", (reg_2 >> 16) & 0xFFFF, reg_1 + imm, reg_1, imm, pc);
+            break;
+        case 3:
+            qemu_log_mask(CPU_LOG_SDP, "set_tag1, ttag: %04lx, %lx (%lx + %ld), pc: %lx\n", (reg_2 >> 16) & 0xFFFF, reg_1 + imm, reg_1, imm, pc);
+            break;
+        case 4:
+            qemu_log_mask(CPU_LOG_SDP, "clear_tag, %lx (%lx + %ld)\n", reg_1 + imm, reg_1, imm);
+            break;
+        default:
+            qemu_log_mask(CPU_LOG_SDP, "Unknown inst_flag: %lx\n", inst_flag);
+            break;
+    }
+}
+
+// FZY: Try to read 8 bytes of guest memory at vaddr without faulting.
+// Returns true on success and stores the loaded value in *out.
+static bool guest_load_u64_nofault(CPURISCVState *env, uint64_t vaddr,
+                                   uintptr_t ra, uint64_t *out) {
+    int mmu_idx = riscv_env_mmu_index(env, false);
+    void *host;
+    int flags = probe_access_flags(env, vaddr, 8, MMU_DATA_LOAD, mmu_idx,
+                                   true, &host, ra);
+    if (flags & TLB_INVALID_MASK) {
+        return false;
+    }
+    *out = cpu_ldq_data_ra(env, vaddr, ra);
+    return true;
+}
+
+// FZY: Walk the frame-pointer chain (s0/x8)
+static void dump_guest_callstack(CPURISCVState *env, uintptr_t ra) {
+    enum { MAX_FRAMES = 32 };
+    uint64_t fp = env->gpr[8]; // s0
+    qemu_log_mask(CPU_LOG_SDP, "  #0  pc=%lx  ra=%lx  sp=%lx  fp=%lx\n",
+                  (uint64_t)env->pc, env->gpr[1], env->gpr[2], fp);
+    for (int i = 1; i < MAX_FRAMES; i++) {
+        if (fp == 0) {
+            break;
+        }
+        uint64_t saved_ra, saved_fp;
+        if (!guest_load_u64_nofault(env, fp - 8, ra, &saved_ra)) {
+            qemu_log_mask(CPU_LOG_SDP, "  #%d  <fp-8 unmapped: %lx>\n", i, fp - 8);
+            break;
+        }
+        if (!guest_load_u64_nofault(env, fp - 16, ra, &saved_fp)) {
+            qemu_log_mask(CPU_LOG_SDP, "  #%d  <fp-16 unmapped: %lx>\n", i, fp - 16);
+            break;
+        }
+        qemu_log_mask(CPU_LOG_SDP, "  #%d  ra=%lx  fp=%lx\n", i, saved_ra, saved_fp);
+        // Stack grows down; caller's fp must be higher than callee's.
+        if (saved_fp <= fp) {
+            break;
+        }
+        fp = saved_fp;
+    }
+}
+
+// // FZY: Debug: Log pc and guest call stack of lr.d when the loaded memory's memtag is 1.
+void helper_lr_d_log(CPURISCVState *env, uint64_t vaddr, uint64_t pc) {
+    uintptr_t ra = GETPC();
+    hwaddr paddr = get_paddr(env, vaddr, MMU_DATA_LOAD);
+    if (paddr >= DRAM_BASE && paddr < DRAM_BASE + total_mem_size) {
+        if (get_memtag(paddr)) {
+            qemu_log_mask(CPU_LOG_SDP, "lr.d tagged load, pc: %lx, vaddr: %lx, paddr: %lx\n",
+                          pc, vaddr, paddr);
+
+            // FZY: Debug
+            dump_guest_callstack(env, ra);
+        }
+    }
+}
+
+// FZY: Return the physical address of the given virtual address.
+// Fast path: TCG soft-TLB probe (nonfault). Slow path on a probe failure:
+// debug page-table walk, which has no side effects on A/D bits and does not
+// fail on clean (D=0) kernel PTEs. The real fault, if any, is still taken by
+// the actual qemu_ld/qemu_st that follows the helper.
+hwaddr get_paddr(CPURISCVState *env, uint64_t vaddr, MMUAccessType access_type) {
+    CPUTLBEntryFull *full;
+    void *host;
+    int mmu_idx = riscv_env_mmu_index(env, false);
+    int flags = probe_access_full(env, vaddr, 0, access_type, mmu_idx,
+                                  true, &host, &full, 0);
+    if (!(flags & (TLB_INVALID_MASK | TLB_MMIO))) {
+        return full->phys_addr | (vaddr & ~TARGET_PAGE_MASK);
+    }
+
+    // Fallback: debug walk handles the D=0 / clean-PTE case that the nonfault
+    // probe can't resolve.
+    hwaddr page = riscv_cpu_get_phys_page_debug(env_cpu(env), vaddr);
+    if (page == (hwaddr)-1) {
+        return 0;
+    }
+    return page | (vaddr & ~TARGET_PAGE_MASK);
+}
+
+// FZY: Get the memory tag of the given physical address
+bool get_memtag(hwaddr paddr) {
+    paddr -= DRAM_BASE;
+
+    uint64_t tag_num = paddr / MEMPTR_SIZE_IN_BYTE;
+
+    uint64_t tag_index = tag_num / TAGS_PER_BYTE;
+    atomic_uchar *tag_addr = memtag_array + tag_index;
+
+    uint shift = MEMTAG_SIZE_IN_BIT * (tag_num % TAGS_PER_BYTE);
+    uint8_t mask = MEMTAG_MASK << shift;
+
+    uint8_t value = *tag_addr;
+    bool tag = (value & mask) >> shift;
+
+    return tag;
+}
+
+// FZY: Set the memory tag of the given physical address
+void set_memtag(hwaddr paddr, bool tag) {
+    paddr -= DRAM_BASE;
+
+    uint64_t tag_num = paddr / MEMPTR_SIZE_IN_BYTE;
+
+    uint64_t tag_index = tag_num / TAGS_PER_BYTE;
+    atomic_uchar *tag_addr = memtag_array + tag_index;
+
+    uint shift = MEMTAG_SIZE_IN_BIT * (tag_num % TAGS_PER_BYTE);
+    uint8_t mask = MEMTAG_MASK << shift;
+
+    // Update the tag value atomically
+    uint8_t old_value, new_value;
+    do {
+        old_value = atomic_load(tag_addr);
+        new_value = (old_value & ~mask) | ((tag << shift) & mask);
+    } while (!atomic_compare_exchange_weak(tag_addr, &old_value, new_value));
+}
+
+// FZY: Helper function for tag setting
+void helper_set_tag(CPURISCVState *env, uint64_t vaddr, uint64_t memory_tag) {
+    hwaddr paddr = get_paddr(env, vaddr, MMU_DATA_STORE);
+
+    if (paddr >= DRAM_BASE && paddr < DRAM_BASE + total_mem_size) {
+        set_memtag(paddr, (memory_tag != 0));
+    } else {
+        // Translation failed (unmapped or non-RAM). Skip the memtag update;
+        // the subsequent qemu_st will raise the proper guest fault if needed.
+        qemu_log_mask(CPU_LOG_SDP, "helper_set_tag: skipped, vaddr: %lx, paddr: %lx, DRAM: [%lx,%lx)\n",
+                      vaddr, paddr, DRAM_BASE, DRAM_BASE + total_mem_size);
+    }
+}
+
+// FZY: Helper function for set_tag pre-condition checking.
+// For set_tag1, expect the current memtag to be 0.
+// For set_tag0, expect the current memtag to be 1 and the current TTag
+// (high 16 bits of the memory word) to equal subject_ttag.
+void helper_check_set_tag(CPURISCVState *env, uint64_t vaddr, uint64_t memory_tag, uint64_t subject_ttag, uint64_t pc) {
+    uintptr_t ra = GETPC();
+    if (!env->msdpc) {
+        return;
+    }
+
+    hwaddr paddr = get_paddr(env, vaddr, MMU_DATA_STORE);
+    if (paddr < DRAM_BASE || paddr >= DRAM_BASE + total_mem_size) {
+        return;
+    }
+
+    bool cur_memtag = get_memtag(paddr);
+
+    if (memory_tag != 0) {
+        if (cur_memtag != 0) {
+            qemu_log_mask(CPU_LOG_SDP, "Mismatch set_tag1 STag, pc: %lx, vaddr: %lx, paddr: %lx, cur_memtag: %u, subject_ttag: %04lx\n",
+                          pc, vaddr, (uint64_t)paddr, cur_memtag, (subject_ttag >> 16) & 0xFFFF);
+            sdp_raise(env, vaddr, false, ra);
+        }
+    } else {
+        if (cur_memtag != 1) {
+            qemu_log_mask(CPU_LOG_SDP, "Mismatch set_tag0 STag, pc: %lx, vaddr: %lx, paddr: %lx, cur_memtag: %u, subject_ttag: %04lx\n",
+                          pc, vaddr, (uint64_t)paddr, cur_memtag, (subject_ttag >> 16) & 0xFFFF);
+            sdp_raise(env, vaddr, false, ra);
+        }
+        uint64_t cur_value = cpu_ldq_data_ra(env, vaddr, ra);
+        uint64_t cur_ttag = cur_value >> 48;
+        uint64_t expected_ttag = (subject_ttag >> 16) & 0xFFFF;
+        if (cur_ttag != expected_ttag) {
+            qemu_log_mask(CPU_LOG_SDP, "Mismatch set_tag0 TTag, pc: %lx, vaddr: %lx, paddr: %lx, cur_ttag: %04lx, expected_ttag: %04lx\n",
+                          pc, vaddr, (uint64_t)paddr, cur_ttag, expected_ttag);
+            sdp_raise(env, vaddr, true, ra);
+        }
+    }
+}
+
+// FZY: Helper function for load tag checking
+void helper_check_memtag_load_tag0(CPURISCVState *env, uint64_t dst_rg, uint64_t vaddr, uint64_t pc) {
+    uintptr_t ra = GETPC();
+    // FZY: If msdpc is not set, skip the check
+    if (!env->msdpc) {
+        return;
+    }
+
+    hwaddr paddr = get_paddr(env, vaddr, MMU_DATA_LOAD);
+
+    if (paddr >= DRAM_BASE && paddr < DRAM_BASE + total_mem_size) {
+        bool mem_tag = get_memtag(paddr);
+
+        if (mem_tag != 0) {
+            qemu_log_mask(CPU_LOG_SDP, "load mismatch, pc: %lx, dst_rg: %s, vaddr: %lx, paddr: %lx, mem_tag: %u\n", pc, riscv_regnames[dst_rg], vaddr, paddr, mem_tag);
+            sdp_raise(env, vaddr, false, ra);
+
+            // FZY: Debug
+            // CPUState *cs = env_cpu(env);
+            // cs->exception_index = EXCP_DEBUG;
+            // cpu_loop_exit_restore(cs, GETPC());
+        }
+    }
+}
+
+// FZY: Helper function for ld_tag1 tag checking
+void helper_check_memtag_load_tag1(CPURISCVState *env, uint64_t dst_rg, uint64_t vaddr, uint64_t subject_ttag, uint64_t object_ttag, uint64_t pc) {
+    uintptr_t ra = GETPC();
+    // FZY: If msdpc is not set, skip the check
+    if (!env->msdpc) {
+        return;
+    }
+
+    hwaddr paddr = get_paddr(env, vaddr, MMU_DATA_LOAD);
+    if (paddr < DRAM_BASE || paddr >= DRAM_BASE + total_mem_size) {
+        // Translation failed (unmapped or non-RAM). Skip the check; the
+        // subsequent qemu_ld will raise the proper guest fault if needed.
+        qemu_log_mask(CPU_LOG_SDP, "ld_tag1 skipped, pc: %lx, vaddr: %lx, paddr: %lx\n", pc, vaddr, paddr);
+        return;
+    }
+
+    bool mem_tag = get_memtag(paddr);
+
+    // Check stag
+    if (mem_tag != 1) {
+        qemu_log_mask(CPU_LOG_SDP, "ld_tag1 STag mismatch, pc: %lx, dst_rg: %s, vaddr: %lx, paddr: %lx, mem_tag: %u\n", pc, riscv_regnames[dst_rg], vaddr, paddr, mem_tag);
+        sdp_raise(env, vaddr, false, ra);
+        
+        // FZY: Debug
+        // CPUState *cs = env_cpu(env);
+        // cs->exception_index = EXCP_DEBUG;
+        // cpu_loop_exit_restore(cs, GETPC());
+    
+        return;
+    } else {
+        // Check ttag
+        object_ttag = (object_ttag >> 48);
+        if (subject_ttag != object_ttag) {
+            qemu_log_mask(CPU_LOG_SDP, "ld_tag1 TTag mismatch, pc: %lx, dst_rg: %s, vaddr: %lx, paddr: %lx, subject_ttag: %04lx, object_ttag: %04lx\n", pc, riscv_regnames[dst_rg], vaddr, paddr, subject_ttag & 0xFFFF, object_ttag & 0xFFFF);
+            sdp_raise(env, vaddr, true, ra);
+        }
+    }
+}
+
+// FZY: Helper function for store tag checking
+void helper_check_memtag_store_tag0(CPURISCVState *env, uint64_t value, uint64_t vaddr, uint64_t pc) {
+    uintptr_t ra = GETPC();
+    // FZY: If msdpc is not set, skip the check
+    if (!env->msdpc) {
+        return;
+    }
+
+    hwaddr paddr = get_paddr(env, vaddr, MMU_DATA_STORE);
