+
+        if (mem_tag != 0) {
+            qemu_log_mask(CPU_LOG_SDP, "store mismatch, pc: %lx, value: %lx, vaddr: %lx, paddr: %lx, mem_tag: %u\n", pc, value, vaddr, paddr, mem_tag);
+            sdp_raise(env, vaddr, false, ra);
+
+            // FZY: Debug
+            // CPUState *cs = env_cpu(env);
+            // cs->exception_index = EXCP_DEBUG;
+            // cpu_loop_exit_restore(cs, GETPC());
+        }
+    }
+}
+
+// FZY: Helper function for sd_tag1 tag checking
+void helper_check_memtag_store_tag1(CPURISCVState *env, uint64_t value, uint64_t vaddr, uint64_t subject_ttag, uint64_t object_ttag, uint64_t pc) {
+    uintptr_t ra = GETPC();
+    // FZY: If msdpc is not set, skip the check
+    if (!env->msdpc) {
+        return;
+    }
+
+    hwaddr paddr = get_paddr(env, vaddr, MMU_DATA_STORE);
+    if (paddr < DRAM_BASE || paddr >= DRAM_BASE + total_mem_size) {
+        // Translation failed (unmapped or non-RAM). Skip the check; the
+        // subsequent qemu_st will raise the proper guest fault if needed.
+        qemu_log_mask(CPU_LOG_SDP, "sd_tag1 skipped, pc: %lx, vaddr: %lx, paddr: %lx\n", pc, vaddr, paddr);
+        return;
+    }
+
+    bool mem_tag = get_memtag(paddr);
+
+    // Check stag
+    if (mem_tag != 1) {
+        qemu_log_mask(CPU_LOG_SDP, "sd_tag1 STag mismatch, pc: %lx, value: %lx, vaddr: %lx, paddr: %lx, mem_tag: %u\n", pc, value, vaddr, paddr, mem_tag);
+        sdp_raise(env, vaddr, false, ra);
+
+        // FZY: Debug
+        // CPUState *cs = env_cpu(env);
+        // cs->exception_index = EXCP_DEBUG;
+        // cpu_loop_exit_restore(cs, GETPC());
+
+        return;
+    } else {
+        // Check ttag
+        object_ttag = (object_ttag >> 48);
+        if (subject_ttag != object_ttag) {
+            qemu_log_mask(CPU_LOG_SDP, "sd_tag1 TTag mismatch, pc: %lx, value: %lx, vaddr: %lx, paddr: %lx, subject_ttag: %04lx, object_ttag: %04lx\n", pc, value, vaddr, paddr, subject_ttag & 0xFFFF, object_ttag & 0xFFFF);
+            sdp_raise(env, vaddr, true, ra);
