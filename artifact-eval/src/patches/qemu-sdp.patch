diff --git a/contrib/plugins/sdp_counter.c b/contrib/plugins/sdp_counter.c
new file mode 100644
index 000000000000..6cbd37b3a94f
--- /dev/null
+++ b/contrib/plugins/sdp_counter.c
@@ -0,0 +1,275 @@
+// FZY: Per-category instruction counter for the SDP RISC-V fork.
+// Maintains counters for:
+//   all, normal_load, normal_store,
+//   ld_scp, ld_sdp, sd_scp, sd_sdp,
+//   set_tag0, set_tag1, clear_tag.
+//
+// Boundary marker: any RISC-V CSR-write instruction targeting CSR 0x188
+// (msdpc) — i.e. `csrrw`/`csrrwi`/`csrrs[i]`/`csrrc[i]` to msdpc. The plugin
+// snapshots all category counters on the marker insn and emits one line:
+//   SDP_SNAPSHOT pc=0x<pc> all=N normal_load=N ...
+// csr.c's write_msdpc handler logs the marker value+pc in parallel; correlate
+// the two streams by PC (or by their natural ordering).
+//
+// Args:
+//   out=<file>   write the snapshot stream to a file (default: stderr)
+//
+// License: GNU GPL, version 2 or later.
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdbool.h>
+#include <glib.h>
+
+#include <qemu-plugin.h>
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;
+
+enum {
+    CAT_ALL,
+    CAT_NORMAL_LOAD,
+    CAT_NORMAL_STORE,
+    CAT_LD_SCP,
+    CAT_LD_SDP,
+    CAT_SD_SCP,
+    CAT_SD_SDP,
+    CAT_SET_TAG0,
+    CAT_SET_TAG1,
+    CAT_CLEAR_TAG,
+    CAT_MAX
+};
+
+static const char *cat_names[CAT_MAX] = {
+    "all",
+    "normal_load",
+    "normal_store",
+    "ld_scp",
+    "ld_sdp",
+    "sd_scp",
+    "sd_sdp",
+    "set_tag0",
+    "set_tag1",
+    "clear_tag",
+};
+
+static struct qemu_plugin_scoreboard *boards[CAT_MAX];
+static qemu_plugin_u64 counters[CAT_MAX];
+
+typedef struct {
+    uint64_t pc;
+} MarkerSite;
+
+static GPtrArray *marker_sites;
+static GMutex marker_lock;
+
+static FILE *out_fp;
+
+static void emit_report(const char *tag, uint64_t pc)
+{
+    g_autoptr(GString) s = g_string_new(NULL);
+    g_string_printf(s, "%s pc=0x%" PRIx64, tag, pc);
+    for (int i = 0; i < CAT_MAX; i++) {
+        g_string_append_printf(s, " %s=%" PRIu64,
+                               cat_names[i],
+                               qemu_plugin_u64_sum(counters[i]));
+    }
+    g_string_append_c(s, '\n');
+    if (out_fp) {
+        fputs(s->str, out_fp);
+        fflush(out_fp);
+    }
+    qemu_plugin_outs(s->str);
+}
+
+static void on_marker_hit(unsigned int cpu_index, void *udata)
+{
+    (void)cpu_index;
+    MarkerSite *ms = (MarkerSite *)udata;
+    emit_report("SDP_SNAPSHOT", ms->pc);
+}
+
+/* msdpc CSR address (matches CSR_MSDPC in target/riscv/cpu_bits.h). */
+#define MSDPC_CSR 0x188
+
+/*
+ * Decode RISC-V insn bytes (host-endian, as copied from the TB) and return
+ * the matching category, or -1 if uncategorised. Sets *is_marker=true when
+ * the encoding is a CSR write to msdpc that will actually perform a write.
+ */
+static int classify(uint32_t bytes, size_t insn_size, bool *is_marker)
+{
+    *is_marker = false;
+
+    if (insn_size == 2) {
+        /* RV-C (RV64): 16-bit compressed loads/stores, incl. FP. */
+        uint16_t c = (uint16_t)(bytes & 0xFFFF);
+        uint16_t quadrant = c & 0x3;
+        uint16_t f3 = (c >> 13) & 0x7;
+        if (quadrant == 0 || quadrant == 2) {
+            /* loads: f3=001 (c.fld[sp]), 010 (c.lw[sp]), 011 (c.ld[sp]) */
+            if (f3 == 1 || f3 == 2 || f3 == 3) return CAT_NORMAL_LOAD;
+            /* stores: f3=101 (c.fsd[sp]), 110 (c.sw[sp]), 111 (c.sd[sp]) */
+            if (f3 == 5 || f3 == 6 || f3 == 7) return CAT_NORMAL_STORE;
+        }
+        return -1;
+    }
+
+    /* 32-bit insn */
+    uint32_t opcode = bytes & 0x7F;
+    uint32_t f3 = (bytes >> 12) & 0x7;
+
+    switch (opcode) {
+    case 0x03: /* LB/LH/LW/LD/LBU/LHU/LWU */
+    case 0x07: /* FLW/FLD/FLQ */
+        return CAT_NORMAL_LOAD;
+    case 0x23: /* SB/SH/SW/SD; also set_tag0/1, clear_tag */
+        switch (f3) {
+        case 0: case 1: case 2: case 3:
+            return CAT_NORMAL_STORE;
+        case 5: return CAT_SET_TAG0;
+        case 6: return CAT_CLEAR_TAG;
+        case 7: return CAT_SET_TAG1;
+        }
+        return -1;
+    case 0x27: /* FSW/FSD/FSQ */
+        return CAT_NORMAL_STORE;
+    case 0x2F: { /* AMO/LR/SC, plus lr_sdp.d/sc_sdp.d */
+        uint32_t funct5 = (bytes >> 27) & 0x1F;
+        switch (funct5) {
+        case 0x02: /* LR.W/D */
+        case 0x1E: /* lr_sdp.d */
+            return CAT_NORMAL_LOAD;
+        default:   /* SC.W/D, sc_sdp.d, AMO* (read-modify-write) */
+            return CAT_NORMAL_STORE;
+        }
+    }
+    case 0x0B: /* ld_scp_NNN */
+        return CAT_LD_SCP;
+    case 0x2B: /* ld_sdp_NNN */
+        return CAT_LD_SDP;
+    case 0x5B: /* sd_scp_NNN */
+        return CAT_SD_SCP;
+    case 0x7B: /* sd_sdp_NNN */
+        return CAT_SD_SDP;
+    case 0x73: { /* SYSTEM — CSR access */
+        uint32_t csr = (bytes >> 20) & 0xFFF;
+        if (csr != MSDPC_CSR) return -1;
+        uint32_t rs1_or_imm = (bytes >> 15) & 0x1F;
+        switch (f3) {
+        case 1: /* csrrw  - always writes */
+        case 5: /* csrrwi - always writes */
+            *is_marker = true;
+            break;
+        case 2: /* csrrs  - writes iff rs1 != 0 */
+        case 3: /* csrrc  - writes iff rs1 != 0 */
+        case 6: /* csrrsi - writes iff uimm5 != 0 */
+        case 7: /* csrrci - writes iff uimm5 != 0 */
+            if (rs1_or_imm != 0) *is_marker = true;
+            break;
+        }
+        return -1;
+    }
+    }
+    return -1;
+}
+
+static void vcpu_tb_trans(qemu_plugin_id_t id, struct qemu_plugin_tb *tb)
+{
+    (void)id;
+    size_t n = qemu_plugin_tb_n_insns(tb);
+    for (size_t i = 0; i < n; i++) {
+        struct qemu_plugin_insn *insn = qemu_plugin_tb_get_insn(tb, i);
+        size_t sz = qemu_plugin_insn_size(insn);
+        uint32_t bytes = 0;
+        qemu_plugin_insn_data(insn, &bytes, sizeof(bytes));
+
+        bool is_marker = false;
+        int cat = classify(bytes, sz, &is_marker);
+
+        /* Always count toward "all" — the marker itself is excluded so the
+         * snapshot reads as "instructions executed strictly before the
+         * marker", which is what you want for phase deltas. */
+        if (!is_marker) {
+            qemu_plugin_register_vcpu_insn_exec_inline_per_vcpu(
+                insn, QEMU_PLUGIN_INLINE_ADD_U64,
+                counters[CAT_ALL], 1);
+        }
+
+        if (cat >= 0) {
+            qemu_plugin_register_vcpu_insn_exec_inline_per_vcpu(
+                insn, QEMU_PLUGIN_INLINE_ADD_U64,
+                counters[cat], 1);
+        }
+
+        if (is_marker) {
+            MarkerSite *ms = g_new0(MarkerSite, 1);
+            ms->pc = qemu_plugin_insn_vaddr(insn);
+            g_mutex_lock(&marker_lock);
+            g_ptr_array_add(marker_sites, ms);
+            g_mutex_unlock(&marker_lock);
+            qemu_plugin_register_vcpu_insn_exec_cb(
+                insn, on_marker_hit, QEMU_PLUGIN_CB_NO_REGS, ms);
+        }
+    }
+}
+
+static void plugin_exit(qemu_plugin_id_t id, void *p)
+{
+    (void)id;
+    (void)p;
+    emit_report("SDP_FINAL", 0);
+    for (int i = 0; i < CAT_MAX; i++) {
+        if (boards[i]) {
+            qemu_plugin_scoreboard_free(boards[i]);
+        }
+    }
+    if (marker_sites) {
+        for (guint i = 0; i < marker_sites->len; i++) {
+            g_free(g_ptr_array_index(marker_sites, i));
+        }
+        g_ptr_array_free(marker_sites, TRUE);
+    }
+    if (out_fp && out_fp != stderr) {
+        fclose(out_fp);
+    }
+}
+
+QEMU_PLUGIN_EXPORT
+int qemu_plugin_install(qemu_plugin_id_t id, const qemu_info_t *info,
+                        int argc, char **argv)
+{
+    (void)info;
+    g_autofree char *outpath = NULL;
+    for (int i = 0; i < argc; i++) {
+        g_auto(GStrv) tokens = g_strsplit(argv[i], "=", 2);
+        if (g_strcmp0(tokens[0], "out") == 0 && tokens[1]) {
+            g_free(outpath);
+            outpath = g_strdup(tokens[1]);
+        } else {
+            fprintf(stderr, "sdp_counter: unknown arg %s\n", argv[i]);
+            return -1;
+        }
+    }
+
+    if (outpath) {
+        out_fp = fopen(outpath, "w");
+        if (!out_fp) {
+            fprintf(stderr, "sdp_counter: cannot open %s\n", outpath);
+            return -1;
+        }
+    } else {
+        out_fp = stderr;
+    }
+
+    for (int i = 0; i < CAT_MAX; i++) {
+        boards[i] = qemu_plugin_scoreboard_new(sizeof(uint64_t));
+        counters[i] = qemu_plugin_scoreboard_u64(boards[i]);
+    }
+    marker_sites = g_ptr_array_new();
+
+    qemu_plugin_register_vcpu_tb_trans_cb(id, vcpu_tb_trans);
+    qemu_plugin_register_atexit_cb(id, plugin_exit, NULL);
+    return 0;
+}
