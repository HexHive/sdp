+// FZY: Add msdpc csr read/write handlers to enable/disable sdp checks
+static RISCVException read_msdpc(CPURISCVState *env, int csrno,
+                                  target_ulong *val)
+{
+    *val = env->msdpc;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException write_msdpc(CPURISCVState *env, int csrno,
+                                   target_ulong val)
+{
+    // FZY: msdpc has two uses. (1) Original: SDP control register — bit 0
+    // enables/disables SDP checks. (2) Boundary marker for the
+    // instruction-count plugin — caller writes a marker-ID payload in the
+    // high bits. We distinguish by value: a value made only of MSDPC_MASK bits
+    // is a pure control write; anything else is a marker. The control bits
+    // still take effect in either case.
+    int64_t icnt = -1;
+#if defined(CONFIG_TCG) && !defined(CONFIG_USER_ONLY)
+    if (icount_enabled()) {
+        icnt = icount_get_raw();
+    }
+#endif
+    if (!(val & ~(target_ulong)MSDPC_MASK)) {
+        const char *state = (val & MSDPC_ENABLE) ?
+            ((val & MSDPC_ENFORCING) ? "enabled (enforcing)" :
+                                       "enabled (permissive)") : "disabled";
+        fprintf(stderr,
+                "SDP checks %s pc=0x%" PRIx64 " icount=%" PRId64 "\n",
+                state, (uint64_t)env->pc, icnt);
+        qemu_log("SDP checks %s pc=0x%" PRIx64 " icount=%" PRId64 "\n",
+                 state, (uint64_t)env->pc, icnt);
