+// FZY: Generate lr_sdp.d, SDP tag-aware variants of lr.d
+static bool gen_lr_sdp_d(DisasContext *ctx, arg_atomic *a, MemOp mop)
+{
+    TCGv src1;
+
+    decode_save_opc(ctx);
+    src1 = get_address(ctx, a->rs1, 0);
+    if (a->rl) {
+        tcg_gen_mb(TCG_MO_ALL | TCG_BAR_STRL);
+    }
+    /* Load the raw 64-bit word (TTag in top 16, data in low 48). */
+    tcg_gen_qemu_ld_tl(load_val, src1, ctx->mem_idx, mop);
+    if (a->aq || ctx->ztso) {
+        tcg_gen_mb(TCG_MO_ALL | TCG_BAR_LDAQ);
+    }
+
+    /* Put addr in load_res; raw value stays in load_val for sc_sdp_d to merge. */
+    tcg_gen_mov_tl(load_res, src1);
+
+    /* Return sign-extended low 48 bits to rd. */
+    TCGv ext = tcg_temp_new();
+    tcg_gen_shli_tl(ext, load_val, 16);
+    tcg_gen_sari_tl(ext, ext, 16);
+    gen_set_gpr(ctx, a->rd, ext);
+
+    return true;
+}
+
+// FZY: Generate sc_sdp.d, SDP tag-aware variants of sc.d
+static bool gen_sc_sdp_d(DisasContext *ctx, arg_atomic *a, MemOp mop)
+{
+    TCGv dest, src1, src2;
+    TCGLabel *l1 = gen_new_label();
+    TCGLabel *l2 = gen_new_label();
+
+    decode_save_opc(ctx);
+    src1 = get_address(ctx, a->rs1, 0);
+    tcg_gen_brcond_tl(TCG_COND_NE, load_res, src1, l1);
+
+    dest = dest_gpr(ctx, a->rd);
+    src2 = get_gpr(ctx, a->rs2, EXT_NONE);
+
+    /* new = (load_val & 0xFFFF000000000000) | (src2 & 0x0000FFFFFFFFFFFF) */
+    TCGv new_val = tcg_temp_new();
+    TCGv top = tcg_temp_new();
+    tcg_gen_andi_tl(new_val, src2, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_andi_tl(top, load_val, 0xFFFF000000000000ULL);
+    tcg_gen_or_tl(new_val, new_val, top);
+
+    /* Atomic CAS: if mem == load_val, store new_val. */
+    tcg_gen_atomic_cmpxchg_tl(dest, load_res, load_val, new_val,
+                              ctx->mem_idx, mop);
+    tcg_gen_setcond_tl(TCG_COND_NE, dest, dest, load_val);
+    gen_set_gpr(ctx, a->rd, dest);
+    tcg_gen_br(l2);
+
+    gen_set_label(l1);
+    TCGBar bar_strl = (ctx->ztso || a->rl) ? TCG_BAR_STRL : 0;
+    tcg_gen_mb(TCG_MO_ALL + a->aq * TCG_BAR_LDAQ + bar_strl);
+    gen_set_gpr(ctx, a->rd, tcg_constant_tl(1));
+
+    gen_set_label(l2);
+    tcg_gen_movi_tl(load_res, -1);
+
+    return true;
+}
