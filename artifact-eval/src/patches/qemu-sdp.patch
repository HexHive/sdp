+// FZY: Generate set_tag0 or set_tag1 instructions
+static bool gen_set_tag(DisasContext *ctx, arg_sd *a, MemOp mem_op, uint64_t mem_tag)
+{
+    TCGv reg_1 = get_gpr(ctx, a->rs1, EXT_ZERO);
+    TCGv reg_2 = get_gpr(ctx, a->rs2, EXT_ZERO);
+    uint64_t imm = a->imm;
+    TCGv set_tag_pc = tcg_temp_new();
+    gen_pc_plus_diff(set_tag_pc, ctx, 0);
+    gen_helper_inst_log(tcg_env, reg_1, reg_2, tcg_constant_i64(imm), tcg_constant_i64(2 + mem_tag), set_tag_pc);
+
+    if (ctx->cfg_ptr->ext_zama16b) {
+        ; // FZY: TODO: Not supported, raise an exception
+    }
+    decode_save_opc(ctx);
+    if (get_xl(ctx) != MXL_RV64) {
+        ; // FZY: TODO: Not supported, raise an exception
+    }
+
+    TCGv addr = get_address(ctx, a->rs1, a->imm);
+    gen_helper_check_set_tag(tcg_env, addr, tcg_constant_i64(mem_tag), reg_2, set_tag_pc);
+    gen_helper_set_tag(tcg_env, addr, tcg_constant_i64(mem_tag));
+
+    // FZY: Write ttag to the high 16 bits of the target address
+    if (ctx->ztso) {
+        tcg_gen_mb(TCG_MO_ALL | TCG_BAR_STRL);
+    }
+
+    TCGv cur_value = tcg_temp_new();
+    tcg_gen_qemu_ld_i64(cur_value, addr, ctx->mem_idx, mem_op);
+    // Clear the high 16 bits
+    tcg_gen_andi_i64(cur_value, cur_value, 0x0000FFFFFFFFFFFF);
+    // Shift the ttag to the high 16 bits (use a new temp to avoid writing to read-only x0)
+    TCGv ttag = tcg_temp_new();
+    tcg_gen_shli_tl(ttag, get_gpr(ctx, a->rs2, EXT_NONE), 32);
+    // Set the ttag to the high 16 bits
+    tcg_gen_or_tl(cur_value, cur_value, ttag);
+
+    tcg_gen_qemu_st_i64(cur_value, addr, ctx->mem_idx, mem_op);
+
+    return true;
+}
